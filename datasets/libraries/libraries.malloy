##! experimental { givens }

// US public libraries, IMLS Public Libraries Survey (US public data, public domain).
// One row per library system (administrative entity) and one per branch/outlet.
// Survey codes for "missing" (negative numbers) were converted to null when the Parquet was built.
//
// Questions this dataset answers, and where to start (the "playbook" views carry who acts and what to do):
//   How big is the e-book vendor opportunity (one row)?  econtent_prospects -> econtent_opportunity_headline
//   Which libraries should an e-book / e-audio vendor call first?  econtent_prospects -> libraries_to_pitch_digital_content
//   Which libraries have digital demand but under-spend on e-content?  econtent_prospects -> high_demand_low_spend
//   Which low-cost-per-loan libraries to check for a shared collection first?  econtent_prospects -> shared_collection_check
//   How big and how fast-growing is library e-content spending?  library_years -> econtent_market_by_year
//   Which fast-growing counties spend least on their libraries, and what would closing the gap cost?
//       county_spend_gap -> fast_growing_counties_underfunding_libraries / cost_to_reach_state_median
//   Do small or large systems give more per dollar?  library_years -> systems_by_size_value_per_dollar
//   Has library use recovered since the pandemic?  library_years -> library_use_recovery_since_2019

given:
  # label="State" control=select suggest { source=library_systems dimension=state }
  STATE :: filter<string> is f'NC'

source: branches_table is motherduck.table('libraries.library_branches')

#" FY2023 snapshot: one row per US public library system (fiscal year ending mid-2023 for most states), from the
#" IMLS Public Libraries Survey. For trends, FY2024 figures and money questions use library_years instead.
#" Dollars are US dollars as reported. population_served is the library's legal service area, not county residents.
source: library_systems is motherduck.table('libraries.library_systems') extend {
  primary_key: library_id
  dimension:
    #" Urban/suburban/town/rural, from the NCES locale code.
    setting is substr(locale_code, 1, 1) ?
      pick 'City' when '1'
      pick 'Suburb' when '2'
      pick 'Town' when '3'
      pick 'Rural' when '4'
      else 'Unknown'

  measure:
    #" Number of library systems (administrative entities), FY2023.
    systems is count()
    #" In-person library visits, FY2023.
    total_visits is visits.sum()
    #" Items borrowed (print + digital checkouts and renewals), FY2023.
    total_circulation is circulation.sum()
    #" People in the libraries' legal service areas, FY2023.
    total_population is population_served.sum()
    #" Visits per person in the area served.
    visits_per_capita is total_visits / nullif(total_population, 0)
    #" Items borrowed per person in the area served.
    circulation_per_capita is total_circulation / nullif(total_population, 0)
    #" Share of borrowing that is e-books, e-audio and other digital items.
    # percent
    digital_share is digital_circulation.sum() / nullif(total_circulation, 0)
    #" Operating spend per person served, US dollars.
    # currency
    spend_per_capita is operating_spend.sum() / nullif(total_population, 0)
    #" Operating spend per visit, US dollars.
    # currency
    cost_per_visit is operating_spend.sum() / nullif(total_visits, 0)
    #" People attending library programs (story times, classes, events), FY2023.
    total_program_attendance is program_attendance.sum()
    #" Sessions on the libraries' public computers, FY2023.
    computer_sessions_total is computer_sessions.sum()
    #" Share of library income that comes from local government (city/county), FY2023.
    # percent
    local_funding_share is local_gov_income.sum() / nullif(total_income.sum(), 0)

  #" The 15 library systems with the most in-person visits, FY2023.
  # bar_chart { x=library_name y=total_visits }
  view: busiest_systems is {
    group_by: library_name, city
    aggregate: total_visits, visits_per_capita, circulation_per_capita, spend_per_capita
    order_by: total_visits desc
    limit: 15
  }

  #" Systems serving 20,000+ people ranked by visits per person, FY2023. Small systems often out-perform big ones.
  view: most_used_per_person is {
    where: population_served >= 20000
    group_by: library_name, city
    aggregate: visits_per_capita, circulation_per_capita, spend_per_capita
    order_by: visits_per_capita desc
    limit: 15
  }

  #" Use, spend and digital share by city / suburb / town / rural setting, FY2023.
  # bar_chart { x=setting y=visits_per_capita }
  view: by_setting is {
    group_by: setting
    aggregate: systems, visits_per_capita, circulation_per_capita, spend_per_capita, digital_share
    order_by: visits_per_capita desc
  }

  #" Every state's library use and spend per person, FY2023.
  view: by_state is {
    group_by: state
    aggregate: systems, total_visits, visits_per_capita, circulation_per_capita, spend_per_capita, digital_share
    order_by: visits_per_capita desc
  }
}

#" One row per library building or bookmobile in FY2023, joined to its library system.
source: library_branches is branches_table extend {
  join_one: library_systems with library_id
  dimension:
    #" Hours open per week (yearly hours ÷ weeks open).
    weekly_hours is hours_per_year / nullif(weeks_open, 0)
    #" The library system this building belongs to.
    system_name is library_systems.library_name
    #" Central library, branch, bookmobile or books-by-mail.
    outlet_kind is outlet_type ?
      pick 'Central library' when 'CE'
      pick 'Branch' when 'BR'
      pick 'Bookmobile' when 'BS'
      pick 'Books-by-mail' when 'BM'
      else outlet_type
  measure:
    #" Number of buildings / bookmobiles.
    outlets is count()
    #" Total floor area, square feet.
    total_square_feet is square_feet.sum()
    #" Average hours open per week (yearly hours ÷ weeks open).
    avg_weekly_hours is weekly_hours.avg()

  #" Systems with the most buildings, FY2023.
  view: by_system is {
    group_by: system_name
    aggregate: outlets, total_square_feet, avg_weekly_hours
    order_by: outlets desc
    limit: 20
  }
}

// ---------------------------------------------------------------------------------------------
// Multi-year: IMLS Public Libraries Survey FY2018 – FY2024, plus US Census county population.
// Built by build_pls_years.sql. Dollars are as reported each year (not adjusted for inflation).
// Columns absent in some years are null there: physical_items and age0_5_attendance (FY2018–FY2020),
// ebooks, kids_circulation and website_visits (FY2024).
// ---------------------------------------------------------------------------------------------

// Undocumented base (so sources built on it don't inherit library_years' description; see friction log).
source: library_years_base is motherduck.table('libraries.library_systems_by_year') extend {
  primary_key: system_year_id
  dimension:
    #" Size band by population served that year. Cut points from the FY2024 distribution of 9,209 systems:
    #" 500k+ is the top ~1% (99 systems, a third of everyone served), 100k–500k the next ~5%, 25k–100k up to
    #" the 75th percentile (23.6k), 5k–25k around the median (7.5k), under 5k the smallest ~40%.
    #" Band 6 holds entries that are not comparable: systems the survey says do not meet the public-library
    #" definition, plus five that serve 100k+ on paper but report under 0.05 visits per person in FY2024 because
    #" they are a statewide special service (Maryland Library for the Blind, 6.2M "served") or coordinating bodies
    #" whose member libraries report their own visits (Cheaha, Horseshoe Bend, Arrowhead, Ilumina).
    #" Leave band 6 out of comparisons. Exact values: '1 Very large (500k+)', '2 Large (100k–500k)', '3 Medium (25k–100k)',
    #" '4 Small (5k–25k)', '5 Very small (under 5k)', '6 Not comparable', and 'Unknown' (no population reported; a
    #" handful of rows, leave out).
    size_band is
      pick '6 Not comparable' when meets_public_library_definition = 'N'
        or library_id = 'MD9005' or library_id = 'AL0010' or library_id = 'AL0048'
        or library_id = 'MN0001' or library_id = 'TX0752'
      pick '1 Very large (500k+)' when population_served >= 500000
      pick '2 Large (100k–500k)' when population_served >= 100000
      pick '3 Medium (25k–100k)' when population_served >= 25000
      pick '4 Small (5k–25k)' when population_served >= 5000
      pick '5 Very small (under 5k)' when population_served > 0
      else 'Unknown'
    #" Urban/suburban/town/rural, from the NCES locale code.
    setting is substr(locale_code, 1, 1) ?
      pick 'City' when '1'
      pick 'Suburb' when '2'
      pick 'Town' when '3'
      pick 'Rural' when '4'
      else 'Unknown'
    #" Central library + branches + bookmobiles.
    buildings is coalesce(central_libraries, 0) + coalesce(branches, 0) + coalesce(bookmobiles, 0)

  measure:
    #" Number of library system-years (one per system per fiscal year; filter to one year to count systems).
    systems is count()
    #" In-person library visits.
    total_visits is visits.sum()
    #" People in the libraries' legal service areas.
    total_population is population_served.sum()
    // Every per-person measure divides by the population of the systems that REPORTED that figure, so a
    // system with a missing value doesn't drag the rate down (FY2024: 2,791 systems left total circulation blank).
    #" Visits per person in the area served (systems that reported visits).
    visits_per_capita is total_visits / nullif(population_served.sum() { where: visits is not null }, 0)
    #" Items borrowed per person in the area served (systems that reported total circulation). FY2024 is not
    #" comparable with earlier years (digital questions changed); compare years on physical_per_capita.
    circulation_per_capita is circulation.sum() / nullif(population_served.sum() { where: circulation is not null }, 0)
    #" Systems with no total borrowing figure (circulation blank): 72-74 entries a year in FY2022-FY2023 and 2,791 in
    #" FY2024 (6-7 and 2,663 among comparable systems), so the FY2024 borrowing total undercounts.
    systems_not_reporting_borrowing is count() { where: circulation is null }
    #" Physical items borrowed per person served (systems that reported physical circulation). Nearly complete in
    #" every year, so it is the series to compare FY2024 with earlier years, on comparable systems (size_band !=
    #" '6 Not comparable'): flat at about 4.27 in FY2023 and FY2024.
    physical_per_capita is physical_circulation.sum() / nullif(population_served.sum() { where: physical_circulation is not null }, 0)
    #" Digital items borrowed per person served (systems that reported digital circulation). FY2024 is not comparable
    #" with earlier years: the survey split digital circulation into e-book / e-serial / e-audio / e-video questions
    #" that year, and 2,781 systems left it blank (every system in IA, MA, OR, FL and PR).
    digital_per_capita is digital_circulation.sum() / nullif(population_served.sum() { where: digital_circulation is not null }, 0)
    #" Operating spend per person served, US dollars as reported that year.
    # currency
    spend_per_capita is operating_spend.sum() / nullif(population_served.sum() { where: operating_spend is not null }, 0)
    #" Share of borrowing that is e-books, e-audio and other digital items (systems that reported both). FY2024 is not
    #" comparable with earlier years: the survey changed its digital questions that year.
    # percent
    digital_share is digital_circulation.sum() { where: circulation is not null } / nullif(circulation.sum() { where: digital_circulation is not null }, 0)
    #" Visits in FY2019, the last full year before the pandemic (see the Durham caveat on the source).
    visits_fy2019 is total_visits { where: fiscal_year = 2019 }
    #" Visits in FY2024, the latest year.
    visits_fy2024 is total_visits { where: fiscal_year = 2024 }
    #" Visits per person served, FY2019.
    visits_per_capita_fy2019 is visits_per_capita { where: fiscal_year = 2019 }
    #" Visits per person served, FY2024.
    visits_per_capita_fy2024 is visits_per_capita { where: fiscal_year = 2024 }
    #" Change in visits, FY2024 against FY2019 (the last year before the pandemic).
    # percent
    visits_change_vs_fy2019 is visits_fy2024 / nullif(visits_fy2019, 0) - 1
    #" Operating spend per visit, US dollars as reported that year (systems reporting both).
    # currency
    cost_per_visit is operating_spend.sum() { where: visits is not null } / nullif(visits.sum() { where: operating_spend is not null }, 0)
    #" Operating spend per item borrowed, US dollars as reported that year (systems reporting both).
    # currency
    cost_per_checkout is operating_spend.sum() { where: circulation > 0 } / nullif(circulation.sum() { where: operating_spend is not null }, 0)
    #" Visits for every $1,000 of operating spend (systems reporting both): a value-for-money measure.
    visits_per_1k_dollars is visits.sum() { where: operating_spend > 0 } * 1000 / nullif(operating_spend.sum() { where: visits is not null }, 0)
    #" Paid staff (full-time equivalent) per 10,000 people served.
    staff_per_10k is staff_fte.sum() * 10000 / nullif(population_served.sum() { where: staff_fte is not null }, 0)
    #" Average hours open per week per building (yearly public service hours ÷ buildings incl. bookmobiles ÷ 52).
    weekly_hours_per_building is hours_open.sum() / nullif(buildings.sum() { where: hours_open is not null }, 0) / 52
    #" Yearly public service hours per 1,000 people served.
    hours_per_1k_people is hours_open.sum() * 1000 / nullif(population_served.sum() { where: hours_open is not null }, 0)
    #" Collection (materials) budget, US dollars as reported: print + e-content + other materials.
    # currency
    collection_budget is collection_spend.sum()
    #" E-content spend: e-books, e-audio, e-video, databases and e-serials, US dollars as reported. This is the
    #" market e-content vendors (OverDrive, hoopla, Boundless and others) sell into. A library whose e-books are
    #" bought by a state or consortium shows little or none here. The US market size is this measure on
    #" library_years for one fiscal year (every system that reported): $724M in FY2024, $419M in FY2018
    #" (view econtent_market_by_year).
    # currency
    econtent_budget is econtent_spend.sum()
    #" Print materials spend, US dollars as reported.
    # currency
    print_budget is print_spend.sum()
    #" Share of the collection budget spent on e-content (systems that reported both).
    # percent
    econtent_share_of_collection is econtent_spend.sum() / nullif(collection_spend.sum() { where: econtent_spend is not null }, 0)
    #" E-content dollars per digital checkout (systems with both > 0). An upper bound on what a digital loan costs,
    #" because e-content spend also buys databases and e-serials that are not checked out.
    # currency
    econtent_spend_per_digital_checkout is econtent_spend.sum() { where: digital_circulation > 0 } / nullif(digital_circulation.sum() { where: econtent_spend > 0 }, 0)

}

#" One row per US public library system per fiscal year, FY2018 – FY2024 (IMLS Public Libraries Survey; fiscal
#" year = the year it ends, mostly June). Use this source for trends, FY2024 figures and money questions.
#" Money columns (US dollars as reported, not inflation-adjusted): operating_spend (total operating budget),
#" collection_spend (materials budget = print_spend + econtent_spend + other materials), econtent_spend (e-books,
#" e-audio, e-video, databases, e-serials), print_spend. Use columns: visits, circulation (all borrowing),
#" digital_circulation, physical_circulation. population_served is the legal service area.
#(agent) FY2024 borrowing: 2,791 systems left total borrowing blank (2,781 digital; incl. Chicago, Miami-Dade, Broward
#(agent) and every system in IA, MA, OR, FL, PR) but nearly all reported physical, and the digital questions changed.
#(agent) Compare FY2024 borrowing with earlier years on physical_per_capita, comparable systems only
#(agent) (did_borrowing_fall_in_fy2024).
#(agent) Durham County Library (NC) visits swing between years (746k FY2018, 1.33M FY2019, 907k FY2020 despite
#(agent) closures from March 2020, 500k FY2024); which year is off is not known, so its change is between -33% (vs
#(agent) FY2018) and -62% (vs FY2019).
#(agent) Leave size band '6 Not comparable' out of comparisons (see size_band).
source: library_years is library_years_base extend {
  // Views live here, not on library_years_base, so sources built on the base (econtent_*) don't inherit them.
  #" National trend, one row per fiscal year: use, spend and digital share.
  # line_chart { x=fiscal_year y=visits_per_capita }
  view: visits_by_year is {
    group_by: fiscal_year
    aggregate: visits_per_capita, circulation_per_capita, physical_per_capita, spend_per_capita, digital_share, total_visits, systems
    order_by: fiscal_year
  }

  #" PLAYBOOK. Has library use recovered since the pandemic? One row per fiscal year FY2018 – FY2024: visits,
  #" visits per person, borrowing per person and the digital share. Answer: visits are still about 30% below FY2019
  #" and digital borrowing grew every year to FY2023. FY2024 borrowing: read physical_per_capita (total and digital
  #" are blank for many systems and the digital questions changed). Who acts: library directors and boards planning
  #" hours and branches.
  # line_chart { x=fiscal_year y=visits_per_capita }
  view: library_use_recovery_since_2019 is {
    where: size_band != '6 Not comparable'
    group_by: fiscal_year
    aggregate:
      total_visits
      visits_per_capita
      circulation_per_capita
      physical_per_capita
      digital_share
      # percent
      visits_vs_fy2019 is total_visits / nullif(all(visits_fy2019), 0) - 1
    order_by: fiscal_year
  }

  #" DID LIBRARY BORROWING FALL IN FY2024? Not as the total says. One row per fiscal year FY2022 - FY2024, comparable
  #" systems only. The FY2024 borrowing total falls about 13%, only because 2,663 of these systems left the total
  #" blank that year (nearly all reported physical). Physical borrowing per person is flat (about 4.27 both years).
  #" Among systems that reported a total it rose (5.91 to 6.31; 5.93 to 6.32 on systems that reported both years),
  #" all of it digital, and the digital questions changed in FY2024, so that rise may partly be a change in what is
  #" counted. Systems that stopped reporting a total were not unusual: about 5.8 items per person in FY2023 against
  #" 5.93. Who acts: anyone quoting a national borrowing trend.
  view: did_borrowing_fall_in_fy2024 is {
    where: fiscal_year >= 2022 and size_band != '6 Not comparable'
    group_by: fiscal_year
    aggregate:
      systems
      systems_not_reporting_borrowing
      physical_per_capita
      circulation_per_capita
      digital_per_capita
    order_by: fiscal_year
  }

  #" PLAYBOOK. How big and how fast-growing is the library e-content market? One row per fiscal year: e-content
  #" spend, print spend, the whole collection budget and e-content's share of it (all systems that reported).
  #" Answer: $419M (FY2018) to $724M (FY2024), +73% in current dollars (not inflation-adjusted), now 45% of
  #" collection budgets and about level with print.
  #" Who acts: e-content vendors sizing the market; library boards setting the print/digital split.
  # line_chart { x=fiscal_year y=econtent_budget }
  view: econtent_market_by_year is {
    group_by: fiscal_year
    aggregate: econtent_budget, print_budget, collection_budget, econtent_share_of_collection, digital_share
    order_by: fiscal_year
  }

  #" Systems serving 20,000+ people, ranked by how far visits have come back since FY2019.
  view: change_by_system is {
    where: population_served >= 20000
    group_by: library_name
    aggregate: visits_fy2019, visits_fy2024, visits_change_vs_fy2019, visits_per_capita_fy2024
    having: visits_fy2019 > 0 and visits_fy2024 > 0
    order_by: visits_change_vs_fy2019 desc
    limit: 15
  }

  #" Each state's visits per person, FY2019 and FY2024, and the change.
  view: change_by_state is {
    group_by: state
    aggregate: visits_per_capita_fy2019, visits_per_capita_fy2024, visits_change_vs_fy2019
    order_by: visits_per_capita_fy2024 desc
  }

  #" Big systems against small ones, FY2024: use, cost, staffing, hours, and change in visits since FY2019.
  # bar_chart { x=size_band y=visits_per_capita_fy2024 }
  view: by_size_band is {
    where: size_band != 'Unknown'
    group_by: size_band
    aggregate:
      systems_fy2024 is systems { where: fiscal_year = 2024 }
      people_served_fy2024 is total_population { where: fiscal_year = 2024 }
      visits_per_capita_fy2024
      circulation_per_capita_fy2024 is circulation_per_capita { where: fiscal_year = 2024 }
      digital_share_fy2024 is digital_share { where: fiscal_year = 2024 }
      spend_per_capita_fy2024 is spend_per_capita { where: fiscal_year = 2024 }
      cost_per_visit_fy2024 is cost_per_visit { where: fiscal_year = 2024 }
      staff_per_10k_fy2024 is staff_per_10k { where: fiscal_year = 2024 }
      weekly_hours_per_building_fy2024 is weekly_hours_per_building { where: fiscal_year = 2024 }
      visits_per_capita_fy2019
      visits_change_vs_fy2019
    order_by: size_band
  }

  #" PLAYBOOK. Do small or large library systems give more per dollar? FY2024, one row per size band (comparable
  #" systems only): spend per person, cost per visit, cost per item borrowed, visits per $1,000. Answer (FY2024):
  #" it depends on the yardstick. Small systems spend MORE per person ($58 under 5k vs $50 at 500k+) but get far
  #" more visits per dollar ($13.86 per visit vs $23.42; 72 vs 43 visits per $1,000). Per item borrowed the
  #" 100k–500k band is cheapest ($7.39 vs $8.77 for the smallest). Who acts: county and city budget offices weighing
  #" a merger into a regional system, and state library agencies setting aid formulas.
  # bar_chart { x=size_band y=cost_per_visit_fy2024 }
  view: systems_by_size_value_per_dollar is {
    where: fiscal_year = 2024 and size_band != '6 Not comparable' and size_band != 'Unknown'
    group_by: size_band
    aggregate:
      systems_fy2024 is systems
      people_served_fy2024 is total_population
      # currency
      spend_per_capita_fy2024 is spend_per_capita
      # currency
      cost_per_visit_fy2024 is cost_per_visit
      # currency
      cost_per_checkout_fy2024 is cost_per_checkout
      visits_per_1k_dollars_fy2024 is visits_per_1k_dollars
      visits_per_capita_fy2024
    order_by: size_band
  }

  #" Visits per person each year, one line per size band.
  # line_chart { x=fiscal_year y=visits_per_capita series=size_band }
  view: size_band_by_year is {
    where: size_band != 'Unknown' and size_band != '6 Not comparable'
    group_by: fiscal_year, size_band
    aggregate: visits_per_capita
    order_by: fiscal_year
  }

  #" The biggest systems in FY2024 by population served.
  view: largest_systems is {
    where: fiscal_year = 2024 and size_band != '6 Not comparable'
    group_by: library_name, state
    aggregate: total_population, visits_per_capita, circulation_per_capita, digital_share, spend_per_capita, cost_per_visit, staff_per_10k
    order_by: total_population desc
    limit: 15
  }

  #" Most-used small systems in FY2024 (1,000 – 25,000 people served).
  view: busiest_small_systems is {
    where: fiscal_year = 2024 and population_served >= 1000 and population_served < 25000 and size_band != '6 Not comparable'
    group_by: library_name, state
    aggregate: total_population, visits_per_capita, circulation_per_capita, spend_per_capita, cost_per_visit
    order_by: visits_per_capita desc
    limit: 15
  }
}

given:
  # label="System size" control=select suggest { source=library_years dimension=size_band }
  SIZE_BAND :: filter<string> is f''

// ---------------------------------------------------------------------------------------------
// E-content prospects (FY2022 – FY2024 averages). Which libraries buy less e-content than is typical for their size,
// and how many dollars that is. Every ratio is a three-year figure: the system's FY2022 – FY2024 totals pooled over
// the years it could be benchmarked (e-content $ / collection $, digital loans / all loans, e-content $ / digital
// loan), so one odd year cannot put a library on or off the list (San Bernardino's e-content share went 67%, 39%, 29%
// in those three years; Queens' collection budget fell 26% in one). A system needs FY2024 plus at least one of
// FY2022/FY2023 to be benchmarked. Size band, state and name come from FY2024.
//   Signal 1: digital share of BORROWING vs the median for its size band (patron demand).
//   Signal 2: e-content share of its COLLECTION BUDGET vs the median for its size band (spending).
//   Screen: e-content dollars per digital loan under half the band median (low cost per loan).
// prospect_type: 'Pitch the library' = below on both signals, not screened; 'High demand, low spend' = below on
// spending but at or above typical on digital borrowing, not screened; 'Check for a shared collection' = below on
// spending and screened (low cost per loan: a shared collection MAY supply its e-books; not proof of a consortium);
// 'Not a prospect' = at or above typical on spending.
// Gap = average yearly collection budget x (band median e-content share - own e-content share).
// Malloy has no median aggregate (median!() is rejected as a scalar), so each median is taken in two query stages:
// rank each system within its band with row_number, then average the one or two middle rows.
// ---------------------------------------------------------------------------------------------

// Each system's FY2022 – FY2024 totals over the years it could be benchmarked (meets the public-library definition,
// reports borrowing > 0, digital loans > 0, collection spend > 0 and own e-content spend > 0).
source: econtent_three_years is library_years_base -> {
  where:
    fiscal_year >= 2022 and fiscal_year <= 2024
    and meets_public_library_definition = 'Y'
    and circulation > 0 and digital_circulation > 0
    and collection_spend > 0 and econtent_spend > 0
  group_by: library_id
  aggregate:
    years_benchmarked is count()
    econtent_spend_3yr is econtent_spend.sum()
    collection_spend_3yr is collection_spend.sum()
    digital_circulation_3yr is digital_circulation.sum()
    circulation_3yr is circulation.sum()
    econtent_share_fy2022 is econtent_share_of_collection { where: fiscal_year = 2022 }
    econtent_share_fy2023 is econtent_share_of_collection { where: fiscal_year = 2023 }
    econtent_share_fy2024 is econtent_share_of_collection { where: fiscal_year = 2024 }
} extend {
  primary_key: library_id
}

source: econtent_candidates_base is library_years_base extend {
  join_one: three_years is econtent_three_years with library_id
  where:
    fiscal_year = 2024
    and meets_public_library_definition = 'Y'
    and size_band != '6 Not comparable' and size_band != 'Unknown'
    and circulation > 0
    and digital_circulation is not null
    and collection_spend > 0
  dimension:
    #" 'Benchmarked', '0 digital loans reported' (383 systems FY2024: almost certainly a non-report, since nearly
    #" every US library offers e-books), 'No own e-content spend' (754: they lend e-books bought by a state or
    #" consortium, e.g. much of Kansas, Tennessee and Pennsylvania, so their own budget can't be benchmarked) or
    #" 'Only 1 of FY2022–24 usable' (134: FY2024 alone, too little history for a three-year average).
    benchmark_status is
      pick '0 digital loans reported' when digital_circulation = 0
      pick 'No own e-content spend' when econtent_spend is null or econtent_spend = 0
      pick 'Only 1 of FY2022–24 usable' when three_years.years_benchmarked is null or three_years.years_benchmarked < 2
      else 'Benchmarked'
  // Rows here are FY2024 only and filtered, so the inherited system-year count and the market-sized money measures
  // would read as national figures when they are not. Replaced below with explicitly FY2024, in-view measures.
  except: systems, econtent_budget, print_budget, collection_budget
  measure:
    #" Number of library systems (each row is one system's FY2024 record).
    candidate_systems is count()
    #" FY2024 collection (materials) budget of the systems in view, US dollars as reported.
    # currency
    collection_budget_fy2024 is collection_spend.sum()
    #" FY2024 own e-content spend of the systems in view, US dollars as reported. NOT the US market: across the
    #" 5,084 benchmarked systems in econtent_prospects it totals $585.7M. The US market is library_years ->
    #" econtent_market_by_year: $724M in FY2024 (every system that reported e-content spend). The $138M difference is
    #" systems left out of the benchmark, almost all of it ($132.6M) from 2,234 systems that did not report FY2024
    #" borrowing (incl. Chicago, Multnomah, Hillsborough, Miami-Dade, Broward), so their digital share can't be
    #" compared. Quote $724M for market size; use this only for the benchmarked group.
    # currency
    econtent_spend_fy2024 is econtent_spend.sum()

  #" How many FY2024 systems were left out of the e-content benchmark, and why, with their collection budgets.
  view: who_was_left_out is {
    group_by: benchmark_status
    aggregate: candidate_systems, collection_budget_fy2024, econtent_spend_fy2024
    order_by: candidate_systems desc
  }
}

#" FY2024 library systems that could in principle be benchmarked on digital content (meet the public-library
#" definition, comparable size band, report borrowing and digital borrowing, spend on their collection), with
#" benchmark_status saying whether each one was used. One row per system (its FY2024 record). Use who_was_left_out to
#" see how many were dropped and why. Systems that did not report FY2024 borrowing (2,234, holding $132.6M of FY2024
#" e-content spend) are filtered out before this source, so who_was_left_out does not list them; they are most of the
#" difference between the $724M market and the $585.7M benchmarked spend.
source: econtent_candidates is econtent_candidates_base extend {}

// Systems benchmarked on digital content (5,084): FY2024 candidates with more than 0 digital loans, their own
// e-content spend, and at least two usable years in FY2022 – FY2024.
source: econtent_systems is econtent_candidates_base extend {
  where: benchmark_status = 'Benchmarked'
  dimension:
    #" Years in FY2022 – FY2024 this system could be benchmarked (2 or 3).
    years_benchmarked is three_years.years_benchmarked
    #" This system's share of borrowing that is digital, FY2022 – FY2024 pooled (digital loans / all loans).
    # percent
    own_digital_share is three_years.digital_circulation_3yr / three_years.circulation_3yr
    #" This system's share of its collection budget spent on e-content, FY2022 – FY2024 pooled.
    # percent
    own_econtent_share is three_years.econtent_spend_3yr / three_years.collection_spend_3yr
    #" This system's e-content dollars per digital loan, FY2022 – FY2024 pooled.
    # currency
    own_econtent_per_digital_checkout is three_years.econtent_spend_3yr / three_years.digital_circulation_3yr
    #" Average yearly collection budget over the usable FY2022 – FY2024 years, US dollars as reported.
    # currency
    avg_collection_spend is three_years.collection_spend_3yr / three_years.years_benchmarked
    #" Average yearly e-content spend over the usable FY2022 – FY2024 years, US dollars as reported.
    # currency
    avg_econtent_spend is three_years.econtent_spend_3yr / three_years.years_benchmarked
    #" E-content share of the collection budget in FY2022 (null when that year was not usable).
    # percent
    econtent_share_fy2022 is three_years.econtent_share_fy2022
    #" E-content share of the collection budget in FY2023 (null when that year was not usable).
    # percent
    econtent_share_fy2023 is three_years.econtent_share_fy2023
    #" E-content share of the collection budget in FY2024.
    # percent
    econtent_share_fy2024 is three_years.econtent_share_fy2024
}

// Stage 1 of the band medians: each system's position within its band on each of the three ratios.
source: econtent_band_ranks is econtent_systems -> {
  group_by: size_band, library_id, own_digital_share, own_econtent_share, own_econtent_per_digital_checkout
  aggregate: one_system is count()
  calculate:
    band_position is row_number() { partition_by: size_band order_by: own_digital_share }
    econtent_position is row_number() { partition_by: size_band order_by: own_econtent_share }
    per_checkout_position is row_number() { partition_by: size_band order_by: own_econtent_per_digital_checkout }
    band_count is sum_window(one_system) { partition_by: size_band }
}

#" Typical (median) FY2022 – FY2024 ratios for each size band: digital share of borrowing, e-content share of the
#" collection budget, and e-content dollars per digital loan. Median = the middle system, or the average of the two
#" middle systems when the band has an even count.
source: econtent_band_typical is econtent_band_ranks -> {
  group_by: size_band
  aggregate:
    band_median_share is own_digital_share.avg() { where: band_position >= band_count / 2 and band_position <= band_count / 2 + 1 }
    band_median_econtent_share is own_econtent_share.avg() { where: econtent_position >= band_count / 2 and econtent_position <= band_count / 2 + 1 }
    band_median_per_checkout is own_econtent_per_digital_checkout.avg() { where: per_checkout_position >= band_count / 2 and per_checkout_position <= band_count / 2 + 1 }
    systems_in_band is band_count.max()
} extend {
  primary_key: size_band
}

#" E-content prospects: who to call to sell e-books / e-audio to public libraries, and how many dollars are at stake.
#" START HERE: view econtent_opportunity_headline (the answer in one row) and libraries_to_pitch_digital_content (the
#" call list). HEADLINE: 1,064 libraries to pitch, $17.2M a year of e-content spend at the typical share; the top 25
#" hold $10.1M (59%). The three prospect groups are SEPARATE SEGMENTS - never add them into one total: the $10.6M
#" 'High demand, low spend' list is a second list, and the $17.0M 'Check for a shared collection' group is a screen
#" kept out of every headline (the buyer may be a consortium). View econtent_opportunity_by_segment shows them side
#" by side. ROW GRAIN: one row per benchmarked library system (5,084 systems, one row each). The row is the system's
#" FY2024 record (its key system_year_id is that FY2024 id), carrying ratios pooled over FY2022 – FY2024; count
#" systems with benchmarked_systems. MARKET SIZE is not on this source: the US library e-content market is
#" library_years -> econtent_market_by_year ($724M in FY2024, +73% since FY2018). econtent_spend_fy2024 here is only
#" the benchmarked systems' FY2024 spend ($585.7M). Of the $138M difference, $132.6M is 2,234 systems that did not
#" report FY2024 borrowing (they are not in econtent_candidates either); the rest is the groups in who_was_left_out.
#" Every ratio is averaged over FY2022 – FY2024 (pooled), against the median for its size band. prospect_type: 'Pitch the library' = below typical on BOTH digital borrowing and e-content
#" share, paying for its own loans; 'High demand, low spend' = below typical on e-content share but at or above
#" typical on digital borrowing (patrons already borrow digitally; under-spending likely means holds queues - the
#" classic e-content pitch; NYPL is the largest); 'Check for a shared collection' = below on e-content share and
#" spending under half the typical e-content dollars per digital loan. That last group is a COST-PER-LOAN SCREEN, not
#" proof of a consortium: Hennepin County MN does lend through a shared OverDrive collection (Twin Cities Metro
#" eLibrary), but Wake County NC runs its own OverDrive collection, and cheap loans also come from cost-per-circ
#" licences or older titles. Check before calling. econtent_gap = average yearly collection budget x (band median
#" e-content share - own share): extra e-content dollars a year at the typical share. HONEST LIMITS: library
#" collection budgets are roughly fixed, so this is budget that would SHIFT from print to digital, not new money; for
#" a vendor it is share-of-wallet. Dollars are as reported, not inflation-adjusted. Peers' share may not be the right
#" target (some communities prefer print). E-content spend includes databases, and some states buy databases for
#" their libraries (NC LIVE, GALILEO in GA, TexShare in TX), so libraries there look lower on e-content share. The
#" incumbent (OverDrive) already sees each library's own spend; the list is most useful to challengers and to
#" library boards benchmarking themselves.
source: econtent_prospects is econtent_systems extend {
  join_one: band_typical is econtent_band_typical with size_band
  dimension:
    #" Median digital share of borrowing for systems in the same size band (FY2022 – FY2024 pooled, all US).
    # percent
    typical_digital_share is band_typical.band_median_share
    #" Median e-content share of collection budget for systems in the same size band (FY2022 – FY2024 pooled, all US).
    # percent
    typical_econtent_share is band_typical.band_median_econtent_share
    #" Median e-content dollars per digital loan for systems in the same size band (FY2022 – FY2024 pooled, all US).
    # currency
    typical_econtent_per_digital_checkout is band_typical.band_median_per_checkout
    #" True when the system's digital share of borrowing is below its band's median.
    is_below_band is own_digital_share < typical_digital_share
    #" True when the system's e-content share of its collection budget is below its band's median.
    is_below_on_econtent_spend is own_econtent_share < typical_econtent_share
    #" True when the system spends under half its band's typical e-content dollars per digital loan. A screen, not a
    #" finding: a shared collection may supply its e-books, or its licences are cheap per loan. Check before calling.
    is_low_cost_per_loan is own_econtent_per_digital_checkout < 0.5 * typical_econtent_per_digital_checkout
    #" 'Pitch the library', 'High demand, low spend', 'Check for a shared collection' or 'Not a prospect' (see the
    #" source description).
    prospect_type is
      pick 'Not a prospect' when not is_below_on_econtent_spend
      pick 'Check for a shared collection' when is_low_cost_per_loan
      pick 'Pitch the library' when is_below_band
      else 'High demand, low spend'
    #" Extra e-content dollars a year at the band's typical e-content share (average yearly collection budget x the
    #" share gap), for systems below typical on e-content share; 0 otherwise. US dollars as reported.
    # currency
    system_econtent_gap is pick avg_collection_spend * (typical_econtent_share - own_econtent_share)
      when is_below_on_econtent_spend else 0
    #" Earlier, borrowing-only method (kept for comparison): average collection budget x (band median digital share -
    #" own digital share) for systems below their band's median digital share; 0 otherwise.
    # currency
    system_room is pick avg_collection_spend * (typical_digital_share - own_digital_share) when is_below_band else 0

  measure:
    #" Number of library systems benchmarked (one row per system, so this counts systems: 5,084 in all).
    benchmarked_systems is count()
    #" Systems whose digital share of borrowing is below their size band's median.
    systems_below_band is count() { where: is_below_band }
    #" Systems to pitch directly: below typical on both borrowing and e-content spend, not under the cost-per-loan screen.
    libraries_to_pitch is count() { where: prospect_type = 'Pitch the library' }
    #" Systems below typical on e-content share but at or above typical on digital borrowing (not screened).
    high_demand_low_spend_libraries is count() { where: prospect_type = 'High demand, low spend' }
    #" Systems below typical on e-content share that spend under half the typical dollars per digital loan.
    shared_collection_checks is count() { where: prospect_type = 'Check for a shared collection' }
    #" HEADLINE opportunity: e-content dollars a year the 'Pitch the library' systems would add at their band's typical
    #" share ($17.2M across 1,064 libraries; the top 25 hold $10.1M). Quote this one. Do not add the other two groups
    #" to it.
    # currency
    pitchable_econtent_gap is system_econtent_gap.sum() { where: prospect_type = 'Pitch the library' }
    #" E-content dollars a year the 'High demand, low spend' systems would add at their band's typical share ($10.6M,
    #" 488 libraries). A SEPARATE second list, not part of the $17.2M headline; never add the two together.
    # currency
    high_demand_econtent_gap is system_econtent_gap.sum() { where: prospect_type = 'High demand, low spend' }
    #" E-content dollars a year at the typical share for the 'Check for a shared collection' systems ($17.0M, 989
    #" libraries). A screen, kept out of every headline and never added to the other groups: the buyer may be a
    #" consortium or the state.
    # currency
    shared_collection_gap is system_econtent_gap.sum() { where: prospect_type = 'Check for a shared collection' }
    #" Per-library gap with no group filter (the dashboard uses it row by row). NOT an opportunity figure: summed over
    #" many libraries it adds three separate segments (pitch list, high demand / low spend, shared-collection screen)
    #" that must not be quoted as one total. For the opportunity use pitchable_econtent_gap ($17.2M).
    # currency
    total_econtent_gap is system_econtent_gap.sum()
    #" Borrowing-only method total (earlier version of this play, kept for comparison).
    # currency
    total_room is system_room.sum()
    #" Average yearly collection budget (FY2022 – FY2024) of the systems in view.
    # currency
    avg_collection_budget is avg_collection_spend.sum()
    #" Pitchable e-content gap as a share of the average collection budget of the systems benchmarked. CAVEAT: states
    #" that buy databases centrally (NC LIVE, GALILEO in GA, TexShare in TX) score high here partly because the state,
    #" not the library, pays; read a state's figure as a lead to check, not as under-buying.
    # percent
    gap_share_of_collection_budget is pitchable_econtent_gap / nullif(avg_collection_budget, 0)

  #" PLAYBOOK, START HERE. How big is the e-book vendor opportunity, in one row? The headline is the pitch list: the
  #" number of libraries to pitch, their e-content gap a year at the typical share ($17.2M across 1,064), and how much
  #" the top 25 and top 10 hold ($10.1M and $7.5M). It covers the pitch list only. The 'High demand, low spend' list
  #" ($10.6M) and the shared-collection screen ($17.0M) are separate segments (see econtent_opportunity_by_segment):
  #" never add them to the headline or to each other.
  #" US market size for context: library_years -> econtent_market_by_year ($724M in FY2024). Filter by state for a
  #" territory headline.
  view: econtent_opportunity_headline is {
    where: prospect_type = 'Pitch the library'
    group_by: library_id
    aggregate: gap is pitchable_econtent_gap
    calculate: gap_rank is row_number() { order_by: gap desc }
  } -> {
    aggregate:
      libraries_to_pitch is count()
      # currency
      headline_econtent_gap is gap.sum()
      # currency
      top_25_gap is gap.sum() { where: gap_rank <= 25 }
      # percent
      top_25_share is gap.sum() { where: gap_rank <= 25 } / nullif(gap.sum(), 0)
      # currency
      top_10_gap is gap.sum() { where: gap_rank <= 10 }
  }

  #" The three prospect groups side by side, one row each. They are SEPARATE SEGMENTS with different next steps, NOT
  #" parts of one total: 'Pitch the library' is the headline call list; 'High demand, low spend' is a second list;
  #" 'Check for a shared collection' is a screen to resolve before calling (kept out of every headline). Do not sum
  #" the econtent_gap column.
  view: econtent_opportunity_by_segment is {
    where: prospect_type != 'Not a prospect'
    group_by:
      segment_order is prospect_type ? pick 1 when 'Pitch the library' pick 2 when 'High demand, low spend' else 3
      prospect_type
      how_to_use is prospect_type ?
        pick 'HEADLINE: call these first' when 'Pitch the library'
        pick 'Second list: separate, do not add to the headline' when 'High demand, low spend'
        else 'Screen: check who buys first, kept out of every headline'
    aggregate:
      libraries is count()
      # currency
      econtent_gap is system_econtent_gap.sum()
    order_by: segment_order
  }

  #" PLAYBOOK. Which libraries should an e-book / e-audio vendor call first, and why? Systems below the typical for
  #" their size on BOTH digital borrowing and e-content share (FY2022 – FY2024 averages), paying for their own digital
  #" loans, ranked by econtent_gap (the extra e-content dollars a year at the typical share). Shows each year's
  #" e-content share so swings are visible. Who acts: a vendor's library sales team (call the collection-development
  #" manager with the peer benchmark); library boards (benchmark the print/digital split). Filter by state to get a
  #" territory list. Returns the top 50; for a count or a total use the measures libraries_to_pitch and
  #" pitchable_econtent_gap, and for more rows refine with + { limit: N }.
  view: libraries_to_pitch_digital_content is {
    where: prospect_type = 'Pitch the library'
    group_by: state, library_name, size_band
    // Ranking measure first: a `+ { limit: N }` refinement drops order_by and sorts by the first aggregate (friction log).
    aggregate:
      # currency
      econtent_gap is pitchable_econtent_gap
      avg_collection_budget
      # percent
      econtent_share_3yr is own_econtent_share.max()
      # percent
      typical_econtent_share_for_size is typical_econtent_share.max()
      # percent
      share_fy2022 is econtent_share_fy2022.max()
      # percent
      share_fy2023 is econtent_share_fy2023.max()
      # percent
      share_fy2024 is econtent_share_fy2024.max()
      # percent
      digital_share_3yr is own_digital_share.max()
      # percent
      typical_digital_share_for_size is typical_digital_share.max()
    order_by: econtent_gap desc
    limit: 50
  }

  #" PLAYBOOK. High demand, low spend: libraries whose patrons already borrow digitally at or above the typical for
  #" their size, but which put a smaller share of their collection budget into e-content than their peers (FY2022 –
  #" FY2024 averages), and are not under the cost-per-loan screen. In business terms: demand is there and the budget is
  #" not, which usually means long holds queues - the strongest e-content pitch, made to the collection-development
  #" manager with the holds data. Ranked by econtent_gap. NYPL (branch libraries) is the largest. A shared collection
  #" can still supply some of these; not checked. A SEPARATE list ($10.6M, 488 libraries): do not add it to the $17.2M
  #" pitch-list headline.
  view: high_demand_low_spend is {
    where: prospect_type = 'High demand, low spend'
    group_by: state, library_name, size_band
    aggregate:
      # currency
      econtent_gap is high_demand_econtent_gap
      avg_collection_budget
      # percent
      econtent_share_3yr is own_econtent_share.max()
      # percent
      typical_econtent_share_for_size is typical_econtent_share.max()
      # percent
      digital_share_3yr is own_digital_share.max()
      # percent
      typical_digital_share_for_size is typical_digital_share.max()
      # currency
      econtent_per_digital_loan is own_econtent_per_digital_checkout.max()
    order_by: econtent_gap desc
    limit: 50
  }

  #" PLAYBOOK. Check for a shared collection before calling: libraries below typical on e-content share that spend
  #" under half the typical e-content dollars per digital loan (FY2022 – FY2024). This is a cost-per-loan screen, NOT
  #" proof of a consortium. Hennepin County MN is a confirmed case (Twin Cities Metro eLibrary, MELSA); Wake County NC
  #" runs its own OverDrive collection. Who acts: a vendor should find out who buys for the library (the library, a
  #" consortium or the state) before calling. Its dollars ($17.0M, 989 libraries) are kept out of the headline and are
  #" never added to the pitch list or the high-demand list.
  view: shared_collection_check is {
    where: prospect_type = 'Check for a shared collection'
    group_by: state, library_name, size_band
    aggregate:
      # currency
      econtent_gap is shared_collection_gap
      avg_collection_budget
      # currency
      econtent_per_digital_loan is own_econtent_per_digital_checkout.max()
      # currency
      typical_per_loan_for_size is typical_econtent_per_digital_checkout.max()
    order_by: econtent_gap desc
    limit: 25
  }

  #" The pitchable e-content gap by state, normalised: gap as a share of the state's average benchmarked collection
  #" budget (so big states don't win just for being big), with the dollars and the number of libraries to pitch.
  #" CAVEAT: states that buy databases centrally (NC LIVE, GALILEO in GA, TexShare in TX) rank high partly because the
  #" state pays, not because their libraries under-buy e-books.
  view: econtent_gap_by_state is {
    group_by: state
    aggregate: gap_share_of_collection_budget, pitchable_econtent_gap, libraries_to_pitch, high_demand_econtent_gap, benchmarked_systems
    order_by: gap_share_of_collection_budget desc
  }

  #" Each size band's typical digital share, typical e-content share and the e-content gap by group.
  view: econtent_gap_by_size is {
    group_by: size_band
    aggregate:
      benchmarked_systems
      # percent
      typical_digital_share_for_size is typical_digital_share.max()
      # percent
      typical_econtent_share_for_size is typical_econtent_share.max()
      libraries_to_pitch
      pitchable_econtent_gap
      high_demand_low_spend_libraries
      high_demand_econtent_gap
    order_by: size_band
  }

  #" Earlier, borrowing-only prospect list (kept for comparison; superseded by libraries_to_pitch_digital_content).
  view: prospect_list is {
    where: is_below_band
    group_by: state, library_name, size_band
    aggregate:
      room is total_room
      avg_collection_budget
      # percent
      digital_share_3yr is own_digital_share.max()
      # percent
      typical_for_band is typical_digital_share.max()
    order_by: room desc
    limit: 25
  }
}

#" US Census county population estimates (1 July), 2010 – 2025. 2010–2019 from Vintage 2020, 2020–2025 from Vintage 2025.
#" Connecticut is planning regions from 2020 on (a Census change), counties before.
source: county_population is motherduck.table('libraries.county_population') extend {
  primary_key: county_year_id
  measure:
    #" County residents (Census estimate, 1 July of pop_year).
    residents is population.sum()
    #" Residents on 1 July 2020.
    residents_2020 is residents { where: pop_year = 2020 }
    #" Residents on 1 July 2024.
    residents_2024 is residents { where: pop_year = 2024 }
    #" People added, 1 July 2020 to 1 July 2024.
    people_added_2020_2024 is residents_2024 - residents_2020
    #" Population growth from 1 July 2020 to 1 July 2024 (both from Vintage 2025). US: +2.54%.
    # percent
    growth_2020_2024 is residents_2024 / nullif(residents_2020, 0) - 1

  #" The 15 fastest-growing counties, 2020 – 2024.
  # bar_chart { x=county_name y=growth_2020_2024 }
  view: fastest_growing is {
    group_by: county_name
    aggregate: residents_2020, residents_2024, people_added_2020_2024, growth_2020_2024
    order_by: growth_2020_2024 desc
    limit: 15
  }

  #" Population growth by state, 2020 – 2024.
  view: growth_by_state is {
    group_by: state
    aggregate: residents_2024, people_added_2020_2024, growth_2020_2024
    order_by: growth_2020_2024 desc
  }
}

#" Library use and spend per COUNTY RESIDENT: one row per library system x county it has a building in x fiscal
#" year (FY2018 – FY2024). A regional system (several counties) is shared out across its counties by population
#" (pop_weight), so counties can be compared per resident. Every system in a county counts toward it (e.g. Orange
#" County NC = Orange County Public Library + Chapel Hill Public Library). Dollars as reported, not inflation-adjusted.
#" CAVEATS: Durham visits swing between FY2018 and FY2020 (see library_years); FY2024 total and digital borrowing are
#" blank for many systems (physical is reported).
#" For "what would it cost to close the gap" questions use county_spend_gap.
source: county_libraries is motherduck.table('libraries.library_counties') extend {
  join_one: sys is library_years on system_year_id = sys.system_year_id
  join_one: cp is county_population on county_year_id = cp.county_year_id
  dimension:
    #" County name as the Census writes it (e.g. 'Johnston County').
    county_name is cp.county_name
    #" The library system's name (same as system_name; matches library_name in the other sources).
    library_name is sys.library_name
    #" The library system's name.
    system_name is sys.library_name
    #" The county's share of this system's visits: visits x pop_weight.
    shared_visits is sys.visits * pop_weight
    #" The county's share of this system's operating spend: operating_spend x pop_weight, US dollars.
    shared_spend is sys.operating_spend * pop_weight

  measure:
    #" Library visits allocated to the county.
    allocated_visits is shared_visits.sum()
    #" Library operating spend allocated to the county, US dollars as reported.
    # currency
    allocated_spend is shared_spend.sum()
    #" County residents (Census), counted once per county per year however many systems serve it.
    residents is cp.population.sum()
    #" Library visits per county resident, all systems serving the county.
    visits_per_resident is allocated_visits / nullif(residents, 0)
    #" Library operating spend per county resident, US dollars as reported that year.
    # currency
    spend_per_resident is allocated_spend / nullif(residents, 0)
    #" Visits per county resident, FY2019.
    visits_per_resident_fy2019 is visits_per_resident { where: fiscal_year = 2019 }
    #" Visits per county resident, FY2024.
    visits_per_resident_fy2024 is visits_per_resident { where: fiscal_year = 2024 }
    #" Library spend per county resident, FY2019, US dollars.
    # currency
    spend_per_resident_fy2019 is spend_per_resident { where: fiscal_year = 2019 }
    #" Library spend per county resident, FY2024, US dollars.
    # currency
    spend_per_resident_fy2024 is spend_per_resident { where: fiscal_year = 2024 }
    #" Change in visits per county resident, FY2024 against FY2019.
    # percent
    visits_per_resident_change is visits_per_resident_fy2024 / nullif(visits_per_resident_fy2019, 0) - 1
    #" County residents, 1 July 2020.
    residents_2020 is residents { where: fiscal_year = 2020 }
    #" County residents, 1 July 2024.
    residents_2024 is residents { where: fiscal_year = 2024 }
    #" County population growth, 1 July 2020 to 1 July 2024.
    # percent
    population_growth_2020_2024 is residents_2024 / nullif(residents_2020, 0) - 1
    #" Library operating spend allocated to the county, FY2024, US dollars.
    # currency
    allocated_spend_fy2024 is allocated_spend { where: fiscal_year = 2024 }

  #" One row per fiscal year: visits and spend per county resident.
  # line_chart { x=fiscal_year y=visits_per_resident }
  view: by_year is {
    group_by: fiscal_year
    aggregate: visits_per_resident, spend_per_resident, residents, allocated_visits
    order_by: fiscal_year
  }

  #" The growth gap: fastest-growing counties next to how much they use and spend on their libraries.
  view: growth_gap is {
    group_by: county_name
    aggregate:
      population_growth_2020_2024
      residents_2024
      visits_per_resident_fy2024
      visits_per_resident_change
      spend_per_resident_fy2024
    order_by: population_growth_2020_2024 desc
    limit: 20
  }

  #" Every county's visits and spend per resident, FY2024.
  # bar_chart { x=county_name y=visits_per_resident_fy2024 }
  view: visits_per_resident_by_county is {
    group_by: county_name
    aggregate: visits_per_resident_fy2024, spend_per_resident_fy2024, residents_2024
    order_by: visits_per_resident_fy2024 desc
  }

  #" How multi-county (regional) systems are mapped to counties, FY2024.
  view: regional_systems is {
    where: counties_served > 1 and fiscal_year = 2024
    group_by: system_name, county_name
    aggregate:
      buildings is outlets.sum()
      share_of_system is pop_weight.max()
    order_by: system_name, share_of_system desc
  }
}

// ---------------------------------------------------------------------------------------------
// County spend gap (FY2024): each county's library spend per resident against the MEDIAN county in its state,
// and what it would cost a year to reach that median. Same two-stage median as the e-content benchmark.
// ---------------------------------------------------------------------------------------------

// Stage 1: one row per county (FY2024 spend, growth, use), ranked within its state by spend per resident.
source: county_spend_base is county_libraries -> {
  where: county_fips is not null
  group_by: state, county_fips, county_name
  aggregate:
    residents_2020
    residents_2024
    population_growth_2020_2024
    spend_per_resident_fy2019
    spend_per_resident_fy2024
    allocated_spend_fy2024
    visits_per_resident_fy2019
    visits_per_resident_fy2024
    one_county is count(county_fips)
  having: spend_per_resident_fy2024 is not null and residents_2020 > 0
  calculate:
    spend_position is row_number() { partition_by: state order_by: spend_per_resident_fy2024 }
    counties_in_state is sum_window(one_county) { partition_by: state }
}

// Stage 2: the median county's spend per resident in each state.
source: state_county_median is county_spend_base -> {
  group_by: state
  aggregate:
    median_spend_per_resident is spend_per_resident_fy2024.avg() {
      where: spend_position >= counties_in_state / 2 and spend_position <= counties_in_state / 2 + 1
    }
    counties is counties_in_state.max()
} extend {
  primary_key: state
}

#" One row per US county (FY2024): library operating spend per resident (all systems serving the county, regional
#" systems shared by population), population growth 2020 – 2024, visits per resident, and the cost a year to bring
#" the county up to the MEDIAN county in its own state. Use it for "which growing counties underfund their
#" libraries" and "what would it cost county X to reach the state median". Example: Johnston County NC spends $8.60
#" per resident (lowest in NC; the NC median county spends $23.71), so reaching the median would cost about $3.8M a
#" year on top of the ~$2.1M allocated today (two systems serve it: Public Library of Johnston County & Smithfield,
#" and Hocutt-Ellington Memorial Library). Dollars as reported, FY2024. HONEST LIMITS: the median is a peer
#" benchmark, not a standard of need; spend is operating spend (not buildings/capital); counties are compared within
#" their own state only.
source: county_spend_gap is county_spend_base extend {
  join_one: state_median is state_county_median with state
  dimension:
    #" FY2024 library spend per resident of the median county in the same state, US dollars.
    # currency
    state_median_spend_per_resident is state_median.median_spend_per_resident
    #" True when the county spends less per resident than its state's median county.
    is_below_state_median is spend_per_resident_fy2024 < state_median_spend_per_resident
    #" Extra library operating spend a year to bring the county to its state's median spend per resident
    #" (median - own) x residents 2024; 0 when already at or above. US dollars.
    # currency
    county_cost_to_reach_median is pick (state_median_spend_per_resident - spend_per_resident_fy2024) * residents_2024
      when is_below_state_median else 0
    #" Growth band: 'Fast (8%+)', 'Moderate (3-8%)', 'Slow or shrinking (under 3%)', population 2020 – 2024 (US +2.54%).
    growth_band is
      pick 'Fast (8%+)' when population_growth_2020_2024 >= 0.08
      pick 'Moderate (3-8%)' when population_growth_2020_2024 >= 0.03
      else 'Slow or shrinking (under 3%)'

  measure:
    #" Number of counties.
    counties is count()
    #" Annual cost, US dollars, to bring every county here up to its state's median spend per resident.
    # currency
    cost_to_reach_state_median is county_cost_to_reach_median.sum()
    #" Residents in 2024 (Census).
    # number
    county_residents_2024 is residents_2024.sum()
    #" Counties spending below their state's median per resident.
    counties_below_median is count() { where: is_below_state_median }

  #" PLAYBOOK. Which fast-growing counties (8%+ population growth 2020 – 2024, about 3x the US rate) spend less on
  #" their libraries per resident than the median county in their state, and what would it cost a year to close the
  #" gap? Ranked by that cost. Who acts: county managers / budget offices and commissioners setting the library
  #" appropriation; library directors making the budget case. Filter by state (e.g. NC).
  view: fast_growing_counties_underfunding_libraries is {
    where: population_growth_2020_2024 >= 0.08 and is_below_state_median
    group_by: state, county_name
    aggregate:
      # label="Yearly cost to reach state median"
      cost_to_reach_state_median
      # percent label="Growth 2020-24"
      growth_2020_2024 is population_growth_2020_2024.max()
      # number label="Residents 2024"
      residents_2024_count is residents_2024.max()
      # currency label="Spend per resident"
      spend_per_resident is spend_per_resident_fy2024.max()
      # currency label="State median per resident"
      state_median is state_median_spend_per_resident.max()
      # label="Visits per resident"
      visits_per_resident is visits_per_resident_fy2024.max()
    order_by: cost_to_reach_state_median desc
    limit: 25
  }

  #" PLAYBOOK. What would it cost each county to reach its state's median library spend per resident? Every county
  #" below the median, ranked by the annual cost, with today's spend. Filter by state and county (e.g. NC, Johnston).
  view: cost_to_reach_state_median_by_county is {
    where: is_below_state_median
    group_by: state, county_name
    aggregate:
      # label="Yearly cost to reach state median"
      cost_to_reach_state_median
      # currency label="Spend per resident"
      spend_per_resident is spend_per_resident_fy2024.max()
      # currency label="State median per resident"
      state_median is state_median_spend_per_resident.max()
      # currency label="Library spend today"
      library_spend_today is allocated_spend_fy2024.max()
      # percent label="Growth 2020-24"
      growth_2020_2024 is population_growth_2020_2024.max()
    order_by: cost_to_reach_state_median desc
    limit: 50
  }

  #" Counties by growth band: how many, how many below their state's median spend per resident, and the cost to
  #" close the gap.
  view: gap_by_growth_band is {
    group_by: growth_band
    aggregate: counties, counties_below_median, cost_to_reach_state_median, county_residents_2024
    order_by: growth_band
  }
}
