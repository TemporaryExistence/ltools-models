##! experimental.givens
import "../libraries.malloy"

#" Do big library systems or small ones serve people better? Visits, borrowing, digital share, spend, cost per visit, staffing and hours by size band (population served), FY2024, and change in visits since FY2019. Pick a state (blank = all US) and a size band.
# artifact { title="Library systems by size: cost and use" givens { STATE="" } } dashboard { columns=6 }
query: systems_by_size is library_years -> {
  where:
    state ~ $STATE,
    size_band ~ $SIZE_BAND
  # colspan=1
  aggregate:
    systems_fy2024 is systems { where: fiscal_year = 2024 }
    visits_per_capita_fy2024
    spend_per_capita_fy2024 is spend_per_capita { where: fiscal_year = 2024 }
    cost_per_visit_fy2024 is cost_per_visit { where: fiscal_year = 2024 }
    visits_change_vs_fy2019
  # colspan=3
  nest:
    by_size_band
    size_band_by_year
    largest_systems
    busiest_small_systems
}

// ---- Presentation queries for systems_by_size.jsx (same measures, no model change) ----

#" Value per dollar by size band, FY2024 (the model's systems_by_size_value_per_dollar view), plus each band's visits per
#" person in FY2019 and FY2024 (by_size_band), under the same state and size filters.
query: systems_by_size_value is library_years -> {
  where:
    state ~ $STATE,
    size_band ~ $SIZE_BAND
  nest:
    systems_by_size_value_per_dollar
    by_size_band
}

#" Chart: spread of systems within each size band, FY2024 (comparable systems reporting visits, population and spend):
#" the 10th, 25th, 50th, 75th and 90th percentile system on visits per person and on cost per visit.
query: systems_by_size_spread is library_years -> {
  where:
    state ~ $STATE,
    size_band ~ $SIZE_BAND,
    fiscal_year = 2024,
    size_band != '6 Not comparable',
    size_band != 'Unknown',
    visits > 0,
    population_served > 0,
    operating_spend > 0
  group_by: size_band, library_id
  aggregate:
    vpp is visits_per_capita
    cpv is cost_per_visit
    one_system is count()
  calculate:
    vpos is row_number() { partition_by: size_band order_by: vpp }
    cpos is row_number() { partition_by: size_band order_by: cpv }
    band_count is sum_window(one_system) { partition_by: size_band }
} -> {
  group_by: band is substr(size_band, 1, 1)
  aggregate:
    systems is count()
    v10 is vpp.min() { where: vpos >= band_count * 0.1 }
    v25 is vpp.min() { where: vpos >= band_count * 0.25 }
    v50 is vpp.min() { where: vpos >= band_count * 0.5 }
    v75 is vpp.min() { where: vpos >= band_count * 0.75 }
    v90 is vpp.min() { where: vpos >= band_count * 0.9 }
    c10 is cpv.min() { where: cpos >= band_count * 0.1 }
    c25 is cpv.min() { where: cpos >= band_count * 0.25 }
    c50 is cpv.min() { where: cpos >= band_count * 0.5 }
    c75 is cpv.min() { where: cpos >= band_count * 0.75 }
    c90 is cpv.min() { where: cpos >= band_count * 0.9 }
  order_by: band
}

// ---- "About this data" panel (added 2026-10-07): rows and fiscal years in the multi-year table, filters ignored. ----

#" About this data: rows and fiscal years in library_systems_by_year (whole table, filters ignored).
query: size_about is library_years -> {
  aggregate:
    table_rows is count()
    first_fy is fiscal_year.min()
    last_fy is fiscal_year.max()
    systems_fy2024 is systems { where: fiscal_year = 2024 }
    borrowing_unreported_fy2024 is systems { where: fiscal_year = 2024 and circulation is null }
}
