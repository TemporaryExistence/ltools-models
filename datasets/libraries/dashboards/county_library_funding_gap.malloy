##! experimental.givens
import "../libraries.malloy"

#" Which fast-growing counties spend least on their libraries, and what would it cost to close the gap? FY2024 library
#" operating spend per resident (every system serving the county, regional systems shared by population) against the
#" median county in the same state, with the yearly cost to reach that median. Population growth 2020 - 2024 (Census).
#" The median is a peer benchmark, not a standard of need. Who acts: county budget offices and commissioners setting the
#" library appropriation; library directors making the budget case.
# artifact { title="7 of North Carolina's 17 fast-growing counties spend below the median county on libraries; $8.5M a year would close the gap" givens { STATE="NC" } } dashboard { columns=6 }
query: county_library_funding_gap is county_spend_gap -> {
  where: state ~ $STATE
  # colspan=2
  aggregate:
    # label="Counties below their state's median"
    counties_below_median
    # label="Yearly cost to bring them to the median" currency
    cost_to_reach_state_median
    # label="Of which, fast-growing counties (8%+)" currency
    fast_growth_cost is cost_to_reach_state_median { where: population_growth_2020_2024 >= 0.08 }
  # colspan=6
  nest:
    # label="Fast-growing counties below the median, by yearly cost to close the gap"
    fast_growing_counties_underfunding_libraries
    # colspan=3
    # label="By growth band"
    gap_by_growth_band
    # colspan=3
    # label="Every county below the median"
    cost_to_reach_state_median_by_county
}

// ---- Presentation queries for county_library_funding_gap.jsx (same measures, no model change) ----

#" Chart: one row per county (FY2024) for the map: residents, growth 2020 - 2024, spend per resident, the state median
#" and the yearly cost to reach it (0 when at or above the median).
query: funding_gap_counties is county_spend_gap -> {
  where: state ~ $STATE
  group_by:
    state, county_fips, county_name, residents_2024, population_growth_2020_2024, spend_per_resident_fy2024,
    state_median_spend_per_resident, county_cost_to_reach_median, is_below_state_median
}

// ---- "About this data" panel (added 2026-10-07): rows and fiscal years in the multi-year table, filters ignored. ----

#" About this data: rows and fiscal years in library_systems_by_year (whole table, filters ignored).
query: funding_gap_about is library_years -> {
  aggregate:
    table_rows is count()
    first_fy is fiscal_year.min()
    last_fy is fiscal_year.max()
    systems_fy2024 is systems { where: fiscal_year = 2024 }
    borrowing_unreported_fy2024 is systems { where: fiscal_year = 2024 and circulation is null }
}
