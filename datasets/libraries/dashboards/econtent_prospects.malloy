##! experimental.givens
import "../libraries.malloy"

#" FY2022 to FY2024 averages. A library is a prospect when its three-year e-content share of its collection budget is
#" below the typical (median) for its size band. 'Pitch the library': also below typical on digital share of borrowing.
#" 'High demand, low spend': at or above typical on digital borrowing (demand is there, the budget is not). 'Check for a
#" shared collection': spends under half the typical e-content dollars per digital loan (a screen, not proof of a
#" consortium). The gap is average yearly collection budget x (band median e-content share - own share): extra
#" e-content dollars a year at the typical share. Budgets are roughly fixed, so this is spend that would shift from
#" print to digital (share-of-wallet for a vendor), not new money. Typical values are national, whatever state is picked.
# artifact { title="Library e-content: a $724M market, and 25 libraries hold over half the gap" givens { STATE="" } } dashboard { columns=6 }
query: econtent_prospects_dashboard is econtent_prospects -> {
  where:
    state ~ $STATE,
    size_band ~ $SIZE_BAND
  group_by: library_id, state, library_name, size_band, prospect_type, own_digital_share, typical_digital_share,
    own_econtent_share, typical_econtent_share, own_econtent_per_digital_checkout, typical_econtent_per_digital_checkout,
    econtent_share_fy2022, econtent_share_fy2023, econtent_share_fy2024
  aggregate:
    avg_budget is avg_collection_budget
    gap is total_econtent_gap
    pitch_gap is pitchable_econtent_gap
  calculate:
    // Rank by the pitchable gap (other groups have 0 here), for the concentration KPI.
    gap_rank is row_number() { order_by: pitch_gap desc }
} -> {
  # colspan=2
  aggregate:
    # label="Systems benchmarked"
    systems_benchmarked is count()
    # label="Libraries to pitch"
    libraries_to_pitch is count() { where: prospect_type = 'Pitch the library' }
    # label="High demand, low spend"
    high_demand is count() { where: prospect_type = 'High demand, low spend' }
    # label="Libraries to check for a shared collection first"
    shared_checks is count() { where: prospect_type = 'Check for a shared collection' }
    # label="E-content gap, libraries to pitch" currency
    pitch_gap is pitch_gap.sum()
    # label="E-content gap, top 25" currency
    top_25_gap is pitch_gap.sum() { where: gap_rank <= 25 }
    # label="E-content gap, high demand, low spend" currency
    high_demand_gap is gap.sum() { where: prospect_type = 'High demand, low spend' }
    # label="E-content gap, shared-collection checks" currency
    shared_gap is gap.sum() { where: prospect_type = 'Check for a shared collection' }
    # label="Average collection budget benchmarked" currency
    avg_budget is avg_budget.sum()
  # colspan=6
  nest:
    #" Libraries to pitch, ranked by e-content gap, with each year's e-content share.
    # label="Libraries to pitch"
    prospects is {
      where: prospect_type = 'Pitch the library'
      group_by:
        # label="State"
        state
        # label="System"
        system is library_name
        # label="Size"
        band is size_band
      aggregate:
        # label="E-content gap" currency
        gap is pitch_gap.sum()
        # label="Average collection budget" currency
        avg_budget is avg_budget.sum()
        # label="E-content share, FY22-24" percent
        econtent_share is own_econtent_share.max()
        # label="Typical e-content share" percent
        typical_econtent is typical_econtent_share.max()
        # label="FY2022" percent
        share_2022 is econtent_share_fy2022.max()
        # label="FY2023" percent
        share_2023 is econtent_share_fy2023.max()
        # label="FY2024" percent
        share_2024 is econtent_share_fy2024.max()
        # label="Digital share" percent
        digital_share is own_digital_share.max()
        # label="Typical digital share" percent
        typical_digital is typical_digital_share.max()
      order_by: gap desc
      limit: 50
    }
    #" High demand, low spend: at or above typical on digital borrowing, below on e-content share, not screened.
    # label="High demand, low spend"
    high_demand_list is {
      where: prospect_type = 'High demand, low spend'
      group_by:
        # label="State"
        state
        # label="System"
        system is library_name
      aggregate:
        # label="E-content gap" currency
        gap is gap.sum()
        # label="E-content share" percent
        econtent_share is own_econtent_share.max()
        # label="Typical e-content share" percent
        typical_econtent is typical_econtent_share.max()
        # label="Digital share" percent
        digital_share is own_digital_share.max()
        # label="Typical digital share" percent
        typical_digital is typical_digital_share.max()
      order_by: gap desc
      limit: 10
    }
    #" Below typical on e-content share and under half the typical cost per digital loan: check who buys first.
    # label="Check for a shared collection first"
    shared is {
      where: prospect_type = 'Check for a shared collection'
      group_by:
        # label="State"
        state
        # label="System"
        system is library_name
      aggregate:
        # label="E-content gap" currency
        gap is gap.sum()
        # label="E-content $ per digital loan" currency
        per_checkout is own_econtent_per_digital_checkout.max()
        # label="Typical" currency
        typical_per_checkout is typical_econtent_per_digital_checkout.max()
      order_by: gap desc
      limit: 10
    }
    #" Typical shares by size band.
    # label="By system size"
    by_size is {
      group_by:
        # label="Size"
        band is size_band
      aggregate:
        # label="Typical e-content share" percent
        typical_econtent is typical_econtent_share.max()
        # label="Typical digital share" percent
        typical_digital is typical_digital_share.max()
        # label="Libraries to pitch"
        pitch is count() { where: prospect_type = 'Pitch the library' }
      order_by: band
    }
}

#" Chart: library e-content and print spend, FY2018 to FY2024 (every system that reported; matches library_years -> econtent_market_by_year).
query: econtent_market is library_years -> {
  where:
    state ~ $STATE,
    size_band ~ $SIZE_BAND
  group_by: fiscal_year
  aggregate: econtent_budget, print_budget, collection_budget, econtent_share_of_collection
  order_by: fiscal_year
}

#" Chart: one point per benchmarked system with an average collection budget of $100k or more (FY2022 to FY2024): how
#" far its e-content share and its digital share of borrowing sit from the typical for its size (percentage points),
#" its budget and its prospect type. Rank numbers only for the top 5 libraries to pitch. Smaller systems are left out to keep the
#" response small (the dashboard runtime caps rows at 5,000).
query: econtent_points is econtent_prospects -> {
  where:
    state ~ $STATE,
    size_band ~ $SIZE_BAND
  group_by: library_id, library_name, state, size_band, prospect_type, own_econtent_share, typical_econtent_share,
    own_digital_share, typical_digital_share
  aggregate: budget is avg_collection_budget, pitch_gap is pitchable_econtent_gap
  calculate: gap_rank is row_number() { order_by: pitch_gap desc }
} -> {
  where: budget >= 100000
  select:
    band is substr(size_band, 1, 1)
    kind is substr(prospect_type, 1, 1)
    econtent_vs_typical is round(own_econtent_share - typical_econtent_share, 4)
    digital_vs_typical is round(own_digital_share - typical_digital_share, 4)
    budget
    gap is round(pitch_gap)
    label is pick concat(library_name, ' (', state, ')') when gap_rank <= 5 and prospect_type = 'Pitch the library' else null
    gap_rank
}

#" Chart: spread of e-content share of collection budget within each size band (FY2022 to FY2024, all benchmarked systems): the
#" 10th, 25th, 50th, 75th and 90th percentile system, by rank within the band.
query: econtent_share_spread is econtent_prospects -> {
  where:
    state ~ $STATE,
    size_band ~ $SIZE_BAND
  group_by: size_band, library_id, own_econtent_share
  aggregate: one_system is count()
  calculate:
    band_position is row_number() { partition_by: size_band order_by: own_econtent_share }
    band_count is sum_window(one_system) { partition_by: size_band }
} -> {
  group_by: band is substr(size_band, 1, 1)
  aggregate:
    systems is count()
    p10 is own_econtent_share.min() { where: band_position >= band_count * 0.1 }
    p25 is own_econtent_share.min() { where: band_position >= band_count * 0.25 }
    p50 is own_econtent_share.min() { where: band_position >= band_count * 0.5 }
    p75 is own_econtent_share.min() { where: band_position >= band_count * 0.75 }
    p90 is own_econtent_share.min() { where: band_position >= band_count * 0.9 }
  order_by: band
}

#" Chart: the pitchable e-content gap by state as a share of the state's average benchmarked collection budget, every
#" state. States that buy databases centrally (NC LIVE, GALILEO in GA, TexShare in TX) look like under-spenders here.
query: econtent_gap_states is econtent_prospects -> {
  where:
    state ~ $STATE,
    size_band ~ $SIZE_BAND
  group_by: state
  aggregate:
    gap_share is gap_share_of_collection_budget
    gap is pitchable_econtent_gap
    prospects is libraries_to_pitch
    systems is benchmarked_systems
}

#" Footnote: FY2024 systems left out of the benchmark, and why (incl. those with only one usable year in FY2022 to FY2024).
query: econtent_left_out is econtent_candidates -> {
  where:
    state ~ $STATE,
    size_band ~ $SIZE_BAND
  group_by: benchmark_status
  aggregate: candidate_systems
}
