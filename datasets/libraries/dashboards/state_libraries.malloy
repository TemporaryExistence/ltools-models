##! experimental.givens
import "../libraries.malloy"

#" How a state's public libraries are used: visits, borrowing, digital share and cost, by system and setting.
# artifact { title="State libraries: visits, borrowing and spend" } dashboard { columns=6 }
query: state_libraries is library_systems -> {
  where: state ~ $STATE
  # colspan=1
  aggregate: systems, total_visits, visits_per_capita, circulation_per_capita, digital_share, spend_per_capita
  # colspan=3
  nest:
    busiest_systems
    most_used_per_person
    by_setting
}

// ---- Presentation queries for state_libraries.jsx (same measures, no model change) ----

#" Which state is picked (one row when a single state is chosen).
query: state_libraries_picked is library_systems -> {
  where: state ~ $STATE
  group_by: state
}

#" Chart: every state's visits, borrowing, digital share and spend per person, FY2023 (library_systems -> by_state), for
#" the maps and the state's rank.
query: state_libraries_map is library_systems -> by_state

#" Chart: visits and spend per person each fiscal year FY2018 to FY2024, the picked state against the whole US
#" (library_years, every system, dollars as reported).
query: state_libraries_trend is library_years -> {
  group_by: fiscal_year
  aggregate:
    state_visits_per_capita is visits_per_capita { where: state ~ $STATE }
    us_visits_per_capita is visits_per_capita
    state_spend_per_capita is spend_per_capita { where: state ~ $STATE }
    us_spend_per_capita is spend_per_capita
  order_by: fiscal_year
}

// ---- "About this data" panel (added 2026-10-07): rows and fiscal years in the multi-year table, filters ignored. ----

#" About this data: rows and fiscal years in library_systems_by_year (whole table, filters ignored).
query: state_libraries_about is library_years -> {
  aggregate:
    table_rows is count()
    first_fy is fiscal_year.min()
    last_fy is fiscal_year.max()
    systems_fy2024 is systems { where: fiscal_year = 2024 }
    borrowing_unreported_fy2024 is systems { where: fiscal_year = 2024 and circulation is null }
}

// ---- Conclusion charts at the top of the page (added 2026-10-07). Computed live; the e-content charts are national
// (filters ignored), the growth and county charts follow the State filter. ----

#" Conclusion chart: US library e-content and print spend by fiscal year, FY2018 to FY2024 (every system that reported).
query: state_libraries_concl_market is library_years -> econtent_market_by_year

#" Conclusion chart: the e-content opportunity headline (pitch list only; national benchmark, FY2022 to FY2024 pooled).
query: state_libraries_concl_gap is econtent_prospects -> econtent_opportunity_headline

#" Conclusion chart: the ten libraries to pitch with the largest e-content gap a year (national).
query: state_libraries_concl_pitch is econtent_prospects -> libraries_to_pitch_digital_content + {
  limit: 10
  // Repeated: a limit-only refinement drops the view's order_by (friction log).
  order_by: econtent_gap desc
}

#" Conclusion chart: population growth 2020 to 2024 and change in library visits per resident FY2019 to FY2024, for the
#" picked state(s) and for the whole US.
query: state_libraries_concl_growth is county_libraries -> {
  aggregate:
    picked_growth is population_growth_2020_2024 { where: state ~ $STATE }
    picked_visits_change is visits_per_resident_change { where: state ~ $STATE }
    us_growth is population_growth_2020_2024
    us_visits_change is visits_per_resident_change
}

#" Conclusion chart: every fast-growing county (8%+ growth 2020 to 2024) in the picked state(s), FY2024 library spend
#" per resident against its state's median county, and the yearly cost to reach that median.
query: state_libraries_concl_counties is county_spend_gap -> {
  where: state ~ $STATE and population_growth_2020_2024 >= 0.08
  group_by: state, county_name
  aggregate:
    spend is spend_per_resident_fy2024.max()
    median is state_median_spend_per_resident.max()
    growth is population_growth_2020_2024.max()
    cost is cost_to_reach_state_median
  order_by: spend asc
}
