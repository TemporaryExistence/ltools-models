##! experimental { givens }

// US domestic flights, BTS Reporting Carrier On-Time Performance (US public data), May–July 2026 (92 days).
// The published model reads MotherDuck (`ltools.flights.*`, read-only token on the instance). Backup: monthly
// Parquet exports served at https://tabblabs.net/datasets/flights/ — a hosted instance can't read files shipped
// inside the repo (friction log F13/F16). The exports carry tail_number (aircraft registration) so each aircraft
// can be followed through its day (see aircraft_legs below).

given:
  # label="Airline" control=select suggest { source=airline_list dimension=airline }
  AIRLINE :: filter<string> is f''
  # label="Origin airport" suggest { source=airport_list dimension=origin }
  ORIGIN :: filter<string> is f''
  # label="Flight date"
  PERIOD :: filter<date> is f''
  # label="Airport size" control=select suggest { source=airport_list dimension=size_band }
  SIZE_BAND :: filter<string> is f''
  # label="Month" control=select suggest { source=month_list dimension=month_label }
  FLIGHT_MONTH :: filter<string> is f''

// One row per scheduled US domestic flight, before the airport-size join. Use `flights`. (A // comment, not #",
// so its text is not inherited into the description of `flights`.)
source: flights_base is motherduck.sql("""
  SELECT * FROM ltools.flights.flights
""") extend {
  dimension:
    #" Airline name from the BTS reporting-carrier code: the airline that OPERATED the flight. Regional carriers
    #" (SkyWest, Envoy, Republic, Endeavor, PSA) appear under their own names, not the mainline brand (United Express,
    #" American Eagle, Delta Connection) they fly for, so a mainline airline's totals exclude its regional partners.
    # drill { to=[self] }
    airline is carrier ?
      pick 'American' when 'AA'
      pick 'Delta' when 'DL'
      pick 'United' when 'UA'
      pick 'Southwest' when 'WN'
      pick 'JetBlue' when 'B6'
      pick 'Alaska' when 'AS'
      pick 'Spirit' when 'NK'
      pick 'Frontier' when 'F9'
      pick 'Allegiant' when 'G4'
      pick 'Hawaiian' when 'HA'
      pick 'SkyWest' when 'OO'
      pick 'Republic' when 'YX'
      pick 'Envoy' when 'MQ'
      pick 'Endeavor' when '9E'
      pick 'PSA' when 'OH'
      else carrier
    #" Origin → destination airport codes.
    route is concat(origin, ' → ', dest)
    #" Scheduled departure hour, 0–23 (local time).
    dep_hour is floor(sched_dep_hhmm / 100)
    weekday is
      pick 'Sun' when day_of_week(flight_date) = 1
      pick 'Mon' when day_of_week(flight_date) = 2
      pick 'Tue' when day_of_week(flight_date) = 3
      pick 'Wed' when day_of_week(flight_date) = 4
      pick 'Thu' when day_of_week(flight_date) = 5
      pick 'Fri' when day_of_week(flight_date) = 6
      else 'Sat'
    cancel_reason is cancellation_code ?
      pick 'Airline' when 'A'
      pick 'Weather' when 'B'
      pick 'Air traffic system' when 'C'
      pick 'Security' when 'D'
      else null

  measure:
    flight_count is count()
    cancellations is count() { where: cancelled }
    # percent
    cancel_rate is cancellations / flight_count
    late_arrivals is count() { where: arrived_late }
    #" Share of operated flights arriving 15+ minutes late.
    # percent
    late_rate is late_arrivals / count() { where: not cancelled and not diverted }
    #" Average arrival delay in minutes (operated flights; early arrivals count as negative).
    avg_arrival_delay is arr_delay_min.avg()
    airline_delay_hours is carrier_delay_min.sum() / 60
    weather_delay_hours is weather_delay_min.sum() / 60
    air_traffic_delay_hours is nas_delay_min.sum() / 60
    late_aircraft_delay_hours is late_aircraft_delay_min.sum() / 60
    #" Of the delay hours BTS attributes to a cause, the share caused by the aircraft arriving late from its previous flight.
    # percent
    late_aircraft_share is late_aircraft_delay_min.sum()
      / (carrier_delay_min.sum() + weather_delay_min.sum() + nas_delay_min.sum()
         + security_delay_min.sum() + late_aircraft_delay_min.sum())
    route_count is count(route)
}

#" SLOW (recomputed from 1.85M flights on every query; may time out on the hosted instance).
#(agent) For exploring the method only; for answers use airport_list. Departures per origin airport over the whole period (May–July 2026, 92 days); drives the size band.
source: airport_sizes is flights_base -> {
  group_by: origin
  aggregate: departures is count()
}

#" SLOW (recomputed from 1.85M flights on every query; may time out on the hosted instance).
#(agent) For exploring the method only; for answers use delays_summary, legs_summary, routes_summary or route_hours_summary (same numbers). One row per scheduled US domestic flight. Delays are in minutes; negative = early.
source: flights is flights_base extend {
  join_one: origin_size is airport_sizes on origin = origin_size.origin

  dimension:
    #" Average scheduled departures per day over May–July 2026 (92 days), for the origin airport.
    origin_departures_per_day is origin_size.departures / 92
    #" Origin airport size, from its departures per day over the full period (not the filtered one):
    #" Hub 400+, Large 100–399, Medium 30–99, Small 10–29, Very small under 10.
    size_band is
      pick '1 Hub (400+/day)' when origin_size.departures >= 36800
      pick '2 Large (100-399/day)' when origin_size.departures >= 9200
      pick '3 Medium (30-99/day)' when origin_size.departures >= 2760
      pick '4 Small (10-29/day)' when origin_size.departures >= 920
      else '5 Very small (<10/day)'

  measure:
    airport_count is count(origin)

  # bar_chart { x=airline y=late_rate }
  view: by_airline is {
    group_by: airline
    aggregate: flight_count, late_rate, cancel_rate, avg_arrival_delay
    order_by: flight_count desc
    limit: 15
  }

  #" Delays build through the day: the later the scheduled departure, the more likely it arrives late.
  # line_chart { x=dep_hour y=late_rate }
  view: by_departure_hour is {
    group_by: dep_hour
    aggregate: late_rate, flight_count
    order_by: dep_hour
  }

  # line_chart { x=flight_date y=flight_count }
  view: by_day is {
    group_by: flight_date
    aggregate: flight_count, late_rate, cancellations
    order_by: flight_date
  }

  #" Where the delay minutes come from (hours).
  view: delay_causes is {
    aggregate: airline_delay_hours, late_aircraft_delay_hours, air_traffic_delay_hours, weather_delay_hours
  }

  #" Busy routes (300+ flights) with the worst late-arrival rate.
  view: worst_routes is {
    group_by: route
    aggregate: flight_count, late_rate, avg_arrival_delay
    having: flight_count >= 300
    order_by: late_rate desc
    limit: 15
  }

  # bar_chart { x=origin y=flight_count }
  view: busiest_airports is {
    group_by: origin
    aggregate: flight_count, late_rate
    order_by: flight_count desc
    limit: 20
  }

  #" Reliability by airport size band: late, cancelled, average delay, and how much delay is a late inbound plane.
  # bar_chart { x=size_band y=late_rate }
  view: by_size_band is {
    group_by: size_band
    aggregate: airport_count, flight_count, late_rate, cancel_rate, avg_arrival_delay, late_aircraft_share
    order_by: size_band
  }

  #" Delay hours by cause, per airport size band.
  view: delay_causes_by_size is {
    group_by: size_band
    aggregate: airline_delay_hours, late_aircraft_delay_hours, air_traffic_delay_hours, weather_delay_hours
    order_by: size_band
  }

  #" RDU and its peers: Charlotte, Nashville, Austin, Richmond, Jacksonville.
  # bar_chart { x=origin y=late_rate }
  view: rdu_peers is {
    where: origin ? 'RDU' | 'CLT' | 'BNA' | 'AUS' | 'RIC' | 'JAX'
    group_by: origin
    aggregate: flight_count, late_rate, cancel_rate, avg_arrival_delay, late_aircraft_share
    order_by: late_rate
  }
}

#" SLOW (recomputed from 1.85M flights on every query; may time out on the hosted instance).
#(agent) For exploring the method only; for answers use legs_summary, legs_detail, inbound_summary or chain_starts_summary (same numbers). Every flight with its place in its aircraft's day: flights are grouped by tail number and date and ordered by scheduled departure (local time), so each flight knows its leg number, the previous flight of the same aircraft, and how the aircraft's first flight of the day went. Cancelled and diverted flights are kept (for cancel rate) but sit in their own partition, so a chain only links flights that operated. Flights with no tail number (3,216, almost all cancelled) carry no chain fields.
source: aircraft_legs is flights -> {
  group_by:
    tail_number, flight_date, flight_number, carrier, airline, origin, dest, route, sched_dep_hhmm, dep_hour,
    size_band, cancelled, diverted, arrived_late, arr_delay_min, dep_delay_min,
    carrier_delay_min, weather_delay_min, nas_delay_min, security_delay_min, late_aircraft_delay_min
    operated is not cancelled and not diverted
    late_flag is pick 1 when arrived_late else 0
  calculate:
    leg_number is row_number() {
      partition_by: tail_number, flight_date, operated
      order_by: sched_dep_hhmm, flight_number
    }
    prev_leg_late is lag(arrived_late) {
      partition_by: tail_number, flight_date, operated
      order_by: sched_dep_hhmm, flight_number
    }
    prev_origin is lag(origin) {
      partition_by: tail_number, flight_date, operated
      order_by: sched_dep_hhmm, flight_number
    }
    first_leg_late_flag is first_value(late_flag) {
      partition_by: tail_number, flight_date, operated
      order_by: sched_dep_hhmm, flight_number
    }
    first_origin is first_value(origin) {
      partition_by: tail_number, flight_date, operated
      order_by: sched_dep_hhmm, flight_number
    }
} extend {
  join_one: prev_size is airport_sizes on prev_origin = prev_size.origin

  dimension:
    #" Size band of the airport the aircraft flew in from (later flights only; same cut points as size_band).
    inbound_size_band is
      pick '1 Hub (400+/day)' when prev_size.departures >= 36800
      pick '2 Large (100-399/day)' when prev_size.departures >= 9200
      pick '3 Medium (30-99/day)' when prev_size.departures >= 2760
      pick '4 Small (10-29/day)' when prev_size.departures >= 920
      pick '5 Very small (<10/day)' when prev_size.departures > 0
      else null
    #" A flight that operated and has a tail number: the rows the delay chain is measured on.
    in_chain is operated and tail_number is not null
    #" Whether the aircraft's first flight of the day arrived late.
    first_leg_late is first_leg_late_flag = 1
    #" How this aircraft's first flight of the day went (later flights only).
    day_start is
      pick 'First flight of the day late' when first_leg_late
      else 'First flight of the day on time'
    #" Whether the aircraft's previous flight that day arrived late.
    inbound is
      pick 'Inbound aircraft late' when prev_leg_late
      else 'Inbound aircraft on time'
    #" Leg of the aircraft's day, 1 = first flight; 7+ grouped.
    leg is pick 7 when leg_number >= 7 else leg_number

  measure:
    flight_count is count()
    cancel_rate is count() { where: cancelled } / count()
    legs is count() { where: in_chain }
    late_legs is count() { where: in_chain and arrived_late }
    #" Share of operated flights arriving 15+ minutes late.
    # percent
    late_rate is late_legs / legs
    avg_arrival_delay is arr_delay_min.avg()
    #" Share of an airport's departures that are the aircraft's first flight of the day.
    # percent
    first_flight_share is count() { where: in_chain and leg_number = 1 } / legs
    #" Of the flights that arrived late, the share whose aircraft's previous flight that day was also late.
    # percent
    chain_share is count() { where: in_chain and arrived_late and prev_leg_late } / late_legs
    #" Of the delay hours BTS attributes to a cause, the share from the aircraft arriving late.
    # percent
    late_aircraft_share is late_aircraft_delay_min.sum()
      / (carrier_delay_min.sum() + weather_delay_min.sum() + nas_delay_min.sum()
         + security_delay_min.sum() + late_aircraft_delay_min.sum())

  #" Later flights of the day: how often they arrive late when the aircraft's first flight was late vs on time.
  # bar_chart { x=day_start y=late_rate }
  view: first_flight_effect is {
    where: in_chain and leg_number > 1
    group_by: day_start
    aggregate: legs, late_rate
    order_by: day_start desc
  }

  #" Same, one step back: the aircraft's previous flight late vs on time.
  # bar_chart { x=inbound y=late_rate }
  view: inbound_effect is {
    where: in_chain and leg_number > 1
    group_by: inbound
    aggregate: legs, late_rate
    order_by: inbound desc
  }

  #" Late rate by leg of the aircraft's day (1 = first flight; 7 = seventh or later).
  # bar_chart { x=leg y=late_rate }
  view: late_by_leg is {
    where: in_chain
    group_by: leg
    aggregate: late_rate, legs
    order_by: leg
  }

  #" Airports whose late first flight of the day ends in a late departure from here (later flights only).
  # bar_chart { x=first_origin y=late_legs }
  view: chain_starts is {
    where: in_chain and leg_number > 1 and first_leg_late and origin != first_origin
    group_by: first_origin
    aggregate: late_legs
    order_by: late_legs desc
    limit: 10
  }

  #" Where the aircraft flew in from (100+ flights): how often it arrived late, and how often it then leaves here late.
  view: inbound_from is {
    where: in_chain and leg_number > 1
    group_by: prev_origin
    aggregate:
      legs
      # percent
      inbound_late_rate is count() { where: prev_leg_late } / legs
      late_rate
    having: legs >= 100
    order_by: legs desc
    limit: 15
  }

  #" Chain exposure by airport size band.
  # bar_chart { x=size_band y=chain_share }
  view: chain_by_size is {
    group_by: size_band
    aggregate: legs, late_rate, cancel_rate, first_flight_share, chain_share, late_aircraft_share
    order_by: size_band
  }

  #" Where each size band's aircraft fly in from: share of later flights by the inbound airport's size band.
  view: inbound_mix_by_size is {
    where: in_chain and leg_number > 1
    group_by: size_band, inbound_size_band
    aggregate:
      legs
      # percent
      share_of_band is legs / all(legs, size_band)
      late_rate
    order_by: size_band, inbound_size_band
  }

  #" First flight of the day vs later flights, by size band: separates the airport from the mix of its flights.
  view: leg_mix_by_size is {
    where: in_chain
    group_by: size_band, flight_of_day is pick 'First' when leg_number = 1 else 'Later'
    aggregate: legs, late_rate
    order_by: size_band, flight_of_day
  }

  #" Time-of-day curve by airport size band.
  # line_chart { x=dep_hour y=late_rate series=size_band }
  view: hour_by_size is {
    where: in_chain and dep_hour >= 5
    group_by: dep_hour, size_band
    aggregate: late_rate
    order_by: dep_hour
  }

  #" Late rate by scheduled departure hour.
  # line_chart { x=dep_hour y=late_rate }
  view: by_hour is {
    where: in_chain
    group_by: dep_hour
    aggregate: late_rate, legs
    order_by: dep_hour
  }

  #" Airlines at this airport.
  # bar_chart { x=airline y=late_rate }
  view: by_airline is {
    group_by: airline
    aggregate: flight_count, late_rate, cancel_rate, avg_arrival_delay
    order_by: flight_count desc
    limit: 10
  }

  #" Busy routes (300+ flights) with the worst late-arrival rate.
  view: worst_routes is {
    group_by: route
    aggregate: flight_count, late_rate, avg_arrival_delay
    having: flight_count >= 300
    order_by: late_rate desc
    limit: 10
  }
}

#" SLOW (recomputed from 1.85M flights on every query; may time out on the hosted instance).
#(agent) For exploring the method only; for answers use chain_slots_summary (same numbers, cost range included). One row per aircraft-day (tail number + date, operated flights only), carrying the first flight of the day's airline, origin, scheduled hour and arrival delay, and what the same aircraft's later flights that day logged. Used to put a cost on delay chains: when the first flight arrives 15+ minutes late, the "late aircraft" delay minutes BTS records on that aircraft's later flights that day are attributed to the first flight's airline, origin airport and scheduled departure hour. Cancelled and diverted flights and flights with no tail number are left out. This is attribution, not proof: storms delay first and later flights together, so not every minute was avoidable by fixing the first departure. Legs are numbered by LOCAL scheduled departure time; across time zones that misorders a few rotations (UTC order changes the first flight on 319 of 411,140 aircraft-days, under 1% of the cost).
source: delay_chains is aircraft_legs -> {
  where: in_chain
  group_by: tail_number, flight_date
  aggregate:
    first_carrier is carrier.max() { where: leg_number = 1 }
    first_airline is airline.max() { where: leg_number = 1 }
    first_origin is origin.max() { where: leg_number = 1 }
    first_size_band is size_band.max() { where: leg_number = 1 }
    first_dep_hour is dep_hour.max() { where: leg_number = 1 }
    first_arr_delay is arr_delay_min.max() { where: leg_number = 1 }
    later_legs is count() { where: leg_number > 1 }
    later_late_aircraft_min is late_aircraft_delay_min.sum() { where: leg_number > 1 }
    next_leg_late_aircraft_min is late_aircraft_delay_min.sum() { where: leg_number = 2 }
} extend {
  dimension:
    #" Carrier code of the aircraft's first flight of the day.
    carrier is first_carrier
    #" Airline of the aircraft's first flight of the day.
    airline is first_airline
    #" Origin airport of the aircraft's first flight of the day.
    origin is first_origin
    #" Size band of that origin airport.
    size_band is first_size_band
    #" Scheduled departure hour (local, 0-23) of the aircraft's first flight of the day.
    dep_hour is first_dep_hour
    #" The first flight of the day arrived 15+ minutes late and the aircraft flew again that day.
    late_start is first_arr_delay >= 15 and later_legs > 0
    #" Conservative attribution (b): this aircraft-day's later-flight late-aircraft minutes, capped at the first
    #" flight's own arrival delay (a 40-minute-late first flight can be charged at most 40 minutes).
    capped_late_aircraft_min is least(coalesce(later_late_aircraft_min, 0), greatest(first_arr_delay, 0))

  measure:
    aircraft_days is count()
    #" Aircraft-days whose first flight arrived 15+ minutes late and that had at least one later flight.
    late_first_legs is count() { where: late_start }
    #" Later flights of those aircraft-days (the flights that could inherit the delay).
    downstream_legs is later_legs.sum() { where: late_start }
    #" "Late aircraft" delay minutes BTS recorded on the later flights of aircraft-days that started late.
    downstream_late_aircraft_minutes is later_late_aircraft_min.sum() { where: late_start }
    #" UPPER-BOUND cost in US dollars: all later-flight late-aircraft minutes at $100.76 a minute (Airlines for
    #" America, average 2024 US passenger airline cost per block minute: crew, fuel, maintenance, ownership).
    downstream_cost_usd is downstream_late_aircraft_minutes * 100.76
    #" Conservative attribution (a): late-aircraft minutes on the NEXT flight only (leg 2) of aircraft-days that
    #" started late. Leg 3 onwards can pick up delay of its own, so it is not charged to the first flight.
    next_leg_late_aircraft_minutes is next_leg_late_aircraft_min.sum() { where: late_start }
    #" Conservative attribution (b): later-flight minutes capped at the first flight's own arrival delay.
    capped_late_aircraft_minutes is capped_late_aircraft_min.sum() { where: late_start }
    #" CONSERVATIVE cost in US dollars, the low end of the range: next-flight-only minutes at $69.07 a minute (Airlines
    #" for America 2025 block-minute cost, $98.41, minus fuel, $29.34: a plane held at the gate burns little fuel).
    conservative_cost_usd is next_leg_late_aircraft_minutes * 69.07
}

#" SLOW (recomputed from 1.85M flights on every query; may time out on the hosted instance).
#(agent) For exploring the method only; for answers use chain_slots_summary (same rows, with playbook views). The "protect these departures" list: one row per airline x first-flight origin x scheduled hour slot that started at least one late delay chain over May-July 2026, ranked by the cost of its chains (slot_rank 1 = most costly, ranked across all airlines and airports, so filtering keeps the national rank). Same method and limit as delay_chains: the downstream minutes are attributed to the slot, not proven avoidable.
source: chain_slots is delay_chains -> {
  where: late_start
  group_by: carrier, airline, origin, size_band, dep_hour
  aggregate:
    slot_late_first_legs is late_first_legs
    slot_downstream_legs is downstream_legs
    slot_minutes is downstream_late_aircraft_minutes
    slot_next_leg_minutes is next_leg_late_aircraft_minutes
    slot_capped_minutes is capped_late_aircraft_minutes
  calculate:
    slot_rank is row_number() { order_by: slot_minutes desc, carrier, origin, dep_hour }
    #" National rank under the conservative (next-flight-only) attribution, 1 = most costly.
    slot_rank_conservative is row_number() { order_by: slot_next_leg_minutes desc, carrier, origin, dep_hour }
} extend {
  dimension:
    #" Departure time of the slot as a label, e.g. "7am".
    hour_label is
      pick '12am' when dep_hour = 0
      pick concat(dep_hour::"INTEGER"::string, 'am') when dep_hour < 12
      pick '12pm' when dep_hour = 12
      else concat((dep_hour - 12)::"INTEGER"::string, 'pm')
    #" The slot is among the 50 most costly nationally.
    in_top_50 is slot_rank <= 50

  measure:
    slot_count is count()
    late_first_legs is slot_late_first_legs.sum()
    downstream_legs is slot_downstream_legs.sum()
    downstream_late_aircraft_minutes is slot_minutes.sum()
    #" UPPER-BOUND cost in US dollars: all later-flight minutes at $100.76 a minute (A4A 2024 block-minute cost).
    downstream_cost_usd is downstream_late_aircraft_minutes * 100.76
    #" Conservative attribution (a): late-aircraft minutes on the next flight only.
    next_leg_late_aircraft_minutes is slot_next_leg_minutes.sum()
    #" Conservative attribution (b): later-flight minutes capped at the first flight's own arrival delay.
    capped_late_aircraft_minutes is slot_capped_minutes.sum()
    #" CONSERVATIVE cost in US dollars (low end of the range): next-flight-only minutes at $69.07 a minute (A4A 2025
    #" block-minute cost less fuel).
    conservative_cost_usd is next_leg_late_aircraft_minutes * 69.07
    #" Share of the downstream cost carried by the 50 most costly slots nationally.
    # percent
    top_50_share is downstream_late_aircraft_minutes { where: in_top_50 } / downstream_late_aircraft_minutes

  #" The most costly slots: where a spare aircraft, more turn time or priority handling would pay back first.
  view: top_slots is {
    group_by: slot_rank, airline, origin, hour_label
    aggregate: late_first_legs, downstream_late_aircraft_minutes, conservative_cost_usd, downstream_cost_usd
    order_by: slot_rank
    limit: 25
  }

  #" Delay-chain cost by the airport where the chain started.
  # bar_chart { x=origin y=downstream_cost_usd }
  view: cost_by_airport is {
    group_by: origin
    aggregate: downstream_cost_usd, late_first_legs
    order_by: downstream_cost_usd desc
    limit: 15
  }
}
