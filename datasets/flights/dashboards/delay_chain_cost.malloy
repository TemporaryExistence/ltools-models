##! experimental.givens
import "../flights.malloy"
import "../summaries.malloy"

#" May-July 2026. For each aircraft-day whose first flight arrived 15+ minutes late, the "late aircraft" delay
#" minutes BTS recorded on the same aircraft's later flights that day are attributed to the first flight's airline,
#" origin airport and scheduled hour. Cost is a range: conservative = the next flight's late-aircraft minutes only, at
#" $69.07 a minute (Airlines for America 2025 block-minute cost less fuel); upper bound = every later flight's minutes,
#" at $100.76 a minute (A4A 2024 block-minute cost). This is attribution, not proof that every minute was avoidable;
#" storms delay first and later flights together. Slot ranks and the top-50 share are national (upper-bound ranking),
#" so they hold when filtered.
# artifact { title="Delay-chain cost by airport, airline and departure slot" } dashboard { columns=6 }
query: delay_chain_cost is chain_slots_summary -> {
  where:
    airline ~ $AIRLINE,
    origin ~ $ORIGIN
  # colspan=2
  aggregate:
    # label="Cost of delay chains (upper bound)" currency
    total_downstream_cost is downstream_cost_usd
    # label="Cost of delay chains (conservative)" currency
    total_conservative_cost is conservative_cost_usd
    # label="Departure slots that started one"
    slots is slot_count
    # label="Share in the 50 costliest slots" percent
    share_in_top_50_slots is top_50_share
    # label="Cost in the 50 costliest slots" currency
    cost_in_top_50_slots is downstream_cost_usd { where: in_top_50 }
    # label="Conservative cost in the 50 costliest slots" currency
    conservative_cost_in_top_50_slots is conservative_cost_usd { where: in_top_50 }
    # label="Share started 5-8am" percent
    share_started_5_to_8am is downstream_late_aircraft_minutes { where: dep_hour >= 5 and dep_hour <= 8 }
      / nullif(downstream_late_aircraft_minutes, 0)
  # colspan=6
  nest:
    # label="Most costly departure slots"
    most_costly_slots is {
      group_by:
        # label="Rank"
        slot_rank
        # label="Airline"
        airline
        # label="Airport"
        origin
        # label="Departs"
        hour_label
      aggregate:
        # label="Late first flights"
        late_first_legs
        # label="Delay minutes on later flights" number="#,##0"
        downstream_late_aircraft_minutes
        # label="Cost, conservative" currency
        conservative_cost_usd
        # label="Cost, upper bound" currency
        downstream_cost_usd
      order_by: slot_rank
      limit: 25
    }
    # label="Cost by airport where the chain started"
    cost_by_airport is {
      group_by:
        # label="Airport"
        origin
      aggregate:
        # label="Cost" currency
        downstream_cost_usd
        # label="Late first flights"
        late_first_legs
      order_by: downstream_cost_usd desc
      limit: 12
    }
}

#" Map: delay-chain cost by the airport where the chain started, with the airport's position (OurAirports).
query: chain_cost_map is chain_slots_summary -> {
  where:
    airline ~ $AIRLINE,
    origin ~ $ORIGIN
  group_by:
    origin
    origin_city is airport.origin_city
    size_band
    latitude is airport.latitude
    longitude is airport.longitude
  aggregate: downstream_cost_usd, late_first_legs
  order_by: downstream_cost_usd desc
}

#" Chart: delay-chain cost by the scheduled departure hour of the late first flight.
query: chain_cost_by_hour is chain_slots_summary -> {
  where:
    airline ~ $AIRLINE,
    origin ~ $ORIGIN
  group_by: dep_hour, hour_label
  aggregate: downstream_cost_usd, late_first_legs
  order_by: dep_hour
}
