##! experimental.givens
import "../flights.malloy"
import "../summaries.malloy"

#" The headline answers for travellers: which airlines arrive late least often, and, for one departure airport
#" (default RDU) and optionally one airline, which scheduled departure hours and days of the week arrive late least
#" often. Every scheduled US domestic flight May-July 2026 (BTS Reporting Carrier On-Time Performance, 1,851,282
#" flights). "Late" = arrived 15+ minutes after schedule (BTS/DOT definition), of flights that operated; cancelled and
#" diverted flights are left out of the late rate and shown as their own rate. Hours and days with fewer than 100
#" operated flights in the selection are hidden. BTS records no booking dates, so this is the best time to FLY
#" (scheduled departure), not the best time to buy a ticket. Associations only: not adjusted for weather or season.
# artifact { title="Best time to fly: late arrivals by hour, day and airline" givens { ORIGIN="RDU" } } dashboard { columns=6 }
query: best_time_to_fly is delays_summary -> {
  # colspan=1
  aggregate:
    # label="Flights in the selection"
    sel_flights is flight_count { where: origin ~ $ORIGIN and airline ~ $AIRLINE }
    # label="Arrived 15+ min late (selection)" percent
    sel_late_rate is late_rate { where: origin ~ $ORIGIN and airline ~ $AIRLINE }
    # label="Cancelled (selection)" percent
    sel_cancel_rate is cancel_rate { where: origin ~ $ORIGIN and airline ~ $AIRLINE }
    # label="Arrived 15+ min late (all US flights)" percent
    national_late_rate is late_rate
  # colspan=3
  nest:
    #" Selected airport (and airline): late rate by scheduled departure hour, hours with 100+ operated flights.
    sel_by_hour is {
      where: origin ~ $ORIGIN, airline ~ $AIRLINE
      group_by: dep_hour
      aggregate:
        flight_count
        operated is n_operated.sum()
        late_flights is n_late.sum()
        late_rate
        cancel_rate
      having: n_operated.sum() >= 100
      order_by: dep_hour
    }
    #" All US flights: late rate by scheduled departure hour, hours with 100+ operated flights.
    national_by_hour is {
      group_by: dep_hour
      aggregate:
        flight_count
        operated is n_operated.sum()
        late_flights is n_late.sum()
        late_rate
      having: n_operated.sum() >= 100
      order_by: dep_hour
    }
}

#" Day of week: late rate for the selected airport (and airline) and for all US flights, days with 100+ operated
#" flights. Each weekday occurs 13 times in May-July 2026, Friday 14 times (1 May and 31 July are Fridays); rates are
#" not affected, counts are. Holiday weeks (Memorial Day, 4 July) fall in the period and are not removed.
query: best_time_to_fly_days is daily_summary -> {
  nest:
    sel_by_day is {
      where: origin ~ $ORIGIN, airline ~ $AIRLINE
      group_by: weekday, weekday_number
      aggregate:
        flight_count
        operated is n_operated.sum()
        late_flights is n_late.sum()
        late_rate
      having: n_operated.sum() >= 100
      order_by: weekday_number
    }
    national_by_day is {
      group_by: weekday, weekday_number
      aggregate:
        flight_count
        operated is n_operated.sum()
        late_flights is n_late.sum()
        late_rate
      order_by: weekday_number
    }
}

#" Airlines ranked by on-time arrival (fewest late arrivals first), all US flights May-July 2026, airlines with
#" 1,000+ scheduled flights (Spirit reported only 354 and is left out). The rank comes first. Regional carriers
#" (Envoy, Republic, SkyWest, PSA, Endeavor) are ranked under their own names, not the mainline brand they fly for.
query: best_time_to_fly_airlines is delays_summary -> {
  group_by: airline
  aggregate: flight_count, late_rate, cancel_rate
  having: flight_count >= 1000
} -> {
  group_by: airline, flight_count, late_rate, cancel_rate
  calculate: ranking is rank()
  order_by: late_rate
} -> {
  select:
    ranking
    airline
    flight_count
    # percent
    on_time_rate is 1 - late_rate
    # percent
    late_rate
    # percent
    cancel_rate
  order_by: ranking
}

#" Airlines at the selected airport ranked by on-time arrival, airlines with 100+ scheduled flights there.
query: best_time_to_fly_airport_airlines is delays_summary -> {
  where: origin ~ $ORIGIN
  group_by: airline
  aggregate: flight_count, late_rate, cancel_rate
  having: flight_count >= 100
} -> {
  group_by: airline, flight_count, late_rate, cancel_rate
  calculate: ranking is rank()
  order_by: late_rate
} -> {
  select:
    ranking
    airline
    flight_count
    # percent
    on_time_rate is 1 - late_rate
    # percent
    late_rate
    # percent
    cancel_rate
  order_by: ranking
}

#" Heatmap: late rate by airline and scheduled departure hour at the selected airport (all US when no airport is
#" chosen); cells with fewer than 100 operated flights are left out.
query: best_time_to_fly_heatmap is delays_summary -> {
  where: origin ~ $ORIGIN
  group_by: airline, dep_hour
  aggregate:
    operated is n_operated.sum()
    late_rate
  having: n_operated.sum() >= 100
  order_by: airline, dep_hour
}
