// v0 model of the TPC-H tables in MotherDuck ltools.tpch (scale factor 1, generated by DuckDB's tpch extension).
// Kept simple on purpose: sources, joins, a few obvious measures. Data is never committed (TPC EULA).

#" The 5 world regions.
source: region is motherduck.table('tpch.region') extend {
  primary_key: r_regionkey
  measure:
    #" Number of regions.
    region_count is count()
}

#" The 25 nations, each in one region.
source: nation is motherduck.table('tpch.nation') extend {
  primary_key: n_nationkey
  join_one: region on n_regionkey = region.r_regionkey
  measure:
    #" Number of nations.
    nation_count is count()
}

#" Suppliers, with their nation and account balance.
source: supplier is motherduck.table('tpch.supplier') extend {
  primary_key: s_suppkey
  join_one: nation on s_nationkey = nation.n_nationkey
  measure:
    #" Number of suppliers.
    supplier_count is count()
    #" Total supplier account balance.
    total_supplier_balance is s_acctbal.sum()
}

#" Customers, with their nation, market segment and account balance.
source: customer is motherduck.table('tpch.customer') extend {
  primary_key: c_custkey
  join_one: nation on c_nationkey = nation.n_nationkey
  measure:
    #" Number of customers.
    customer_count is count()
    #" Total customer account balance.
    total_customer_balance is c_acctbal.sum()
    #" Average customer account balance.
    avg_customer_balance is c_acctbal.avg()
}

#" Parts: name, brand, type, size, container and retail price.
source: part is motherduck.table('tpch.part') extend {
  primary_key: p_partkey
  measure:
    #" Number of parts.
    part_count is count()
    #" Average retail price.
    avg_retail_price is p_retailprice.avg()
}

#" Which supplier offers which part, with stock on hand and supply cost.
source: partsupp is motherduck.table('tpch.partsupp') extend {
  join_one: part on ps_partkey = part.p_partkey
  join_one: supplier on ps_suppkey = supplier.s_suppkey
  measure:
    #" Number of part-supplier offers.
    offer_count is count()
    #" Total units available.
    total_available_qty is ps_availqty.sum()
    #" Total value of stock on hand (supply cost times available quantity).
    total_stock_value is sum(ps_supplycost * ps_availqty)
    #" Average supply cost.
    avg_supply_cost is ps_supplycost.avg()
}

#" Orders: one row per order, with its customer, status, date, priority and total price.
source: orders is motherduck.table('tpch.orders') extend {
  primary_key: o_orderkey
  join_one: customer on o_custkey = customer.c_custkey
  measure:
    #" Number of orders.
    order_count is count()
    #" Total of the order total price column.
    total_order_price is o_totalprice.sum()
    #" Average order total price.
    avg_order_price is o_totalprice.avg()
}

#" Line items: one row per item on an order, with part, supplier, quantity, price, discount, tax and ship dates.
source: lineitem is motherduck.table('tpch.lineitem') extend {
  join_one: orders on l_orderkey = orders.o_orderkey
  join_one: part on l_partkey = part.p_partkey
  join_one: supplier on l_suppkey = supplier.s_suppkey
  join_one: partsupp on l_partkey = partsupp.ps_partkey and l_suppkey = partsupp.ps_suppkey
  dimension:
    #" Revenue of the line after discount: extended price times (1 - discount).
    net_price is l_extendedprice * (1 - l_discount)
  measure:
    #" Number of line items.
    line_count is count()
    #" Total quantity ordered.
    total_quantity is l_quantity.sum()
    #" Total extended price (before discount).
    total_extended_price is l_extendedprice.sum()
    #" Total revenue after discount.
    total_revenue is net_price.sum()
    #" Average discount.
    avg_discount is l_discount.avg()
}
