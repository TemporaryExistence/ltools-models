##! experimental.access_modifiers

// Loaded by load_hospital_readmissions.sql into MotherDuck ltools.hospital_readmissions:
//   measure_results (18,330 rows = 3,055 hospitals x 6 measures), hospitals (3,055 rows; 2,937 with a payment result),
//   payment_hospitals / payment_measures (FY 2025, 2026, 2027 payment files), payment_file_pairs, hospital_info (Care
//   Compare Hospital General Information), spread_prior, null_selection. Sources of each file: header of the load SQL.

#" One row per hospital in CMS's Hospital General Information file (Care Compare, July 2026): type, ownership, city, county, star rating.
#(agent) Ownership and type describe the hospital today, not during the readmission periods; compare groups with `measure_results -> by_ownership` (actual against expected with hidden counts bounded), never with published rows only, which drops small hospitals.
source: hospital_info is motherduck.table('hospital_readmissions.hospital_info') extend {
  primary_key: facility_id
}
// Cost constant: $18,100 per readmission (AHRQ HCUP Statistical Brief #307, Medicare, 2020 dollars): the cost of the
// hospital care a readmission uses, not what a hospital saves by avoiding one (Medicare pays a readmission as its own
// stay: Medicare Claims Processing Manual, Pub. 100-04, ch. 3, sec. 40.2.5). Used in excess_cost_per_year and beyond_chance_cost_per_year_low/_high; sources in units/ltools/outputs/ltp-part2/readmissions/research.md.

#" One row per hospital per FY 2026 payment result: CMS payment cut, dual-eligible share and peer group.
#(agent) FY 2026 cuts were applied to discharges from October 2025 to September 2026 and are finished. FY 2027 cuts are in effect since 2026-10-01 on a different basis (two years, July 2023 to June 2025, Medicare Advantage patients added); FY 2027 payment results are in `payment_hospitals` and `payment_measures` (no FY 2027 readmission counts are published yet).
#(agent) Maryland hospitals (43) and closed hospitals are not in the payment program: `in_payment_file` is false and the payment fields are null. Count penalized hospitals with `penalized_hospitals`, never as hospitals with an excess readmission ratio above 1.
#(agent) `payment_reduction_pct` is a percent of the hospital's Medicare fee-for-service base operating DRG payments for every stay in FY 2026, not only readmission stays. CMS publishes no dollar penalty per hospital or in total for FY 2026; for dollars use the estimate in `payment_hospitals` (`penalty_dollars_est`, rebuilt from the FY 2026 IPPS Impact File) and say it is an estimate. This source holds hospitals with a row in the hospital file (2,302 penalized); for CMS's published counts and denominators use `payment_hospitals -> program_counts`.
source: hospitals is motherduck.table('hospital_readmissions.hospitals') extend {
  primary_key: facility_id
  join_one: info is hospital_info on facility_id = info.facility_id

  dimension:
    #" Peer group in words: quintile of the share of stays by patients with both Medicare and full Medicaid.
    peer_group_label is peer_group ?
      pick '1: lowest dual share' when 1
      pick '2' when 2
      pick '3' when 3
      pick '4' when 4
      pick '5: highest dual share' when 5
      else 'not in payment program'
    #" Payment cut band.
    reduction_band is
      pick 'not in payment program' when payment_reduction_pct is null
      pick '0: no cut' when payment_reduction_pct = 0
      pick '1: under 0.25%' when payment_reduction_pct < 0.25
      pick '2: 0.25-0.99%' when payment_reduction_pct < 1
      pick '3: 1-2.99%' when payment_reduction_pct < 3
      else '4: 3% cap'

  measure:
    #" Hospitals.
    hospital_count is count()
    #" Hospitals in the FY 2026 payment program (have a payment adjustment factor).
    hospitals_in_program is count() { where: in_payment_file }
    #" Hospitals with a payment cut above zero.
    penalized_hospitals is count() { where: payment_reduction_pct > 0 }
    #" Hospitals at the 3% maximum cut.
    hospitals_at_cap is count() { where: payment_reduction_pct >= 3 }
    #" Hospitals with a cut of 1% or more.
    hospitals_cut_1pct_plus is count() { where: payment_reduction_pct >= 1 }
    #" Average payment cut, percent, over hospitals in the program (unweighted by size).
    avg_payment_reduction_pct is payment_reduction_pct.avg()
    #" Average payment cut, percent, over penalized hospitals only (unweighted by size).
    avg_reduction_if_penalized_pct is payment_reduction_pct.avg() { where: payment_reduction_pct > 0 }
    #" Share of program hospitals with a cut.
    # percent
    penalized_share is penalized_hospitals / nullif(hospitals_in_program, 0)

  #" Penalty counts by peer group (dual-eligible quintile).
  view: by_peer_group is {
    where: in_payment_file
    group_by: peer_group_label
    aggregate: hospitals_in_program, penalized_hospitals, penalized_share, avg_payment_reduction_pct, hospitals_cut_1pct_plus, hospitals_at_cap
    order_by: peer_group_label
  }
}

#" One row per hospital per measure per fiscal year (2025, 2026, 2027) from CMS's payment files: the inputs of the cut formula and each measure's share of the cut.
#(agent) CMS's cut = min(3%, neutrality modifier x sum over measures with the penalty flag of DRG payment ratio x (ERR - peer median ERR)) (42 CFR 412.154; CMS HRRP methodology slides). `cut_points` is one measure's part, in percentage points of the hospital's Medicare base operating DRG payments. Attribute a cut with `cut_points`, never by readmission count or ERR gap: a measure's weight is its DRG payment ratio.
#(agent) FY 2025 counts discharges July 2020 to June 2023, FY 2026 July 2021 to June 2024 (both fee-for-service, three years); FY 2027 counts July 2023 to June 2025 and adds Medicare Advantage stays, with a refitted risk model and new medians: the years are not like for like, and consecutive files share discharges (FY 2025 and FY 2026 two years, FY 2026 and FY 2027 one, FY 2025 and FY 2027 none), so year-to-year agreement is inflated; use `payment_file_pairs`.
source: payment_measures is motherduck.table('hospital_readmissions.payment_measures') extend {
  dimension:
    #" Measure in words.
    condition is measure ?
      pick 'Heart attack (AMI)' when 'AMI'
      pick 'Heart failure' when 'HF'
      pick 'Pneumonia' when 'PN'
      pick 'COPD' when 'COPD'
      pick 'Bypass surgery (CABG)' when 'CABG'
      pick 'Hip/knee replacement' when 'HIP-KNEE'
      else measure
    #" True when CMS scored the measure that year (25 or more eligible discharges and an ERR).
    scored is eligible_discharges >= 25 and excess_readmission_ratio is not null
    // neutrality modifier x DRG payment ratio x (ERR - peer median) on measures with the penalty flag, else 0.
    // (before the 3% cap).
    #" This measure's part of the cut, percentage points of base operating DRG payments.
    cut_points_row is pick 100 * neutrality_modifier * drg_payment_ratio * (excess_readmission_ratio - peer_group_median_err) when penalty_indicator else 0
    // (discharges x (ERR - peer median)); blank when not scored.
    #" Scored measure's gap to its peer median weighted by eligible discharges.
    #(agent) Summed over a state it is the numerator of `payment_hospitals -> state_vs_peer_median`; its chance test must treat the hospital as the unit, because a hospital's measures move together.
    gap_weighted_row is pick eligible_discharges * (excess_readmission_ratio - peer_group_median_err) when scored else null
  measure:
    // Per hospital and year: the cut is least(3, this).
    #" Sum of measures' parts of the cut, percentage points, before the 3% cap.
    cut_points is cut_points_row.sum()
    #" Measures with the penalty flag.
    penalized_measures is count() { where: penalty_indicator }
    #" Measures CMS scored.
    scored_measures_count is count() { where: scored }
    #" Discharge-weighted gap to the peer median, summed over scored measures.
    gap_weighted is gap_weighted_row.sum()
    #" Eligible discharges on scored measures.
    scored_discharges is eligible_discharges.sum() { where: scored }
    // (the hospital's cut x estimated base payments, split by each measure's part; a capped hospital's 3% split in
    // proportion), US dollars a year. Blank for FY 2025 and FY 2027 rows: only the FY 2026 Impact File is loaded, so
    // those years have no base.
    #" Estimated FY 2026 penalty dollars from these measures.
    #(agent) An estimate: CMS publishes no base payment per hospital, so the base is rebuilt from the FY 2026 IPPS Impact File (cases x case mix x national rate at the wage index); the national total is about $336M, with other reasonable bases $315M to $345M. Blank, not 0, outside FY 2026.
    # currency
    penalty_dollars_est is pick penalty_dollars_part_est.sum() when count() { where: fiscal_year = 2026 } > 0 else null

  #" Hospital-measures CMS newly scored in FY 2027 (under 25 eligible discharges or absent in FY 2026, 25 or more in FY 2027), how many sit above the FY 2027 peer median, and how many stopped counting.
  #(agent) FY 2027 eligible discharges are about 1.5 times FY 2026's because Medicare Advantage stays were added, so a hospital's measure list can change without any change in care: check which measures count before budgeting.
  view: measures_newly_scored_fy2027 is {
    group_by: facility_id, measure
    aggregate:
      scored_2026 is count() { where: fiscal_year = 2026 and scored }
      scored_2027 is count() { where: fiscal_year = 2027 and scored }
      in_file_2027 is count() { where: fiscal_year = 2027 }
      above_median_2027 is count() { where: fiscal_year = 2027 and scored and excess_readmission_ratio > peer_group_median_err }
  } -> {
    aggregate:
      newly_scored is count() { where: scored_2027 > 0 and scored_2026 = 0 }
      newly_scored_above_median is count() { where: scored_2027 > 0 and scored_2026 = 0 and above_median_2027 > 0 }
      stopped_counting is count() { where: scored_2026 > 0 and scored_2027 = 0 and in_file_2027 > 0 }
  }
}

#" One row per hospital per fiscal year in CMS's payment files (2025: 2,980; 2026: 2,945; 2027: 2,912): its cut, peer group, the cut rebuilt from the formula, and for FY 2026 estimated penalty dollars.
#(agent) Use this source for counts of program, eligible and penalized hospitals: they equal CMS's published figures (`program_counts`). It includes the hospitals with no row in the hospital file (FY 2026: 8, 2 penalized; their state comes from the CCN prefix and their name is blank), so its FY 2026 penalized count is 2,304 where `measure_results` and `penalty_basis` give 2,302. The share penalized depends on the denominator: `penalized_share_of_eligible` (hospitals with a measure of 25+ discharges, CMS's final-rule basis, 82.4% in FY 2026) or `penalized_share_of_program` (78.2%, the share news reports quote).
#(agent) A hospital at the 3% cap gains nothing from one measure's improvement until its summed parts fall below 3 (`cut_drivers`: `cut_without_measure`). CMS publishes no dollar cut per hospital; the cut is a percent of the hospital's base operating DRG payments for every Medicare fee-for-service stay that year.
#(agent) Penalized in both years is what the any-one-measure rule gives often by chance: compare repeats at measure level with `measure_results -> repeat_fy2027`, which carries the chance baseline. Known limit: this model has no hospital-level chance baseline for `penalized_both_years`.
#(agent) Dollars: CMS publishes no base operating DRG payment per hospital. `base_payments_est_fy2026` rebuilds it from the FY 2026 IPPS final rule Impact File (transfer-adjusted cases x case mix x the Table 1A/1B national rate at the hospital's wage index; FY 2024 volumes; no add-ons, no reduced update, no hospital-specific rates), so every dollar field is an estimate: about $336M for FY 2026 (0.39% of about $87B), other reasonable bases $315M to $345M. Rank hospitals for dollars by `penalty_dollars_est`, not by cut percent: the percent list is topped by small surgical hospitals.
source: payment_hospitals is motherduck.table('hospital_readmissions.payment_hospitals') extend {
  primary_key: hospital_year_key
  join_many: measures is payment_measures on hospital_year_key = measures.hospital_year_key
  join_one: info is hospital_info on facility_id = info.facility_id

  dimension:
    // (FY 2026 rows only; blank for FY 2025 and FY 2027, whose Impact Files are not loaded).
    // cut / 100 x estimated base operating DRG payments. Blank outside FY 2026.
    #" Estimated FY 2026 penalty dollars for the hospital.
    #(agent) An estimate built from the Impact File, not a CMS figure; give it as about, with the national range $315M to $345M.
    penalty_dollars_est_row is payment_reduction_pct / 100 * base_payments_est_fy2026
    // 0 below the cap; blank where there is no base (FY 2025 and FY 2027 rows, whose Impact Files are not loaded).
    // Blank outside FY 2026.
    #" Estimated FY 2026 dollars the 3% cap forgives: (summed parts - 3) / 100 x estimated base.
    #(agent) At the cap the file shows 3.00% and hides the uncapped sum (`cut_points_uncapped`); the first avoided readmissions there buy nothing until the sum falls below 3.
    forgiven_by_cap_est_row is
      pick (cut_points_uncapped - 3) / 100 * base_payments_est_fy2026 when cut_points_uncapped > 3 and base_payments_est_fy2026 is not null
      pick 0 when base_payments_est_fy2026 is not null
      else null
    #" True when CMS could cut the hospital: at least one measure with 25 or more eligible discharges.
    eligible is scored_measures > 0
    #" Peer group in words: quintile of the share of stays by patients with both Medicare and full Medicaid.
    peer_group_label is peer_group ?
      pick '1: lowest dual share' when 1
      pick '2' when 2
      pick '3' when 3
      pick '4' when 4
      pick '5: highest dual share' when 5
      else null

  measure:
    #" Hospitals in CMS's payment file.
    hospitals_in_program is count()
    #" Hospitals CMS could cut (a measure with 25 or more eligible discharges).
    eligible_hospitals is count() { where: eligible }
    #" Hospitals with a cut above zero.
    penalized_hospitals is count() { where: payment_reduction_pct > 0 }
    #" Hospitals at the 3% maximum.
    hospitals_at_cap is count() { where: payment_reduction_pct >= 3 }
    #" Penalized share of eligible hospitals (CMS's final-rule basis).
    # percent
    penalized_share_of_eligible is penalized_hospitals / nullif(eligible_hospitals, 0)
    #" Penalized share of all program hospitals.
    # percent
    penalized_share_of_program is penalized_hospitals / nullif(hospitals_in_program, 0)
    #" Average cut over penalized hospitals, percent (unweighted by size).
    avg_reduction_if_penalized_pct is payment_reduction_pct.avg() { where: payment_reduction_pct > 0 }
    #" Average cut over all program hospitals, percent (unweighted).
    avg_payment_reduction_pct is payment_reduction_pct.avg()
    // read it per hospital and fiscal year.
    #" Cut rebuilt from the formula, least(3, summed parts of the penalized measures), percent.
    cut_rebuilt_pct is least(3, measures.cut_points)
    // the dollar measures are blank where this is 0.
    #" Hospital-years with an estimated base payment (FY 2026 rows with an Impact File row).
    dollar_rows is count() { where: base_payments_est_fy2026 is not null }
    // Blank for FY 2025 and FY 2027: only the FY 2026 Impact File is loaded.
    #" Estimated FY 2026 penalty dollars a year (cut x estimated base).
    #(agent) An estimate (Impact File base, about $336M nationally, range $315M to $345M), never a CMS figure, and not the hospital's loss on readmissions alone: the cut applies to every Medicare fee-for-service stay. Blank, not $0, outside FY 2026.
    # currency
    penalty_dollars_est is pick penalty_dollars_est_row.sum() when dollar_rows > 0 else null
    #" Estimated FY 2026 base operating DRG payments (Impact File rebuild). Blank for FY 2025 and FY 2027.
    # currency
    base_payments_est is pick base_payments_est_fy2026.sum() when dollar_rows > 0 else null
    #" Cut weighted by estimated base payments, percent (FY 2026).
    #(agent) The unweighted average cut (about 0.34%) counts a 20-bed hospital like a 1,000-bed one; the payment-weighted cut (about 0.39%) is the share of base payments withheld.
    # percent
    payment_weighted_cut is penalty_dollars_est / nullif(base_payments_est, 0)
    // Blank for FY 2025 and FY 2027 (no base loaded for those years).
    #" Estimated FY 2026 dollars forgiven by the 3% cap.
    # currency
    forgiven_by_cap_est is pick forgiven_by_cap_est_row.sum() when dollar_rows > 0 else null
    #" Hospitals whose summed parts exceed the 3% cap.
    hospitals_above_cap is count() { where: cut_points_uncapped > 3 }
    // (sum of discharges x (ERR - peer median) / sum of discharges).
    #" Discharge-weighted gap to the peer median over scored measures.
    gap_to_peer_median is measures.gap_weighted / nullif(measures.scored_discharges, 0)

  #" CMS's counts by fiscal year: program, eligible and penalized hospitals, shares on both denominators, hospitals at the cap and the average cut.
  view: program_counts is {
    group_by: fiscal_year
    aggregate: hospitals_in_program, eligible_hospitals, penalized_hospitals, penalized_share_of_eligible, penalized_share_of_program, hospitals_at_cap, avg_reduction_if_penalized_pct
    order_by: fiscal_year
  }

  #" The same counts by state and fiscal year.
  view: program_counts_by_state is {
    group_by: state, fiscal_year
    aggregate: hospitals_in_program, eligible_hospitals, penalized_hospitals, penalized_share_of_eligible, hospitals_at_cap, avg_reduction_if_penalized_pct
    order_by: state, fiscal_year
  }

  #" Penalty counts by peer group (dual-eligible quintile) and fiscal year.
  view: by_peer_group is {
    group_by: fiscal_year, peer_group_label
    aggregate: hospitals_in_program, eligible_hospitals, penalized_hospitals, penalized_share_of_eligible, avg_payment_reduction_pct, hospitals_at_cap
    order_by: fiscal_year, peer_group_label
  }

  #" Which measures make each hospital's cut: each penalized measure's part in points and share, and the cut if that measure were at its peer median. Filter by facility_id or state and fiscal_year.
  view: cut_drivers is {
    where: payment_reduction_pct > 0
    group_by: fiscal_year, facility_id, facility_name, state, payment_reduction_pct
    aggregate: cut_rebuilt_pct
    nest: by_measure is {
      where: measures.penalty_indicator
      group_by: measures.condition, measures.eligible_discharges, measures.excess_readmission_ratio, measures.peer_group_median_err, measures.drg_payment_ratio
      aggregate:
        measures.cut_points
        # percent
        share_of_summed_parts is measures.cut_points / nullif(all(measures.cut_points), 0)
        cut_without_measure is least(3, all(measures.cut_points) - measures.cut_points)
      order_by: cut_points desc
    }
    order_by: payment_reduction_pct desc
  }

  #" Check of the formula: per fiscal year, hospitals whose rebuilt cut is within 0.01 points of CMS's, and the largest gap.
  view: cut_check is {
    group_by: fiscal_year, facility_id, payment_reduction_pct
    aggregate: cut_rebuilt_pct
  } -> {
    group_by: fiscal_year
    aggregate:
      hospitals is count()
      rebuilt_within_001 is count() { where: abs(cut_rebuilt_pct - payment_reduction_pct) <= 0.01 }
      largest_gap_points is max(abs(cut_rebuilt_pct - payment_reduction_pct))
    order_by: fiscal_year
  }

  #" Hospitals penalized in FY 2026, in FY 2027, and in both, by state (repeats are common by chance; see `measure_results -> repeat_fy2027`).
  view: penalized_both_years is {
    group_by: state, facility_id
    aggregate:
      cut_2026 is max(payment_reduction_pct) { where: fiscal_year = 2026 }
      cut_2027 is max(payment_reduction_pct) { where: fiscal_year = 2027 }
  } -> {
    group_by: state
    aggregate:
      penalized_2026 is count() { where: cut_2026 > 0 }
      penalized_2027 is count() { where: cut_2027 > 0 }
      penalized_both is count() { where: cut_2026 > 0 and cut_2027 > 0 }
    order_by: state
  }

  #" FY 2026 penalized hospitals in tenths by estimated penalty dollars (1 = largest): hospitals, dollars and each tenth's share of the national total.
  #(agent) Half the dollars sit on the top tenth; a list ranked by cut percent names small surgical hospitals that carry little money, so argue burden from this view, not from the percent list; read it unfiltered, since a filter on the tenth turns every share into 100%.
  view: penalty_dollar_concentration is {
    where: fiscal_year = 2026 and penalty_dollar_tenth is not null
    group_by: penalty_dollar_tenth
    aggregate:
      penalized_hospitals
      penalty_dollars_est
      # percent
      share_of_dollars is penalty_dollars_est / all(penalty_dollars_est)
    order_by: penalty_dollar_tenth
  }

  #" FY 2026 hospitals with the largest estimated penalty dollars: cut, estimated base and dollars.
  #(agent) Dollars are an estimate from the Impact File; the order differs from the cut-percent order because base payments differ about a hundredfold between hospitals. For a shorter list repeat the order (`+ { order_by: penalty_dollars_est desc; limit: 5 }`): in Malloyyo 0.2.72 a limit-only refinement drops a view's order and sorts by the first aggregate.
  view: top_penalty_dollars is {
    where: fiscal_year = 2026 and payment_reduction_pct > 0 and base_payments_est_fy2026 is not null
    group_by: facility_id, facility_name, state, payment_reduction_pct
    aggregate: penalty_dollars_est, base_payments_est
    order_by: penalty_dollars_est desc
    limit: 25
  }

  #" Hospitals at the 3% cap by fiscal year: the uncapped sum of parts and, for FY 2026, the estimated dollars the cap forgives (blank for FY 2025 and FY 2027, whose Impact Files are not loaded).
  #(agent) The file shows 3.00% at the cap; the uncapped sum (up to about 12% in FY 2026, 22% in FY 2025, 7% in FY 2027) says how many avoided readmissions buy nothing before the cut moves, so value early improvement at a capped hospital at zero.
  #(agent) For a shorter list repeat the order (`+ { order_by: fiscal_year, cut_points_uncapped desc; limit: 5 }`): in Malloyyo 0.2.72 a limit-only refinement drops a view's order and sorts by the first aggregate.
  view: capped_hospitals is {
    where: payment_reduction_pct >= 3
    group_by: fiscal_year, facility_id, facility_name, state, cut_points_uncapped
    aggregate: forgiven_by_cap_est
    order_by: fiscal_year, cut_points_uncapped desc
  }

  #" Hospitals by FY 2025 cut band, with the band's mean cut in FY 2025, FY 2026 and FY 2027, on hospitals present in all three files, so every column of a row covers the same hospitals (a hospital that left the program before FY 2027 is not counted: the 1.5%-or-more band holds 74 hospitals in FY 2025, 73 of them in all three files).
  #(agent) The top band's cut roughly halves two files later whatever the hospitals did (regression to the mean; FY 2025 and FY 2027 share no discharges) and the no-cut band rises, so credit a program with a fall in cuts only against similar hospitals that did not run it.
  view: cut_path_from_fy2025 is {
    group_by: facility_id
    aggregate:
      cut_2025 is max(payment_reduction_pct) { where: fiscal_year = 2025 }
      cut_2026 is max(payment_reduction_pct) { where: fiscal_year = 2026 }
      cut_2027 is max(payment_reduction_pct) { where: fiscal_year = 2027 }
  } -> {
    where: cut_2025 is not null and cut_2026 is not null and cut_2027 is not null
    group_by: fy2025_band is
      pick '1: no cut' when cut_2025 = 0
      pick '2: under 0.5%' when cut_2025 < 0.5
      pick '3: 0.5-0.99%' when cut_2025 < 1
      pick '4: 1-1.49%' when cut_2025 < 1.5
      else '5: 1.5% or more'
    aggregate:
      hospitals is count()
      mean_cut_fy2025 is cut_2025.avg()
      mean_cut_fy2026 is cut_2026.avg()
      mean_cut_fy2027 is cut_2027.avg()
      under_half_pct_fy2027 is count() { where: cut_2027 < 0.5 }
    order_by: fy2025_band
  }

  #" Hospitals with no scored measure in FY 2026 (or not in that file) and at least one in FY 2027: how many, how many were cut, their mean cut.
  #(agent) Medicare Advantage stays in FY 2027 lift small hospitals over the 25-discharge line, so a first-ever cut can come from the new counting rule, not from worse care.
  view: hospitals_newly_scored_fy2027 is {
    group_by: facility_id
    aggregate:
      scored_2026 is max(scored_measures) { where: fiscal_year = 2026 }
      scored_2027 is max(scored_measures) { where: fiscal_year = 2027 }
      cut_2027 is max(payment_reduction_pct) { where: fiscal_year = 2027 }
  } -> {
    where: scored_2027 > 0 and (scored_2026 = 0 or scored_2026 is null)
    aggregate:
      hospitals is count()
      cut_in_fy2027 is count() { where: cut_2027 > 0 }
      mean_cut_if_cut is cut_2027.avg() { where: cut_2027 > 0 }
  }

  #" Each state's discharge-weighted gap to the peer median per fiscal year, with a standard error that treats the hospital as the unit, and z = gap / SE.
  #(agent) A test on hospital-measure rows treats a hospital's measures as independent and overstates certainty (it would add New Jersey and Massachusetts as lasting high states); this test clusters by hospital. A lasting state gap can be patient mix or coding as well as care.
  view: state_vs_peer_median is {
    group_by: fiscal_year, state, facility_id
    aggregate: g is measures.gap_weighted, w is measures.scored_discharges
  } -> {
    where: w > 0
    group_by: state, fiscal_year
    aggregate:
      hospitals is count()
      gap_to_peer_median is g.sum() / w.sum()
      hospital_clustered_se is sqrt((sum(g * g) - 2 * (g.sum() / w.sum()) * sum(g * w) + (g.sum() / w.sum()) * (g.sum() / w.sum()) * sum(w * w)) * count() / nullif(count() - 1, 0)) / w.sum()
    order_by: state, fiscal_year
  }

  #" States against the peer median in FY 2025 and FY 2027, files that share no discharges: each year's gap and z (hospital-clustered), and whether the state sits beyond two SEs on the same side in both.
  #(agent) A state above in one file can be chance or the shared years; fund a statewide program where the state is above in both non-overlapping files, and not where it is below in both.
  view: state_persistence is {
    group_by: fiscal_year, state, facility_id
    aggregate: g is measures.gap_weighted, w is measures.scored_discharges
  } -> {
    where: w > 0 and (fiscal_year = 2025 or fiscal_year = 2027)
    group_by: state, fiscal_year
    aggregate:
      hospitals is count()
      gap is g.sum() / w.sum()
      se is sqrt((sum(g * g) - 2 * (g.sum() / w.sum()) * sum(g * w) + (g.sum() / w.sum()) * (g.sum() / w.sum()) * sum(w * w)) * count() / nullif(count() - 1, 0)) / w.sum()
  } -> {
    group_by: state
    aggregate:
      gap_fy2025 is max(gap) { where: fiscal_year = 2025 }
      z_fy2025 is max(gap / se) { where: fiscal_year = 2025 }
      gap_fy2027 is max(gap) { where: fiscal_year = 2027 }
      z_fy2027 is max(gap / se) { where: fiscal_year = 2027 }
      persistence is
        pick 'Above in both, beyond two SEs' when max(gap / se) { where: fiscal_year = 2025 } > 2 and max(gap / se) { where: fiscal_year = 2027 } > 2
        pick 'Below in both, beyond two SEs' when max(gap / se) { where: fiscal_year = 2025 } < -2 and max(gap / se) { where: fiscal_year = 2027 } < -2
        else 'Not beyond two SEs on one side in both'
    order_by: z_fy2027 desc
  }
}

// Slim join target for measure_results (pay2027, pay2026h): the payment_hospitals table's columns with no measures,
// views or long notes, so describe_source of measure_results does not repeat payment_hospitals' whole surface (cut
// 2026-10-23: that result reached 81,430 characters and overflowed Claude Code). For counts and dollars query
// payment_hospitals itself.
#" One row per hospital per fiscal year from CMS's payment files, columns only; for counts and dollars use payment_hospitals.
source: payment_hospital_row is motherduck.table('hospital_readmissions.payment_hospitals') extend {
  primary_key: hospital_year_key
}

#" One row per hospital per pair of payment files (FY 2025 and FY 2026, FY 2026 and FY 2027, FY 2025 and FY 2027) for hospitals in both: the two cuts, the discharge years the pair shares, and top-tenth flags.
#(agent) Consecutive files share discharge years (`shared_discharge_years`: FY 2025/2026 two, FY 2026/2027 one, FY 2025/2027 none), so their cuts agree partly because they count the same stays; judge whether penalties last from the pair that shares none.
source: payment_file_pairs is motherduck.table('hospital_readmissions.payment_file_pairs') extend {
  measure:
    #" Hospitals in both files of the pair.
    hospitals is count()
    #" Pearson correlation of the hospital's cut between the two files.
    #(agent) An adjacent-file correlation (0.77 for FY 2025/2026) reads as stable penalties but mostly reflects shared discharges; the pair sharing none correlates about 0.4.
    cut_correlation is (count() * sum(cut_a * cut_b) - cut_a.sum() * cut_b.sum()) / sqrt((count() * sum(cut_a * cut_a) - cut_a.sum() * cut_a.sum()) * (count() * sum(cut_b * cut_b) - cut_b.sum() * cut_b.sum()))
    #" Least-squares slope of the later cut on the earlier one (the later cut is about intercept + slope x the earlier cut).
    #(agent) Budget a hospital's next cut with this regression toward the average, not at this year's cut.
    next_cut_slope is (count() * sum(cut_a * cut_b) - cut_a.sum() * cut_b.sum()) / nullif(count() * sum(cut_a * cut_a) - cut_a.sum() * cut_a.sum(), 0)
    #" Intercept of that line, percent.
    next_cut_intercept is (cut_b.sum() - (count() * sum(cut_a * cut_b) - cut_a.sum() * cut_b.sum()) / nullif(count() * sum(cut_a * cut_a) - cut_a.sum() * cut_a.sum(), 0) * cut_a.sum()) / count()
    #" Hospitals in the top tenth of cuts in the earlier file.
    top_tenth_hospitals is count() { where: top_tenth_a }
    #" Their mean cut in the earlier file, percent.
    top_tenth_mean_cut_a is cut_a.avg() { where: top_tenth_a }
    #" Their mean cut in the later file, percent.
    #(agent) A top-tenth hospital keeps under half its distance from the average two files on; budget toward the average.
    top_tenth_mean_cut_b is cut_b.avg() { where: top_tenth_a }
    #" Of them, hospitals in the top tenth again in the later file.
    top_tenth_stayed is count() { where: top_tenth_a and top_tenth_b }
    #" Hospitals expected to stay in the top tenth if the two files were unrelated (top-tenth count x share in the later top tenth).
    top_tenth_stay_by_chance is count() { where: top_tenth_a } * count() { where: top_tenth_b } / count()

  #" Persistence of the cut for each pair of files: shared discharge years, correlation, regression line, and the top tenth followed into the later file against chance.
  #(agent) Read the FY 2025 to FY 2027 row (no shared discharges) for how much of a cut lasts; the adjacent rows are inflated by the shared years.
  view: cut_persistence is {
    group_by: file_pair, shared_discharge_years
    aggregate: hospitals, cut_correlation, next_cut_intercept, next_cut_slope, top_tenth_hospitals, top_tenth_mean_cut_a, top_tenth_mean_cut_b, top_tenth_stayed, top_tenth_stay_by_chance
    order_by: shared_discharge_years desc
  }
}

#" Prior for the per-hospital posterior: each measure's spread of true hospital ratios and the offset of their mean from expected (FY 2026 fit).
source: spread_prior is motherduck.table('hospital_readmissions.spread_prior') extend {
  primary_key: measure
}

#" One row per hospital per measure (AMI, HF, PN, COPD, CABG, HIP-KNEE): discharges, readmission rates, excess readmission ratio and penalty inputs, discharges July 2021 to June 2024.
// Full guidance before the 2026-10-23 cut (describe_source shows the shorter #(agent) lines below; the detail stays here):
// Counts cover three years of Medicare fee-for-service discharges. Use the `_per_year` measures for annual figures;
// never quote a three-year sum as a year.
// "Too Few to Report" means 10 or fewer readmissions (zero included: no published count is below 11), suppressed for
// privacy, and CMS also blanks the discharges on those rows; it is not zero. It hides 83% of hip/knee hospital rows
// and 47% of hip/knee discharges. Use `eligible_discharges` (from the CMS payment file, never suppressed), not
// `discharges_published`, and the predicted/expected measures, not `readmissions_published`.
// Chance: if every hospital sat exactly at its expected rate, the positive (actual - expected) sum would still be
// about 7,800 a year (`chance_excess_per_year`; 7,212 to 11,900 under the file's suppression rule,
// `chance_excess_per_year_min`/`_max`). Actual minus chance is a FLOOR on the true excess, not an estimate (with
// binomial noise, `beyond_chance_binomial_per_year_min`/`_max`, about 2,340 to 2,370 a year on all six conditions,
// 2,330 to 2,350 on the four below); the estimate of true excess is `true_excess_per_year` (heart failure, pneumonia,
// heart attack and COPD: about 5,340 a year, 4,380 to 6,390, pneumonia above heart failure; inferred from the spread
// and offset of hospital rates; view `true_excess_by_condition`). Hip/knee and CABG are not estimated: their CMS ratio
// changes with hospital size (hip/knee 0.78 at 500+ discharges, about 1.02 under 100), so no single centre holds. For
// low-volume, mostly suppressed conditions (hip/knee, CABG) the floor has almost no power: say the file cannot show
// excess, not that none exists. A hospital's gap above the peer median is inside chance until about two binomial SDs
// (`chance_sd_binomial`); because penalized measures were selected for coming out above the median, chance plus
// selection alone puts about 11.5% of hospitals beyond two (`null_selection`). Within the band means too small to tell
// from chance, not caused by chance: on the four conditions' spread about 71% to 77% of penalized hospitals with a
// penalized heart attack, heart failure, pneumonia or COPD measure (2,159 of 2,302) are probably truly above their
// peer median on those measures (`share_truly_above_median_*`), and about 41% to 50% of their measured gap is real
// (`real_share_of_gap_*`); hospitals penalized only on hip/knee or CABG are not estimated. Poisson SDs slightly
// overstate sampling noise for a yes/no outcome; patient mix the risk model misses would add noise; the net direction
// is not measured.
// Every count built from predicted rates (`excess_readmissions`, `readmissions_above_median`,
// `net_excess_readmissions`, `predicted_readmissions`) is CMS's shrunken risk-adjusted ESTIMATE, not readmissions that
// happened. Across hospitals with a published count, one actual readmission goes with about 0.18 of the estimate under
// 100 discharges, 0.31 at 100-249, 0.49 at 250-499 and 0.72 at 500+ (views `reliability_by_volume`,
// `reliability_table`; constants in `reliability_slope`). Always say "CMS's estimate". For actual readmissions use the
// `actual_*_min` / `actual_*_max` bounds (suppressed rows at 0 and at 10, no assumption) or `observed_*` (published
// rows only), and give the range; `actual_readmissions_to_avoid` shows per hospital and measure how many actual
// readmissions move the estimate by one. Slopes are FY 2026 three-year fee-for-service figures; the two-year, Medicare
// Advantage-inclusive periods from FY 2027 will differ.
// `discharges` are eligible stays per measure; one patient can appear in several measures, so a sum across measures
// counts stays, not people.
// `excess_readmission_ratio` (ERR) = predicted rate / expected rate. CMS shrinks small hospitals toward 1, so a small
// hospital's ERR near 1 means "not enough data", and an ERR of 1.12 on 176 hip/knee cases is 1.2 readmissions above
// the peer median on CMS's estimate and 2.5 on the actual count (Rex Hospital). Quote excess readmissions (a count),
// not ERR alone; average ERRs only through `weighted_err`.
// The penalty threshold is the peer group median ERR, not 1.0: in this model 340 rows are penalized with ERR at or
// below 1 and 125 rows in the payment program with ERR above 1 are not (CMS's supplemental file, with 8 more
// hospitals, gives 342 and 127). Use `penalty_indicator`; Maryland rows have no penalty flag (false here, outside the
// program), so filter `in_payment_file` before counting unpenalized rows. Summing excess over all hospitals nets to
// near zero by design; `excess_readmissions` counts only hospitals above expected.
// To shorten a view, filter it but do not add a bare `+ { limit: N }`: that refinement dropped the view's ordering in
// testing (malloyyo 0.2.72). Predicted rates differ by measure because the patients differ (hip/knee about 5%, heart
// failure about 20%); never rank measures by rate. Maryland is in this file but outside the payment program; its rows
// have an ERR but no `eligible_discharges`, so counts leave them out.
// Chance per hospital and group: `vs_expected_chance` and `vs_peer_median_chance` test a hospital-measure's actual
// count (bounds where hidden) against binomial noise at 95%; about 2.5% of rows land beyond chance on each side by
// luck, so in a long list some flags are luck. `group_vs_expected` does the same for any group (state, condition,
// hospital); it covers sampling noise only, not whether the group's care differs. To rank hospitals, use
// `hospital_measures_vs_chance` (ordered by the probability of being worse than expected), never raw rate or ERR: the
// top of those lists is small hospitals and luck.
// True excess for a subset: `posterior_excess_per_year_min`/`_max` sum, for each hospital-measure, the expected true
// excess given its own counts, shrunk toward the national spread (empirical Bayes, prior Normal(1 + spread_offset,
// spread_tau^2)); `_low`/`_high` add sampling uncertainty given that prior, not the prior's own. Use it for a state, a
// hospital or a condition. It covers heart failure, pneumonia, heart attack and COPD only: for hip/knee and CABG one
// prior centre does not hold across volume (`posterior_covered`), so say those are not estimated. For a small hospital
// the result is mostly the national prior, not its own counts. `true_excess_per_year` is the national pattern applied
// to a subset's patients, not a measurement of the subset. Nationally the posterior sum for the four (about 5,250 to
// 5,440 a year) brackets their `true_excess_per_year` (5,337).
// Valuing an avoided readmission, two parts never added: (1) the penalty: `cut_points_per_avoided` is the cut one
// avoided actual readmission removes in ONE payment year, on FY 2026's basis (points of base operating DRG payments;
// `penalty_dollars_per_avoided_per_100m` per $100 million of those payments), while the measure stays above its median
// and the hospital is under the cap. A discharge counts in every payment year whose period covers it (July 2023 to
// June 2024 discharges are in both FY 2026 and FY 2027; from FY 2027 each period is two years, so a discharge from
// July 2023 on counts in about two payment years), so the penalty value of one avoided readmission is the sum over
// those years, about two years' values; later years have other expected counts and slopes (two-year periods, Medicare
// Advantage added) and their per-year values are not in these files. FY 2026's own year is finished. (2) $18,100 of hospital care (AHRQ
// HCUP #307, 2020 dollars) is the cost of the hospital care a readmission uses, not the hospital's saving: Medicare
// pays a readmission as its own stay (Medicare Claims Processing Manual, Pub. 100-04, ch. 3, sec. 40.2.5: two separate
// payments unless one stay is denied; a same-day related readmission to the same hospital is combined into one claim).
// A hospital that avoids one gives up that stay's payment, so its own gain is the penalty change plus the cost avoided
// minus the payment forgone; the last two are not in these files. Compare conditions within a hospital by
// `cut_points_per_avoided` (Rex: hip/knee about 2.5 times pneumonia).
#(agent) Counts cover three years of Medicare fee-for-service discharges (July 2021 to June 2024): use the `_per_year` measures for annual figures. A sum across measures counts stays, not people.
#(agent) "Too Few to Report" means 10 or fewer readmissions (zero included), not zero; it hides 83% of hip/knee rows. Use `eligible_discharges` (never suppressed), not `discharges_published`; for actual counts use the `actual_*_min`/`_max` bounds (hidden counts at 0 and at 10) and give the range.
#(agent) Counts built from predicted rates (`excess_readmissions`, `readmissions_above_median`, `net_excess_readmissions`, `predicted_readmissions`) are CMS's shrunken ESTIMATE, not readmissions that happened: one actual readmission moves it about 0.18 under 100 discharges and 0.72 at 500+ (`reliability_table`). Say "CMS's estimate"; `actual_readmissions_to_avoid` converts per hospital and measure.
#(agent) ERR = predicted / expected, shrunk toward 1 at small hospitals: quote a count, not ERR alone, and average ERRs only through `weighted_err`. The penalty line is the peer-group median ERR, not 1.0 (340 rows penalized at ERR 1 or below, 125 unpenalized above 1): use `penalty_indicator`, and filter `in_payment_file` (Maryland is outside the program) before counting unpenalized rows. Net excess is near zero by design. Predicted rates differ by measure because the patients differ: never rank measures by rate.
#(agent) Chance: with every hospital at its expected rate, positive (actual - expected) would still sum to about 7,800 a year (`chance_excess_per_year`). Actual minus chance (`beyond_chance_binomial_per_year_min`/`_max`, about 2,340 to 2,370 a year) is a FLOOR on the true excess, not an estimate. The estimate is `true_excess_per_year` (heart attack, heart failure, pneumonia, COPD: about 5,340 a year, 4,380 to 6,390; view `true_excess_by_condition`; inferred from the spread of hospital rates). Hip/knee and CABG are not estimated (their ratio changes with hospital size; their spreads rest on 66 and 71 large hospitals): say the file cannot show their excess, not that none exists. Spreads include patient mix the risk model misses.
#(agent) Per hospital: a gap above the peer median is inside chance until about two binomial SDs, and chance plus selection alone puts about 11.5% of hospitals beyond two (`null_selection`). Within the band means too small to tell, not caused by chance: about 71% to 77% of penalized hospitals with a penalized heart attack, heart failure, pneumonia or COPD measure are probably truly above the median there, and 41% to 50% of their measured gap is real (`penalty_basis`). `vs_expected_chance`, `vs_peer_median_chance` and `group_vs_expected` test sampling noise only, and about 2.5% of rows land beyond chance on each side by luck. Rank hospitals with `hospital_measures_vs_chance`, never by raw rate or ERR.
#(agent) Subsets: `posterior_excess_per_year_min`/`_max` estimate true excess for a state, hospital or condition from its own counts, shrunk toward the national spread (four conditions only; for a small hospital mostly the prior). `true_excess_per_year` on a subset is the national pattern applied to its patients, not a measurement.
#(agent) Valuing an avoided readmission, two parts never added: (1) the penalty, `cut_points_per_avoided` (one payment year, FY 2026 basis; a discharge counts in about two payment years; nothing moves at the 3% cap); (2) $18,100 of hospital care used (AHRQ HCUP #307, 2020 dollars), which is not the hospital's saving, since Medicare pays a readmission as its own stay. Compare conditions within a hospital by `cut_points_per_avoided`.
#(agent) To shorten a view, filter it; a bare `+ { limit: N }` dropped the view's ordering in testing (malloyyo 0.2.72).
source: measure_results is motherduck.table('hospital_readmissions.measure_results') extend {
  join_one: hospital is hospitals on facility_id = hospital.facility_id
  join_one: pay is payment_measures on facility_id = pay.facility_id and measure = pay.measure and pay.fiscal_year = 2026
  join_one: fy2027 is payment_measures on facility_id = fy2027.facility_id and measure = fy2027.measure and fy2027.fiscal_year = 2027
  join_one: prior is spread_prior on measure = prior.measure
  join_one: pay2027 is payment_hospital_row on facility_id = pay2027.facility_id and pay2027.fiscal_year = 2027
  join_one: fy2025 is payment_measures on facility_id = fy2025.facility_id and measure = fy2025.measure and fy2025.fiscal_year = 2025
  join_one: pay2026h is payment_hospital_row on facility_id = pay2026h.facility_id and pay2026h.fiscal_year = 2026

  dimension:
    #" Measure in words.
    condition is measure ?
      pick 'Heart attack (AMI)' when 'AMI'
      pick 'Heart failure' when 'HF'
      pick 'Pneumonia' when 'PN'
      pick 'COPD' when 'COPD'
      pick 'Bypass surgery (CABG)' when 'CABG'
      pick 'Hip/knee replacement' when 'HIP-KNEE'
      else measure
    #" True when CMS computed an excess readmission ratio (25 or more eligible discharges).
    has_err is excess_readmission_ratio is not null
    #" Eligible discharge band for the measure (three years).
    volume_band is
      pick null when eligible_discharges is null
      pick '1: 1-24' when eligible_discharges < 25
      pick '2: 25-49' when eligible_discharges < 50
      pick '3: 50-99' when eligible_discharges < 100
      pick '4: 100-249' when eligible_discharges < 250
      pick '5: 250-499' when eligible_discharges < 500
      else '6: 500+'
    // (predicted - expected rate) / 100. Shrunken scale, not actual readmissions.
    // three years. Shrunken scale, not actual readmissions.
    #" CMS's estimate of readmissions above (positive) or below (negative) expected for this row.
    excess_readmissions_row is eligible_discharges * (predicted_rate_pct - expected_rate_pct) / 100
    // (ERR - peer median) / 100. Shrunken scale, not actual readmissions.
    // Shrunken scale, not actual readmissions.
    #" CMS's estimate of readmissions above the peer group median for this row, three years.
    readmissions_above_median_row is eligible_discharges * expected_rate_pct * (excess_readmission_ratio - peer_group_median_err) / 100
  internal dimension:
    // (10 or fewer; no published count is below 11 and none is 0, so zeros sit inside the suppression).
    // or 0 where CMS shows "Too Few to Report".
    #" Lowest possible actual readmissions for the row: the published count.
    readmissions_min is readmissions_published ?? (pick 0 when readmissions_status = 'Too Few to Report' else null)
    #" Highest possible actual readmissions for the row: the published count, or 10 where suppressed.
    readmissions_max is readmissions_published ?? (pick 10 when readmissions_status = 'Too Few to Report' else null)
  dimension:
    #" Actual readmissions minus expected, lower bound (suppressed rows at 0), three years.
    actual_excess_row_min is readmissions_min - eligible_discharges * expected_rate_pct / 100
    #" Actual readmissions minus expected, upper bound (suppressed rows at 10), three years.
    actual_excess_row_max is readmissions_max - eligible_discharges * expected_rate_pct / 100
  internal dimension:
    // three years.
    #" Actual readmissions minus a peer-median hospital's count, lower bound (suppressed rows at 0).
    actual_above_median_row_min is readmissions_min - eligible_discharges * expected_rate_pct * peer_group_median_err / 100
    // three years.
    #" Actual readmissions minus a peer-median hospital's count, upper bound (suppressed rows at 10).
    actual_above_median_row_max is readmissions_max - eligible_discharges * expected_rate_pct * peer_group_median_err / 100
    // Its square root is the Poisson standard deviation of that count (slightly above pure sampling noise for a yes/no
    // outcome; see `median_var_row`).
    // eligible discharges x expected rate x peer median / 100.
    #" Readmissions a peer-median hospital would have on this row, three years.
    median_count_row is eligible_discharges * expected_rate_pct * peer_group_median_err / 100
  dimension:
    // q = expected rate x peer median.
    #" Binomial variance of a peer-median hospital's count on this row: eligible discharges x q x (1 - q).
    median_var_row is eligible_discharges * (expected_rate_pct / 100 * peer_group_median_err) * (1 - expected_rate_pct / 100 * peer_group_median_err)
    // (eligible discharges x expected rate / 100).
    #" Expected readmissions at an average hospital for this row.
    expected_count_row is eligible_discharges * expected_rate_pct / 100
    // method-of-moments estimate with binomial noise on rows with an expected count of 25 or more (none suppressed),
    // FY 2026, from the load-time table `spread_prior`; `spread_tau_live` recomputes it. Hip/knee and CABG rest on 66
    // and 71 large hospitals and are weak: 73-75% of their expected readmissions sit at hospitals where no spread is
    // measured. Includes patient mix the risk model misses, which this file cannot separate from care.
    #" Spread of true hospital performance (relative SD of the hospital's rate around the measure's mean ratio, centred) for this measure.
    spread_tau is prior.spread_tau
    // (E^2-weighted, rows with expected count 25 or more; `spread_mean_offset` recomputes it). Weighted to large
    // hospitals; hip/knee's -0.29 and CABG's -0.08 reflect large centres and do not hold at small volume, so no
    // estimate in this model uses them (`posterior_covered`).
    #" Fitted mean offset of the true ratio from expected for this measure.
    spread_offset is prior.spread_offset
    // true ratio ~ Normal(1 + spread_offset, spread_tau^2) (queries/r4/vc2.py). Heart attack, heart failure, pneumonia
    // and COPD only; blank for hip/knee and CABG, not estimated because their CMS ratio changes with hospital size, so
    // one centre does not hold.
    #" Expected true excess above expected per expected readmission: tau x phi(mu/tau) + mu x Phi(mu/tau).
    true_excess_factor is measure ?
      pick 0.04115 when 'AMI'
      pick 0.04489 when 'COPD'
      pick 0.03453 when 'HF'
      pick 0.05075 when 'PN'
      else null
  internal dimension:
    #" Low end of `true_excess_factor`: 2.5th percentile over 1,000 bootstrap replicates resampling whole hospitals.
    true_excess_factor_low is measure ?
      pick 0.02832 when 'AMI'
      pick 0.03113 when 'COPD'
      pick 0.02727 when 'HF'
      pick 0.04035 when 'PN'
      else null
    #" High end of `true_excess_factor`: 97.5th percentile, same bootstrap.
    true_excess_factor_high is measure ?
      pick 0.05377 when 'AMI'
      pick 0.05661 when 'COPD'
      pick 0.04237 when 'HF'
      pick 0.06075 when 'PN'
      else null
    #" Binomial noise variance of the observed ratio O/E on this row: (1 - p) / E.
    ratio_noise_var_row is (1 - expected_rate_pct / 100) / nullif(expected_count_row, 0)
    #" Empirical-Bayes shrinkage weight on this row: tau^2 / (tau^2 + noise variance).
    eb_weight_row is spread_tau * spread_tau / (spread_tau * spread_tau + ratio_noise_var_row)
    // (1 + offset + weight x (min count / E - 1 - offset) - peer median). Heart attack, heart failure, pneumonia and
    // COPD only (`posterior_covered`); blank for hip/knee and CABG.
    // (suppressed counts at 0); four conditions only.
    #" Posterior (empirical-Bayes) gap above the peer-median count on this row, three years, lower bound.
    posterior_gap_row_min is pick expected_count_row * (1 + spread_offset + eb_weight_row * (readmissions_min / expected_count_row - 1 - spread_offset) - peer_group_median_err) when posterior_covered else null
    #" Same, upper bound (suppressed counts at 10).
    posterior_gap_row_max is pick expected_count_row * (1 + spread_offset + eb_weight_row * (readmissions_max / expected_count_row - 1 - spread_offset) - peer_group_median_err) when posterior_covered else null
    #" Posterior variance of that gap: E^2 x weight x noise variance (four conditions only, as the gap).
    posterior_var_row is pick expected_count_row * expected_count_row * eb_weight_row * ratio_noise_var_row when posterior_covered else null
  dimension:
    // (2,000 resamples of hospitals, queries/r4/vc.py).
    #" Low end of the 95% bootstrap interval for `spread_tau`.
    spread_tau_low is measure ?
      pick 0.0971 when 'AMI'
      pick 0.0899 when 'CABG'
      pick 0.0599 when 'COPD'
      pick 0.0862 when 'HF'
      pick 0.0863 when 'HIP-KNEE'
      pick 0.0933 when 'PN'
      else null
    #" High end of the 95% bootstrap interval for `spread_tau`.
    spread_tau_high is measure ?
      pick 0.1393 when 'AMI'
      pick 0.2347 when 'CABG'
      pick 0.0934 when 'COPD'
      pick 0.1025 when 'HF'
      pick 0.2179 when 'HIP-KNEE'
      pick 0.1145 when 'PN'
      else null
    #" Volume band used in the reliability table (eligible discharges, three years).
    reliability_band is
      pick null when eligible_discharges is null or eligible_discharges < 25
      pick '1: 25-99' when eligible_discharges < 100
      pick '2: 100-249' when eligible_discharges < 250
      pick '3: 250-499' when eligible_discharges < 500
      else '4: 500+'
    // (FY 2026 slope of the estimate on the actual excess across hospitals with a published count; view
    // `reliability_table` recomputes it). Cells under 20 published rows use the all-measure slope for the band
    // (hip/knee 25-99, CABG 500+, COPD 500+).
    #" How far CMS's estimate moves per actual readmission at this measure and volume.
    reliability_slope is
      pick 0.18 when reliability_band = '1: 25-99' and measure = 'HIP-KNEE'
      pick 0.16 when reliability_band = '1: 25-99' and measure = ('PN' | 'COPD')
      pick 0.17 when reliability_band = '1: 25-99' and measure = 'HF'
      pick 0.19 when reliability_band = '1: 25-99' and measure = 'AMI'
      pick 0.27 when reliability_band = '1: 25-99' and measure = 'CABG'
      pick 0.31 when reliability_band = '2: 100-249' and measure = 'AMI'
      pick 0.42 when reliability_band = '2: 100-249' and measure = 'CABG'
      pick 0.29 when reliability_band = '2: 100-249' and measure = 'COPD'
      pick 0.33 when reliability_band = '2: 100-249' and measure = 'HF'
      pick 0.47 when reliability_band = '2: 100-249' and measure = 'HIP-KNEE'
      pick 0.30 when reliability_band = '2: 100-249' and measure = 'PN'
      pick 0.47 when reliability_band = '3: 250-499' and measure = ('AMI' | 'PN')
      pick 0.60 when reliability_band = '3: 250-499' and measure = 'CABG'
      pick 0.45 when reliability_band = '3: 250-499' and measure = 'COPD'
      pick 0.50 when reliability_band = '3: 250-499' and measure = 'HF'
      pick 0.62 when reliability_band = '3: 250-499' and measure = 'HIP-KNEE'
      pick 0.63 when reliability_band = '4: 500+' and measure = 'AMI'
      pick 0.72 when reliability_band = '4: 500+' and measure = ('CABG' | 'COPD')
      pick 0.73 when reliability_band = '4: 500+' and measure = 'HF'
      pick 0.86 when reliability_band = '4: 500+' and measure = 'HIP-KNEE'
      pick 0.71 when reliability_band = '4: 500+' and measure = 'PN'
      else null
    // (1 / reliability_slope; an approximation from a cross-hospital slope, measured on FY 2026's three-year
    // fee-for-service cohort).
    #" Actual readmissions it takes to move CMS's estimate by one at this measure and volume.
    actual_per_estimated is 1 / reliability_slope
  internal dimension:
    // Null where the count is suppressed. Includes chance variation.
    // published readmissions - eligible discharges x expected rate / 100.
    #" Actual readmissions minus expected for this row, three years.
    observed_excess_row is readmissions_published - eligible_discharges * expected_rate_pct / 100
    // published readmissions - eligible discharges x expected rate x peer median / 100. Null where suppressed.
    #" Actual readmissions minus the count a peer-median hospital would have, three years.
    observed_above_median_row is readmissions_published - eligible_discharges * expected_rate_pct * peer_group_median_err / 100
    // (1 - p), p = expected rate.
    #" Binomial variance of the count at an average hospital on this row: eligible discharges x p x.
    expected_var_row is eligible_discharges * (expected_rate_pct / 100) * (1 - expected_rate_pct / 100)
  dimension:
    #" z of the actual count against expected, lower bound (hidden counts at 0).
    z_vs_expected_min is actual_excess_row_min / sqrt(expected_var_row)
    #" Same, upper bound (hidden counts at 10).
    z_vs_expected_max is actual_excess_row_max / sqrt(expected_var_row)
    #" z of the actual count against a peer-median hospital's count, lower bound (hidden counts at 0).
    z_vs_median_min is actual_above_median_row_min / sqrt(median_var_row)
    #" Same, upper bound (hidden counts at 10).
    z_vs_median_max is actual_above_median_row_max / sqrt(median_var_row)
    // a label only where both bounds of a hidden count agree.
    #" Actual readmissions against expected for these patients, at 95% (binomial).
    vs_expected_chance is
      pick null when expected_var_row is null or not has_err
      pick 'Above expected, beyond chance' when z_vs_expected_min >= 1.96
      pick 'Below expected, beyond chance' when z_vs_expected_max <= -1.96
      pick 'Within chance' when z_vs_expected_min > -1.96 and z_vs_expected_max < 1.96
      else 'Count hidden: cannot tell'
    // same rule.
    #" Actual readmissions against a peer-median hospital's count (the penalty line), at 95% (binomial).
    vs_peer_median_chance is
      pick null when median_var_row is null or not has_err
      pick 'Above peer median, beyond chance' when z_vs_median_min >= 1.96
      pick 'Below peer median, beyond chance' when z_vs_median_max <= -1.96
      pick 'Within chance' when z_vs_median_min > -1.96 and z_vs_median_max < 1.96
      else 'Count hidden: cannot tell'
    // (100+ discharges) each sits within 0.03 of its centre (pneumonia 0.99 at 100-249 to 1.02 at 500+), with no
    // contrary evidence; under 100 discharges CMS's ratio is near 1 partly by construction and the load SQL computes a
    // posterior (`posterior_ratio_min`/`_max`, `prob_worse_than_expected_min`/`_max`,
    // `posterior_excess_row_min`/`_max`, three years); hip/knee (0.78 at 500+ discharges, 1.03 under 50) and CABG get
    // none.
    // hip/knee and CABG get no posterior.
    #" True for heart attack, heart failure, pneumonia and COPD, where one prior centre holds.
    posterior_covered is measure = ('AMI' | 'HF' | 'PN' | 'COPD')
    // from `payment_measures`.
    #" FY 2026 cut points from this measure (neutrality modifier x DRG payment ratio x (ERR - peer median), penalized measures only).
    cut_points_row is pay.cut_points_row
  internal dimension:
    // (CMS's estimate above the median / reliability slope; approximation).
    #" Actual readmissions to avoid to bring CMS's ratio to the peer median on this measure.
    actual_to_clear_row is readmissions_above_median_row / reliability_slope
  dimension:
    // while it stays above its median and the hospital is under the cap: 100 x neutrality modifier x DRG payment ratio
    // x slope / expected count (inferred). A discharge counts in each payment year whose period covers it (FY 2026 and
    // FY 2027 share July 2023 to June 2024; periods are two years from FY 2027, so about two payment years per
    // discharge), so the full penalty value is the sum over those years; later years' values differ and are not in
    // these files. At most this measure's `cut_points`; zero at the 3% cap until the summed parts fall below 3.
    // Zero at the 3% cap; a discharge counts in about two payment years.
    #" Cut points one avoided actual readmission removes on this measure per payment year, FY 2026 basis.
    cut_points_per_avoided is 100 * pay.neutrality_modifier * drg_payment_ratio * reliability_slope / expected_count_row
    // (one point of the cut is $1 million of $100 million); add each payment year whose period covers the discharge,
    // about two payment years. A penalty change, not the hospital's net gain: Medicare also stops paying for the
    // avoided stay.
    #" The same in dollars per $100 million of the hospital's base operating DRG payments, per payment year (FY 2026 basis).
    # currency
    penalty_dollars_per_avoided_per_100m is cut_points_per_avoided * 1000000
    // cut points per avoided readmission / 100 x the hospital's estimated base payments (Impact File rebuild). Same
    // limits as `cut_points_per_avoided`.
    // FY 2026 basis.
    #" Estimated penalty dollars one avoided actual readmission removes per payment year at this hospital.
    #(agent) An estimate for one payment year: a discharge counts in about two payment years, nothing moves at the 3% cap, and Medicare also stops paying for the avoided stay, so this is not the hospital's net gain.
    # currency
    penalty_dollars_per_avoided_est is cut_points_per_avoided / 100 * pay2026h.base_payments_est_fy2026
    // 100 x neutrality modifier x reliability slope / (3 x expected rate %), penalized measures; blank for bypass
    // surgery (CABG), where too many counts are hidden to place the slope. Independent of the dollar base.
    #" Penalty relief per avoided readmission per payment year over the base payment of one stay in this condition, FY 2026 basis.
    #(agent) Below 1 the penalty relief from one avoided readmission is worth less than one stay's payment a year (COPD: median about 0.35, below 1 on all but 5 of 1,142 penalized rows; small measures about a quarter of large ones), so do not fund readmission work on penalty relief alone there; a discharge counts in about two payment years and the care cost avoided is a separate term.
    relief_to_stay_payment_ratio is pick 100 * pay.neutrality_modifier * reliability_slope / (3 * expected_rate_pct) when penalty_indicator and measure != 'CABG' else null
    #" Gap of CMS's ratio to the peer median in FY 2026 (ERR - peer median).
    gap_to_median_fy2026 is excess_readmission_ratio - peer_group_median_err
    // where scored.
    #" Gap of CMS's ratio to the peer median in FY 2027 (July 2023 to June 2025, Medicare Advantage added).
    #(agent) Hospitals picked as worst on FY 2026 keep only part of their gap in the next file even beyond chance (selection); compare FY 2027 with FY 2026 in `beyond_chance_next_file` before promising what a targeted program will remove.
    gap_to_median_fy2027 is pick fy2027.excess_readmission_ratio - fy2027.peer_group_median_err when fy2027.scored else null
    #" Gap of CMS's ratio to the peer median in FY 2025 (July 2020 to June 2023), where scored.
    gap_to_median_fy2025 is pick fy2025.excess_readmission_ratio - fy2025.peer_group_median_err when fy2025.scored else null
    // 'Count hidden' where the bounds give different bands.
    // from the actual count.
    #" FY 2026 measure size band against a peer-median hospital, in binomial chance SDs.
    gap_band_fy2026 is
      pick null when median_var_row is null or not has_err
      pick '1: within 1 SD' when z_vs_median_max < 1
      pick '2: 1-2 SD' when z_vs_median_min >= 1 and z_vs_median_max < 2
      pick '3: beyond 2 SD' when z_vs_median_min >= 2
      else 'Count hidden: band unknown'

  measure:
    #" Hospitals.
    hospital_count is count(facility_id)
    #" Hospital-measure rows with an excess readmission ratio.
    rows_with_err is count() { where: has_err }
    // ("Too Few to Report": 10 or fewer readmissions, zero included).
    #" Rows where CMS suppressed the readmission count.
    rows_suppressed is count() { where: readmissions_status = 'Too Few to Report' }
    #" Eligible Medicare discharges on rows with an ERR, three years (complete, from the CMS payment file).
    discharges is eligible_discharges.sum() { where: has_err }
    #" Discharges as published in the hospital file (missing on suppressed rows; undercounts).
    discharges_published_total is discharges_published.sum()
    #" Readmissions as published (suppressed rows missing; undercounts, especially hip/knee and CABG).
    readmissions_published_total is readmissions_published.sum()
    #" Readmissions expected for these patients at an average hospital, three years.
    expected_readmissions is sum(eligible_discharges * expected_rate_pct / 100) { where: has_err }
    #" Readmissions predicted for these patients at this hospital (CMS risk-adjusted), three years.
    predicted_readmissions is sum(eligible_discharges * predicted_rate_pct / 100) { where: has_err }
    #" Excess readmission ratio weighted by expected readmissions (predicted / expected).
    weighted_err is predicted_readmissions / nullif(expected_readmissions, 0)
    // rows below count as zero. Shrunken scale: actual counts are larger (see `observed_excess_readmissions`).
    // Shrunken: actual counts are larger.
    #" CMS's estimate of excess readmissions, three years, rows above expected only.
    excess_readmissions is sum(greatest(excess_readmissions_row, 0)) { where: has_err }
    #" CMS's estimate of excess readmissions per year (three-year count / 3).
    excess_readmissions_per_year is excess_readmissions / 3
    // (above minus below; near zero nationally by design).
    #" CMS's estimate of net readmissions above expected, three years.
    net_excess_readmissions is excess_readmissions_row.sum() { where: has_err }
    #" CMS's estimate of net readmissions above expected per year (three-year count / 3).
    net_excess_readmissions_per_year is net_excess_readmissions / 3
    // (positive rows; includes chance variation, so it overstates the underlying excess while CMS's estimate
    // understates it).
    #" Actual readmissions above expected, three years, on rows with a published count only.
    observed_excess_readmissions is sum(greatest(observed_excess_row, 0)) { where: has_err and readmissions_published is not null }
    // on penalized rows with a published count, three years.
    #" Actual readmissions above what a peer-median hospital would have.
    observed_above_median is observed_above_median_row.sum() { where: penalty_indicator and readmissions_published is not null }
    // (actual - expected) with suppressed rows at 0. Includes chance variation.
    #" Actual excess readmissions, three years, lower bound: positive.
    actual_excess_min is sum(greatest(actual_excess_row_min, 0)) { where: has_err and eligible_discharges is not null }
    #" Actual excess readmissions, three years, upper bound: suppressed rows at 10.
    actual_excess_max is sum(greatest(actual_excess_row_max, 0)) { where: has_err and eligible_discharges is not null }
    #" Actual excess readmissions per year, lower bound.
    actual_excess_per_year_min is actual_excess_min / 3
    #" Actual excess readmissions per year, upper bound.
    actual_excess_per_year_max is actual_excess_max / 3
    #" Actual net readmissions against expected, three years, lower bound (suppressed rows at 0).
    actual_net_excess_min is actual_excess_row_min.sum() { where: has_err and eligible_discharges is not null }
    #" Actual net readmissions against expected, three years, upper bound (suppressed rows at 10).
    actual_net_excess_max is actual_excess_row_max.sum() { where: has_err and eligible_discharges is not null }
    // lower bound.
    #" Actual readmissions above a peer-median hospital's count on penalized rows, three years.
    actual_above_median_min is actual_above_median_row_min.sum() { where: penalty_indicator }
    // upper bound.
    #" Actual readmissions above a peer-median hospital's count on penalized rows, three years.
    actual_above_median_max is actual_above_median_row_max.sum() { where: penalty_indicator }
  internal measure:
    #" Published rows used for the reliability slope.
    reliability_rows is count() { where: has_err and readmissions_published is not null and eligible_discharges is not null }
  measure:
    // (actual - expected), exact Poisson (column chance_excess, computed in the load SQL).
    // (actual - expected) if every hospital sat exactly at its expected rate.
    #" Chance-only positive excess per year: the sum of positive.
    chance_excess_per_year is chance_excess.sum() / 3
    #" Chance-only positive excess per year under the same suppression rule as `actual_excess_per_year_min` (counts of 10 or fewer read as 0).
    chance_excess_per_year_min is chance_excess_floor.sum() / 3
    // (counts of 10 or fewer read as 10).
    #" Chance-only positive excess per year under the same rule as `actual_excess_per_year_max`.
    chance_excess_per_year_max is chance_excess_ceiling.sum() / 3
  internal measure:
    #" Standard deviation of the chance-only figure per year (floor rule).
    chance_sd_per_year_min is sqrt(chance_excess_floor_var.sum()) / 3
    #" Standard deviation of the chance-only figure per year (ceiling rule).
    chance_sd_per_year_max is sqrt(chance_excess_ceiling_var.sum()) / 3
  measure:
    // (actual_excess_per_year_min - chance_excess_per_year_min).
    #" Actual excess readmissions per year beyond what chance alone gives, floor rule.
    beyond_chance_per_year_min is actual_excess_per_year_min - chance_excess_per_year_min
    #" Actual excess readmissions per year beyond chance, ceiling rule.
    beyond_chance_per_year_max is actual_excess_per_year_max - chance_excess_per_year_max
    // the lower of the two rules minus 1.96 chance standard deviations.
    #" Low end of a 95% interval for excess beyond chance per year.
    beyond_chance_per_year_low is least(beyond_chance_per_year_min - 1.96 * chance_sd_per_year_min, beyond_chance_per_year_max - 1.96 * chance_sd_per_year_max)
    #" High end of the 95% interval for excess beyond chance per year.
    beyond_chance_per_year_high is greatest(beyond_chance_per_year_min + 1.96 * chance_sd_per_year_min, beyond_chance_per_year_max + 1.96 * chance_sd_per_year_max)
    // 2020 dollars at $18,100 per readmission (care used, not a hospital saving).
    #" Cost of hospital care per year of excess beyond chance, low end.
    # currency
    beyond_chance_cost_per_year_low is beyond_chance_per_year_low * 18100
    // (care used, not a hospital saving).
    // 2020 dollars at $18,100 per readmission (care used, not a hospital saving).
    #" Cost of hospital care per year of excess beyond chance, high end.
    # currency
    beyond_chance_cost_per_year_high is beyond_chance_per_year_high * 18100
    // (counts of 10 or fewer read as 0).
    #" Chance-only positive excess per year with binomial noise (yes/no outcome), floor rule.
    chance_excess_binomial_per_year_min is chance_excess_b_floor.sum() / 3
    #" Same, ceiling rule (counts of 10 or fewer read as 10).
    chance_excess_binomial_per_year_max is chance_excess_b_ceiling.sum() / 3
    // A lower bound on the true excess, not an estimate of it.
    #" Floor on actual excess beyond chance per year, binomial noise, floor rule.
    beyond_chance_binomial_per_year_min is actual_excess_per_year_min - chance_excess_binomial_per_year_min
    #" Same, ceiling rule.
    beyond_chance_binomial_per_year_max is actual_excess_per_year_max - chance_excess_binomial_per_year_max
  internal measure:
    #" Rows used for the spread estimate: published count and expected count of 25 or more.
    spread_rows is count() { where: has_err and readmissions_published is not null and eligible_discharges is not null and expected_count_row >= 25 }
    // Group by measure.
    // sqrt((sum (O - E)^2 - sum n p (1 - p)) / sum E^2).
    #" Live method-of-moments spread (relative SD of true rates) on those rows.
    #" Spread sums on those rows: sum (O - E)^2.
    spread_sxx is sum(observed_excess_row * observed_excess_row) { where: has_err and readmissions_published is not null and eligible_discharges is not null and expected_count_row >= 25 }
    #" Spread sums: sum of binomial noise n p (1 - p).
    spread_noise is sum(eligible_discharges * (expected_rate_pct / 100) * (1 - expected_rate_pct / 100)) { where: has_err and readmissions_published is not null and eligible_discharges is not null and expected_count_row >= 25 }
    #" Spread sums: sum E^2.
    spread_see is sum(expected_count_row * expected_count_row) { where: has_err and readmissions_published is not null and eligible_discharges is not null and expected_count_row >= 25 }
    #" Spread sums: sum E (O - E).
    spread_seo is sum(expected_count_row * observed_excess_row) { where: has_err and readmissions_published is not null and eligible_discharges is not null and expected_count_row >= 25 }
  measure:
    // (hip/knee about -0.29: the big centres run below expected).
    #" Weighted mean offset of (O - E) / E on those rows: sum E (O - E) / sum E^2.
    spread_mean_offset is spread_seo / nullif(spread_see, 0)
    // Group by measure; matches `spread_tau`.
    #" Live centred method-of-moments spread: sqrt((sum (O - E)^2 - sum n p (1 - p) - offset^2 x sum E^2) / sum E^2).
    spread_tau_live is sqrt(greatest((spread_sxx - spread_noise - spread_mean_offset * spread_mean_offset * spread_see) / nullif(spread_see, 0), 0))
    // zero for hip/knee and CABG, whose estimate is then blank, not 0.
    #" Rows the true-excess estimate covers (heart attack, heart failure, pneumonia, COPD with an ERR and eligible discharges).
    true_excess_rows is count() { where: posterior_covered and has_err and eligible_discharges is not null }
    // (hip/knee and CABG not estimated: their ratio changes with hospital size): sum of expected count x
    // true_excess_factor / 3 (assumes true ratios spread normally around 1 + spread_offset with the measure's relative
    // SD spread_tau, at every volume). Inferred; the binomial floor is a lower bound on it. For a state or hospital
    // subset it gives the national pattern applied to those patients, not a measurement of the subset.
    // Inferred; for a subset it is the national pattern applied, not a measurement.
    #" Estimated true excess readmissions per year, heart attack, heart failure, pneumonia and COPD.
    true_excess_per_year is pick sum(expected_count_row * true_excess_factor) { where: has_err and eligible_discharges is not null } / 3 when true_excess_rows > 0 else null
    // (per-measure ends; the joint national interval for the four conditions resampling whole hospitals,
    // queries/r4/vc3.py, 50,000 resamples, is narrower: 4,380 to 6,390). Covers hospital sampling only, not the
    // normal-shape or same-spread-at-every-volume assumptions.
    #" Low end of `true_excess_per_year`: hospital sampling only, not the model's shape assumptions.
    true_excess_per_year_low is pick sum(expected_count_row * true_excess_factor_low) { where: has_err and eligible_discharges is not null } / 3 when true_excess_rows > 0 else null
    #" High end, sum of each measure's high factor.
    true_excess_per_year_high is pick sum(expected_count_row * true_excess_factor_high) { where: has_err and eligible_discharges is not null } / 3 when true_excess_rows > 0 else null
    // 2020 dollars at $18,100 per readmission (care used, not a hospital saving).
    #" Cost of hospital care per year of the estimated true excess.
    # currency
    true_excess_cost_per_year is true_excess_per_year * 18100
    #" Low end of the cost, same per-measure ends as `true_excess_per_year_low`.
    # currency
    true_excess_cost_per_year_low is true_excess_per_year_low * 18100
    #" High end of the cost, same per-measure ends as `true_excess_per_year_high`.
    # currency
    true_excess_cost_per_year_high is true_excess_per_year_high * 18100
    // lower bound (inferred; prior from F3's spread; hip/knee and CABG not estimated).
    // pneumonia and COPD rows, three years.
    #" Posterior (empirical-Bayes) gap above the peer median on penalized heart attack, heart failure.
    posterior_gap_min is posterior_gap_row_min.sum() { where: penalty_indicator }
    #" Same, upper bound.
    posterior_gap_max is posterior_gap_row_max.sum() { where: penalty_indicator }
    #" Posterior variance of the gap on those penalized rows (four conditions).
    posterior_var_penalized is posterior_var_row.sum() { where: penalty_indicator }
    // lower bound (the base of `real_share_of_gap_at_floor`).
    // pneumonia and COPD rows, three years.
    #" Actual readmissions above a peer-median hospital's count on penalized heart attack, heart failure.
    actual_above_median_covered_min is actual_above_median_row_min.sum() { where: penalty_indicator and posterior_covered }
    #" Same, upper bound (hidden counts at 10).
    actual_above_median_covered_max is actual_above_median_row_max.sum() { where: penalty_indicator and posterior_covered }
    #" Binomial variance of a peer-median hospital's count summed over penalized rows, three years.
    median_var_penalized is median_var_row.sum() { where: penalty_indicator }
    #" Readmissions a peer-median hospital would have on penalized rows, three years.
    median_count_penalized is median_count_row.sum() { where: penalty_indicator }
  internal measure:
    #" Reliability sums over published rows (x = actual excess, y = CMS's estimate of excess).
    rel_sx is observed_excess_row.sum() { where: has_err and readmissions_published is not null and eligible_discharges is not null }
    #" Reliability sum of y.
    rel_sy is excess_readmissions_row.sum() { where: has_err and readmissions_published is not null and eligible_discharges is not null }
    #" Reliability sum of x*y.
    rel_sxy is sum(observed_excess_row * excess_readmissions_row) { where: has_err and readmissions_published is not null and eligible_discharges is not null }
    #" Reliability sum of x*x.
    rel_sxx is sum(observed_excess_row * observed_excess_row) { where: has_err and readmissions_published is not null and eligible_discharges is not null }
  measure:
    #" Live slope of CMS's estimate on the actual excess, published rows: (n*Sxy - Sx*Sy) / (n*Sxx - Sx^2).
    reliability_slope_live is (reliability_rows * rel_sxy - rel_sx * rel_sy) / nullif(reliability_rows * rel_sxx - rel_sx * rel_sx, 0)
    // (21 such rows sit at hospitals whose cut rounds to 0).
    // counted on every row with the penalty flag.
    #" Penalized rows whose readmission count is suppressed (no actual-scale figure).
    penalized_rows_suppressed is count() { where: penalty_indicator and readmissions_published is null }
    // excess readmissions per year x $18,100, the average cost of the care a Medicare readmission used in 2020 (AHRQ
    // HCUP Statistical Brief #307; a cost of care, not a Medicare payment and not what a hospital saves, since
    // Medicare pays the readmission as its own stay; same figure for every condition).
    // (a floor; care used, not a hospital saving).
    #" Cost of hospital care of CMS's estimated excess readmissions per year, 2020 dollars at $18,100.
    # currency
    excess_cost_per_year is excess_readmissions_per_year * 18100
    #" Net readmissions above expected per 1,000 eligible discharges (negative = fewer than expected).
    net_excess_per_1000 is 1000 * net_excess_readmissions / nullif(discharges, 0)
    #" Measure rows that count toward the payment cut (25+ discharges and ERR above the peer group median).
    penalized_rows is count() { where: penalty_indicator }
    // (shrunken; an actual readmission moves it by 0.16 to 0.86 depending on measure and volume, so actual counts are
    // about 1.2 to 6 times larger; see `actual_above_median_min`/`_max`).
    // Shrunken: actual counts run about 1.2 to 6 times larger.
    #" CMS's estimate of readmissions above the peer group median on penalized rows, three years.
    readmissions_above_median is readmissions_above_median_row.sum() { where: penalty_indicator }
    // (CMS risk-adjusted, this hospital's patients).
    #" Predicted readmission rate weighted by discharges, percent.
    predicted_rate is 100 * predicted_readmissions / nullif(discharges, 0)
    #" Expected readmission rate weighted by discharges, percent (same patients at an average hospital).
    expected_rate is 100 * expected_readmissions / nullif(discharges, 0)
    #" Share of rows with an ERR whose readmission count is suppressed.
    # percent
    suppressed_share is rows_suppressed / nullif(rows_with_err, 0)
    // rows with an ERR and eligible discharges.
    #" Actual readmissions, three years, lower bound (hidden counts at 0).
    actual_readmissions_min is readmissions_min.sum() { where: has_err and eligible_discharges is not null }
    #" Same, upper bound (hidden counts at 10).
    actual_readmissions_max is readmissions_max.sum() { where: has_err and eligible_discharges is not null }
    // (suppression built into the test; sampling noise only).
    // against that statistic's binomial mean and variance at expected rates.
    #" Group z of its count as the file shows it, hidden counts read as 0.
    group_z_floor is (actual_readmissions_min - null_count_floor_mean.sum() { where: has_err and eligible_discharges is not null }) / nullif(sqrt(null_count_floor_var.sum() { where: has_err and eligible_discharges is not null }), 0)
    #" Same with hidden counts read as 10.
    group_z_ceiling is (actual_readmissions_max - null_count_ceiling_mean.sum() { where: has_err and eligible_discharges is not null }) / nullif(sqrt(null_count_ceiling_var.sum() { where: has_err and eligible_discharges is not null }), 0)
    // both suppression readings must agree for a label.
    #" Group's readmissions against expected at 95% (binomial, sampling noise only).
    group_vs_expected is
      pick 'Above expected, beyond chance' when group_z_floor >= 1.96 and group_z_ceiling >= 1.96
      pick 'Below expected, beyond chance' when group_z_floor <= -1.96 and group_z_ceiling <= -1.96
      pick 'Within chance' when abs(group_z_floor) < 1.96 and abs(group_z_ceiling) < 1.96
      else 'Readings disagree: cannot tell'
    #" Ratio of actual to expected readmissions, lower bound.
    actual_to_expected_min is actual_readmissions_min / nullif(expected_readmissions, 0)
    #" Same, upper bound.
    actual_to_expected_max is actual_readmissions_max / nullif(expected_readmissions, 0)
    #" Hospital-measure rows with a posterior (heart attack, heart failure, pneumonia, COPD).
    posterior_rows is count() { where: posterior_ratio_min is not null }
    // heart failure, pneumonia and COPD only; lower bound (hidden counts at 0); blank where the group has none of
    // them. Inferred.
    // four conditions only, lower bound. Inferred.
    #" Estimated true excess readmissions per year for this group from its own counts (empirical Bayes).
    posterior_excess_per_year_min is pick posterior_excess_row_min.sum() / 3 when posterior_rows > 0 else null
    #" Same, upper bound (hidden counts at 10).
    posterior_excess_per_year_max is pick posterior_excess_row_max.sum() / 3 when posterior_rows > 0 else null
    // (sampling given the prior; not the prior's own uncertainty), floored at 0.
    #" Low end of a 95% interval: lower bound minus 1.96 posterior SDs.
    posterior_excess_per_year_low is pick greatest(posterior_excess_row_min.sum() / 3 - 1.96 * sqrt(posterior_excess_var_row_min.sum()) / 3, 0) when posterior_rows > 0 else null
    #" High end: upper bound plus 1.96 posterior SDs.
    posterior_excess_per_year_high is pick posterior_excess_row_max.sum() / 3 + 1.96 * sqrt(posterior_excess_var_row_max.sum()) / 3 when posterior_rows > 0 else null
    // 2020 dollars at $18,100 per readmission (care used, not a hospital saving).
    #" Cost of hospital care per year of that estimate, lower bound.
    # currency
    posterior_excess_cost_per_year_min is posterior_excess_per_year_min * 18100
    #" Same, upper bound.
    # currency
    posterior_excess_cost_per_year_max is posterior_excess_per_year_max * 18100
    #" FY 2026 cut points from the measures in the group (sum of `cut_points_row`).
    cut_points is cut_points_row.sum()
    #" Actual readmissions to avoid to bring CMS's ratio to the peer median on the penalized measures in the group (approximation).
    actual_to_clear is actual_to_clear_row.sum() { where: penalty_indicator }
    #" FY 2026 penalized measures CMS scored again in FY 2027.
    scored_fy2027 is count() { where: penalty_indicator and fy2027.scored }
    #" Of those, penalized again in FY 2027.
    penalized_again_fy2027 is count() { where: penalty_indicator and fy2027.scored and fy2027.penalty_indicator }
    #" Share penalized again.
    # percent
    penalized_again_share is penalized_again_fy2027 / nullif(scored_fy2027, 0)
    // (hidden counts at 0). Inferred.
    // (true rate at the peer median in both periods), lower bound. Inferred.
    #" Share expected to be penalized again by chance alone with the shared year.
    # percent
    repeat_chance_share_min is repeat_chance_min.avg() { where: penalty_indicator and fy2027.scored }
    #" Same, upper bound (hidden counts at 10).
    # percent
    repeat_chance_share_max is repeat_chance_max.avg() { where: penalty_indicator and fy2027.scored }
    // (each measure's share of its hospital's estimated dollars; hospitals in the hospital file).
    #" Estimated FY 2026 penalty dollars a year from the measures in the group.
    #(agent) An estimate from the Impact File base (national about $336M, range $315M to $345M); count penalized rows and you get the opposite picture, since bypass and hip/knee rows are few but carry about a quarter of the dollars.
    # currency
    penalty_dollars_est is pay.penalty_dollars_part_est.sum()
    // penalized rows with a dollar estimate.
    // (three-year count).
    #" Estimated FY 2026 penalty dollars a year per readmission above the peer median on CMS's estimate.
    #(agent) The formula prices a surgical readmission about four times a medical one (bypass about $108,000, hip/knee about $75,000, heart failure about $16,000, COPD about $15,000 a year per readmission above the median), because its weight is the DRG payment ratio; the denominator is CMS's shrunken three-year estimate, not readmissions that happened.
    # currency
    penalty_dollars_per_readmission_above_median is pay.penalty_dollars_part_est.sum() / nullif(readmissions_above_median_row.sum() { where: penalty_indicator and pay.penalty_dollars_part_est is not null }, 0)
    #" Penalized rows with a relief ratio (all conditions but bypass surgery).
    relief_rows is count() { where: relief_to_stay_payment_ratio is not null }
    #" Mean relief per avoided readmission over one stay's payment, per payment year (penalized rows).
    mean_relief_to_stay_payment is relief_to_stay_payment_ratio.avg()

  #" National totals by condition: discharges, expected and excess readmissions, cost, suppression.
  view: by_condition is {
    group_by: condition
    aggregate: rows_with_err, suppressed_share, discharges, expected_readmissions, weighted_err, excess_readmissions, excess_readmissions_per_year, excess_cost_per_year, net_excess_readmissions, penalized_rows
    order_by: excess_readmissions desc
  }

  #" States: CMS's estimate of excess and net readmissions per year with penalty counts.
  view: by_state is {
    group_by: state
    aggregate: hospital_count, discharges, excess_readmissions_per_year, excess_cost_per_year, net_excess_readmissions_per_year, net_excess_per_1000, hospital.penalized_hospitals, hospital.hospitals_in_program
    order_by: net_excess_per_1000 desc
  }

  #" Hospitals with the most excess readmissions per year on CMS's estimate (all six conditions), with their payment cut.
  view: top_excess_hospitals is {
    group_by: facility_id, facility_name, state, hospital.payment_reduction_pct
    aggregate: discharges, excess_readmissions_per_year, excess_cost_per_year, net_excess_readmissions_per_year
    order_by: excess_readmissions_per_year desc
    limit: 50
  }

  #" Hip/knee replacement by hospital volume: predicted against expected readmission rate, and how many counts the public file hides.
  view: hip_knee_by_volume is {
    where: measure = 'HIP-KNEE' and has_err
    group_by: volume_band
    aggregate: hospital_count, discharges, predicted_rate, expected_rate, weighted_err, excess_readmissions, net_excess_readmissions, suppressed_share
    order_by: volume_band
  }

  #" Bypass surgery (CABG) by hospital volume: predicted against expected readmission rate.
  view: cabg_by_volume is {
    where: measure = 'CABG' and has_err
    group_by: volume_band
    aggregate: hospital_count, discharges, predicted_rate, expected_rate, weighted_err, excess_readmissions, suppressed_share
    order_by: volume_band
  }

  // CCNs: 340114 Rex, 340069 WakeMed Raleigh, 340173 WakeMed Cary, 340030 Duke University, 340155 Duke Regional, 340061 UNC Hospitals, 340090 Johnston. Duke Raleigh Hospital (340073), WakeMed North and UNC Rex Holly Springs have no row in the FY 2026 files.
  #" Triangle hospitals in the file: Rex, WakeMed Raleigh and Cary, Duke University and Duke Regional, UNC Hospitals, Johnston.
  view: raleigh_area is {
    where: facility_id = ('340114' | '340069' | '340173' | '340030' | '340155' | '340061' | '340090')
    group_by: facility_name, condition, eligible_discharges, readmissions_status, excess_readmission_ratio, peer_group_median_err, penalty_indicator, predicted_rate_pct, expected_rate_pct
    aggregate: excess_readmissions, net_excess_readmissions, readmissions_above_median, observed_excess_readmissions, observed_above_median
    order_by: facility_name, condition
  }

  #" True excess by condition: the binomial floor beside the estimate and the spread it uses. Hip/knee and CABG carry the floor only (`estimate_note`).
  view: true_excess_by_condition is {
    group_by: condition,
      estimate_note is pick 'Estimated' when posterior_covered else 'Not estimated: CMS ratio changes with hospital size', spread_tau, spread_tau_low, spread_tau_high, spread_offset, true_excess_factor
    aggregate: spread_rows, spread_mean_offset, spread_tau_live, excess_readmissions_per_year, beyond_chance_binomial_per_year_min, beyond_chance_binomial_per_year_max, true_excess_per_year, true_excess_per_year_low, true_excess_per_year_high, true_excess_cost_per_year
    order_by: true_excess_per_year desc
  }

  #" Actual excess against chance by condition, per year: the file's bounds, chance alone under the same rule, and the part beyond chance with a 95% interval (floors, not estimates). Do not sum the ends across conditions.
  view: beyond_chance_by_condition is {
    group_by: condition
    aggregate: excess_readmissions_per_year, actual_excess_per_year_min, actual_excess_per_year_max, chance_excess_per_year_min, chance_excess_per_year_max, beyond_chance_per_year_low, beyond_chance_per_year_high, beyond_chance_cost_per_year_low, beyond_chance_cost_per_year_high
    order_by: beyond_chance_per_year_high desc
  }

  #" Reliability table: how far CMS's estimate moves per actual readmission, by measure and volume band (recomputed live; compare `reliability_slope`, the constants the model uses).
  view: reliability_table is {
    where: reliability_band is not null
    group_by: measure, reliability_band, reliability_slope
    aggregate: reliability_rows, reliability_slope_live
    order_by: measure, reliability_band
  }

  #" Reliability by volume band, all measures pooled.
  view: reliability_by_volume is {
    where: reliability_band is not null
    group_by: reliability_band
    aggregate: reliability_rows, reliability_slope_live
    order_by: reliability_band
  }

  #" For each penalized hospital and measure: CMS's estimate and the actual count above the median, the chance band, and actual readmissions per unit of the estimate. A gap inside one or two chance SDs is not distinguishable from chance.
  view: actual_readmissions_to_avoid is {
    where: penalty_indicator
    group_by: facility_id, facility_name, state, condition, eligible_discharges, readmissions_status, reliability_slope, actual_per_estimated
    aggregate: readmissions_above_median, actual_above_median_min, actual_above_median_max, median_count_penalized, chance_sd is sqrt(median_count_penalized)
    order_by: facility_name, condition
  }

  #" Hospital rows for one place: each measure's discharges, ERR, peer median, penalty flag and excess readmissions.
  view: hospital_detail is {
    group_by: facility_id, facility_name, state, condition, eligible_discharges, readmissions_status, excess_readmission_ratio, peer_group_median_err, penalty_indicator, predicted_rate_pct, expected_rate_pct
    aggregate: excess_readmissions, readmissions_above_median
    order_by: facility_name, condition
  }

  #" Hospital-measure rows against chance, ranked by the probability the true rate is worse than expected; filter by state, condition or facility_id. Hip/knee and CABG are not ranked: read their chance labels.
  view: hospital_measures_vs_chance is {
    where: has_err and eligible_discharges is not null
    group_by: facility_id, facility_name, state, condition, eligible_discharges, readmissions_status, vs_expected_chance, vs_peer_median_chance, prob_worse_than_expected_min, prob_worse_than_expected_max
    aggregate: expected_readmissions, actual_readmissions_min, actual_readmissions_max, posterior_excess_per_year_min, posterior_excess_per_year_max
    order_by: prob_worse_than_expected_min desc
  }

  #" States against expected: actual and expected readmissions, the chance test, CMS's ratio, and the estimated true excess and its cost (`four_conditions_*` cover four conditions; the rest all six).
  #(agent) Beyond chance here means the state's FY 2026 counts beat patient-level chance, not that the excess lasts across the state's hospitals: before funding statewide work read `payment_hospitals -> state_persistence` (Massachusetts and New Jersey are beyond chance here and do not persist there, so work there is targeted, not statewide).
  view: state_vs_expected is {
    group_by: state
    aggregate: expected_readmissions, actual_readmissions_min, actual_readmissions_max, group_vs_expected, weighted_err
      four_conditions_excess_per_year_min is posterior_excess_per_year_min
      four_conditions_excess_per_year_max is posterior_excess_per_year_max
      four_conditions_care_cost_min is posterior_excess_cost_per_year_min
      four_conditions_care_cost_max is posterior_excess_cost_per_year_max
      hospital.penalized_hospitals, hospital.hospitals_in_program
    order_by: state
  }

  // Detail: `cut_points` is the most a measure can remove; a discharge counts in about two payment years (FY 2026 basis per year). `at_cap_fy2026` is the FY 2026 cap; `cut_fy2027` and `at_cap_fy2027` are the FY 2027 cut, in effect now, and its cap (parts in `payment_hospitals -> cut_drivers`).
  #" FY 2026 penalized measures by hospital: part of the cut, readmissions above the median and to avoid, chance, and what one avoided readmission is worth per payment year. At the 3% cap one fix removes nothing until the parts fall below 3.
  view: penalty_drivers is {
    where: penalty_indicator
    group_by: facility_id, facility_name, state, hospital.payment_reduction_pct
      at_cap_fy2026 is hospital.payment_reduction_pct >= 3
      cut_fy2027 is pay2027.payment_reduction_pct
      at_cap_fy2027 is pay2027.payment_reduction_pct >= 3
      condition,
      eligible_discharges, readmissions_status, excess_readmission_ratio, peer_group_median_err, drg_payment_ratio, vs_peer_median_chance, cut_points_per_avoided, penalty_dollars_per_avoided_per_100m
    aggregate:
      cut_points
      # percent
      share_of_summed_parts is cut_points / nullif(all(cut_points, facility_id), 0)
      cut_without_measure is least(3, all(cut_points, facility_id) - cut_points)
      readmissions_above_median, actual_above_median_min, actual_above_median_max, actual_to_clear
    order_by: facility_name, cut_points desc
  }

  #" FY 2026 penalized measures followed into FY 2027: penalized again against the chance baseline, by the FY 2026 gap in chance SDs. The gap to chance is not a measured bound on persistence (Medicare Advantage stays and a refitted model changed FY 2027).
  view: repeat_fy2027 is {
    where: penalty_indicator
    group_by:
      count_published is readmissions_published is not null
      gap_band_fy2026
    aggregate: penalized_rows, scored_fy2027, penalized_again_fy2027, penalized_again_share, repeat_chance_share_min, repeat_chance_share_max
    order_by: count_published desc, gap_band_fy2026
  }

  #" Actual readmissions against expected by hospital ownership (Hospital General Information), with hidden counts bounded at 0 and 10 and eligible discharges from CMS's payment file; filter by condition.
  #(agent) Dropping hidden-count rows keeps only larger hospitals and makes the for-profit gap look wider and general; with the bounds the gap holds for heart failure and pneumonia only, so treat ownership as a weak prior, never a verdict on one hospital.
  view: by_ownership is {
    where: has_err and eligible_discharges is not null
    group_by: ownership_group is hospital.info.ownership_group
    aggregate: hospital_count, rows_with_err, rows_suppressed, expected_readmissions, actual_to_expected_min, actual_to_expected_max, weighted_err
    order_by: ownership_group
  }

  #" Actual readmissions against expected by dual-eligible peer group (quintile of the share of stays by patients on both Medicare and Medicaid), hidden counts bounded; filter by condition.
  #(agent) Higher rates in the high-dual groups are partly patient mix the risk model leaves out, which this file cannot separate from care, so do not read a safety-net hospital's higher rate as proof of worse care.
  view: vs_expected_by_peer_group is {
    where: has_err and eligible_discharges is not null and hospital.in_payment_file
    group_by: hospital.peer_group_label
    aggregate: hospital_count, rows_suppressed, expected_readmissions, actual_to_expected_min, actual_to_expected_max, weighted_err
    order_by: peer_group_label
  }

  #" Hospital-measures above expected beyond chance in FY 2026: their gap to the peer median in FY 2025, FY 2026 and FY 2027, and the share left in FY 2027. Filter by state and condition.
  #(agent) Rows picked as worst on FY 2026 carry upward luck, so their gap shrinks in the next file (to about 60% for Florida heart failure); size a targeted program on the FY 2027 gap, not the FY 2026 one, and note FY 2027 shares one discharge year with FY 2026.
  view: beyond_chance_next_file is {
    where: vs_expected_chance = 'Above expected, beyond chance' and fy2027.scored
    group_by: condition
    aggregate:
      rows is count()
      mean_gap_fy2025 is gap_to_median_fy2025.avg()
      mean_gap_fy2026 is gap_to_median_fy2026.avg()
      mean_gap_fy2027 is gap_to_median_fy2027.avg()
      # percent
      share_of_gap_kept is gap_to_median_fy2027.avg() / nullif(gap_to_median_fy2026.avg(), 0)
    order_by: condition
  }

  #" Estimated FY 2026 penalty dollars by condition against CMS's estimated readmissions above the peer median: each condition's share of dollars and of readmissions, and dollars per readmission above the median.
  #(agent) Counting penalized rows or readmissions makes bypass and hip/knee look small; in dollars they carry about a quarter of the penalty on about 7% of the readmissions above the median, so comment on price per readmission, not on counts.
  view: penalty_dollars_by_condition is {
    where: penalty_indicator
    group_by: condition
    aggregate:
      penalized_rows
      penalty_dollars_est
      # percent
      share_of_dollars is penalty_dollars_est / all(penalty_dollars_est)
      readmissions_above_median
      # percent
      share_of_readmissions_above_median is readmissions_above_median / all(readmissions_above_median)
      penalty_dollars_per_readmission_above_median
    order_by: penalty_dollars_est desc
  }

  #" Penalty relief per avoided readmission over one stay's payment, per payment year, by condition and volume band (FY 2026 penalized measures; bypass surgery blank).
  #(agent) The relief is weakest at small measures (CMS's shrinkage) and for COPD; a ratio under 1 means penalty relief alone does not repay one stay's payment in a year, and the figure rests on the reliability slope, which hidden counts make uncertain for hip/knee.
  view: relief_per_avoided_by_condition is {
    where: penalty_indicator and measure != 'CABG'
    group_by: condition, reliability_band
    aggregate: relief_rows, mean_relief_to_stay_payment
    order_by: condition, reliability_band
  }
}

#" One row per penalized hospital: its FY 2026 payment cut beside CMS's estimate of readmissions above its peer median on the measures that produced it (three years).
#(agent) `readmissions_above_median` and `basis_band` are CMS's shrunken estimate, not readmissions that happened: on published penalized rows the actual count above the peer median is 27,201 against CMS's 12,608. For actual readmissions give the bounds: `actual_under_one_fewest` to `actual_under_one_most` (88 to 722 hospitals under one), `below_expected_actual_fewest` to `_most` (525 to 1,416). Penalized rows were picked on CMS's estimate, which tracks the actual count closely, so actual counts on them carry upward chance. As a group, penalized hospitals are above expected (`penalized_above_expected` 1,353 of 2,302). FY 2026 cuts are finished; FY 2027 cuts are in effect on different rules.
#(agent) The posterior fields (`posterior_z_*`, `prob_above_median_*`, `share_truly_above_median_*`, `real_share_of_gap_*`) cover penalized heart attack, heart failure, pneumonia and COPD measures only; a hospital penalized only on hip/knee or CABG has them blank (not estimated: those ratios change with hospital size). They are on a narrower basis than `actual_above_median_*`, which sums every penalized measure.
source: penalty_basis is measure_results -> {
  where: hospital.payment_reduction_pct > 0
  group_by: facility_id, facility_name, state, hospital.peer_group, hospital.payment_reduction_pct
  aggregate: readmissions_above_median, penalized_rows, excess_readmissions, net_excess_readmissions, observed_above_median, penalized_rows_suppressed, actual_above_median_min, actual_above_median_max, actual_net_excess_min, actual_net_excess_max, expected_readmissions, median_count_penalized, median_var_penalized, posterior_gap_min, posterior_gap_max, posterior_var_penalized, actual_above_median_covered_min, actual_above_median_covered_max
} extend {
  dimension:
    #" Poisson standard deviation of a peer-median hospital's count on the penalized measures (three years); slightly overstates sampling noise for a yes/no outcome, see `chance_sd_binomial`.
    chance_sd is sqrt(median_count_penalized)
    #" Binomial standard deviation of a peer-median hospital's count on the penalized measures (yes/no outcome; about 5 to 10% below `chance_sd`).
    chance_sd_binomial is sqrt(median_var_penalized)
    #" Posterior z of the real gap above the peer median on the penalized heart attack, heart failure, pneumonia and COPD measures, lower bound (suppressed counts at 0); blank where the hospital has none of them.
    posterior_z_min is posterior_gap_min / nullif(sqrt(posterior_var_penalized), 0)
    #" Same, upper bound.
    posterior_z_max is posterior_gap_max / nullif(sqrt(posterior_var_penalized), 0)
    #" Posterior probability the hospital's true rate is above the peer median on its penalized heart attack, heart failure, pneumonia and COPD measures (hip/knee and CABG not estimated; blank when only those are penalized), lower bound (normal CDF, Abramowitz-Stegun 26.2.17).
    prob_above_median_min is (pick 1 - exp(-(posterior_z_min) * (posterior_z_min) / 2) * 0.3989422804 * (1 / (1 + 0.2316419 * abs(posterior_z_min))) * (0.319381530 + (1 / (1 + 0.2316419 * abs(posterior_z_min))) * (-0.356563782 + (1 / (1 + 0.2316419 * abs(posterior_z_min))) * (1.781477937 + (1 / (1 + 0.2316419 * abs(posterior_z_min))) * (-1.821255978 + (1 / (1 + 0.2316419 * abs(posterior_z_min))) * 1.330274429)))) when posterior_z_min >= 0 else exp(-(posterior_z_min) * (posterior_z_min) / 2) * 0.3989422804 * (1 / (1 + 0.2316419 * abs(posterior_z_min))) * (0.319381530 + (1 / (1 + 0.2316419 * abs(posterior_z_min))) * (-0.356563782 + (1 / (1 + 0.2316419 * abs(posterior_z_min))) * (1.781477937 + (1 / (1 + 0.2316419 * abs(posterior_z_min))) * (-1.821255978 + (1 / (1 + 0.2316419 * abs(posterior_z_min))) * 1.330274429)))))
    #" Same, upper bound.
    prob_above_median_max is (pick 1 - exp(-(posterior_z_max) * (posterior_z_max) / 2) * 0.3989422804 * (1 / (1 + 0.2316419 * abs(posterior_z_max))) * (0.319381530 + (1 / (1 + 0.2316419 * abs(posterior_z_max))) * (-0.356563782 + (1 / (1 + 0.2316419 * abs(posterior_z_max))) * (1.781477937 + (1 / (1 + 0.2316419 * abs(posterior_z_max))) * (-1.821255978 + (1 / (1 + 0.2316419 * abs(posterior_z_max))) * 1.330274429)))) when posterior_z_max >= 0 else exp(-(posterior_z_max) * (posterior_z_max) / 2) * 0.3989422804 * (1 / (1 + 0.2316419 * abs(posterior_z_max))) * (0.319381530 + (1 / (1 + 0.2316419 * abs(posterior_z_max))) * (-0.356563782 + (1 / (1 + 0.2316419 * abs(posterior_z_max))) * (1.781477937 + (1 / (1 + 0.2316419 * abs(posterior_z_max))) * (-1.821255978 + (1 / (1 + 0.2316419 * abs(posterior_z_max))) * 1.330274429)))))
    #" Band of CMS's estimate of readmissions above the peer median that produced the cut (three years; shrunken scale).
    basis_band is
      pick '1: under 1' when readmissions_above_median < 1
      pick '2: 1-1.99' when readmissions_above_median < 2
      pick '3: 2-4.99' when readmissions_above_median < 5
      pick '4: 5-19.99' when readmissions_above_median < 20
      else '5: 20+'
  measure:
    #" Penalized hospitals.
    penalized_hospitals is count()
    #" Penalized hospitals whose readmissions across all their measures were below expected on CMS's estimate (net under zero).
    penalized_below_expected is count() { where: net_excess_readmissions < 0 }
    #" Average payment cut, percent (unweighted).
    avg_payment_reduction_pct is payment_reduction_pct.avg()
    #" Penalized hospitals with every penalized count published (actual-scale figure available).
    hospitals_all_published is count() { where: penalized_rows_suppressed = 0 }
    #" Of those, hospitals under one actual readmission above the peer median (three years).
    actual_under_one is count() { where: penalized_rows_suppressed = 0 and observed_above_median < 1 }
    #" Fewest penalized hospitals that can be under one actual readmission above the peer median (suppressed rows at 10).
    actual_under_one_fewest is count() { where: actual_above_median_max < 1 }
    #" Most penalized hospitals that can be under one actual readmission above the peer median (suppressed rows at 0).
    actual_under_one_most is count() { where: actual_above_median_min < 1 }
    #" Fewest penalized hospitals that can be below expected on actual counts (suppressed rows at 10).
    below_expected_actual_fewest is count() { where: actual_net_excess_max < 0 }
    #" Most penalized hospitals that can be below expected on actual counts (suppressed rows at 0).
    below_expected_actual_most is count() { where: actual_net_excess_min < 0 }
    #" Penalized hospitals with every penalized count published whose actual gap above the peer-median count is within one chance SD.
    within_one_sd_published is count() { where: penalized_rows_suppressed = 0 and observed_above_median < chance_sd }
    #" Same, within two chance SDs.
    within_two_sd_published is count() { where: penalized_rows_suppressed = 0 and observed_above_median < 2 * chance_sd }
    #" All penalized hospitals: fewest that can be within two chance SDs (suppressed rows at 10).
    within_two_sd_fewest is count() { where: actual_above_median_max < 2 * chance_sd }
    #" All penalized hospitals: most that can be within two chance SDs (suppressed rows at 0).
    within_two_sd_most is count() { where: actual_above_median_min < 2 * chance_sd }
    #" All penalized hospitals: fewest within one chance SD.
    within_one_sd_fewest is count() { where: actual_above_median_max < chance_sd }
    #" All penalized hospitals: most within one chance SD.
    within_one_sd_most is count() { where: actual_above_median_min < chance_sd }
    #" Penalized hospitals with every count published within two binomial chance SDs.
    within_two_sd_binomial_published is count() { where: penalized_rows_suppressed = 0 and observed_above_median < 2 * chance_sd_binomial }
    #" All penalized hospitals: fewest beyond two binomial SDs (suppressed rows at 0).
    beyond_two_sd_binomial_fewest is count() { where: actual_above_median_min >= 2 * chance_sd_binomial }
    #" All penalized hospitals: fewest beyond one binomial SD (suppressed rows at 0).
    beyond_one_sd_binomial_fewest is count() { where: actual_above_median_min >= chance_sd_binomial }
    #" All penalized hospitals: most beyond one binomial SD (suppressed rows at 10).
    beyond_one_sd_binomial_most is count() { where: actual_above_median_max >= chance_sd_binomial }
    #" All penalized hospitals: fewest beyond three binomial SDs (suppressed rows at 0).
    beyond_three_sd_binomial_fewest is count() { where: actual_above_median_min >= 3 * chance_sd_binomial }
    #" All penalized hospitals: most beyond three binomial SDs (suppressed rows at 10).
    beyond_three_sd_binomial_most is count() { where: actual_above_median_max >= 3 * chance_sd_binomial }
    #" All penalized hospitals: most beyond two binomial SDs (suppressed rows at 10).
    beyond_two_sd_binomial_most is count() { where: actual_above_median_max >= 2 * chance_sd_binomial }
    #" Actual readmissions above the peer-median count beyond two binomial SDs, summed over penalized hospitals, three years, lower bound. A threshold statistic: it moves a lot with the cut-off and is not an estimate of real gaps; do not value it.
    beyond_two_part_binomial_min is sum(greatest(actual_above_median_min - 2 * chance_sd_binomial, 0))
    #" Same, upper bound.
    beyond_two_part_binomial_max is sum(greatest(actual_above_median_max - 2 * chance_sd_binomial, 0))
    #" Actual readmissions above the peer-median count beyond two chance SDs, summed over penalized hospitals, three years, lower bound (suppressed rows at 0).
    beyond_two_sd_part_min is sum(greatest(actual_above_median_min - 2 * chance_sd, 0))
    #" Same, upper bound (suppressed rows at 10).
    beyond_two_sd_part_max is sum(greatest(actual_above_median_max - 2 * chance_sd, 0))
    #" Penalized hospitals with a posterior (a penalized heart attack, heart failure, pneumonia or COPD measure).
    hospitals_estimated is count() { where: posterior_var_penalized > 0 }
    #" Expected share of those hospitals truly above their peer median on those measures (mean posterior probability), lower bound. Inferred from F3's spread; hospitals penalized only on hip/knee or CABG are not estimated.
    # percent
    share_truly_above_median_min is prob_above_median_min.avg()
    #" Same, upper bound.
    # percent
    share_truly_above_median_max is prob_above_median_max.avg()
    #" Share of the measured gap above the peer median that the posterior attributes to a real difference, penalized heart attack, heart failure, pneumonia and COPD measures, suppressed counts at 0 (the rest is chance and selection). Inferred.
    # percent
    real_share_of_gap_at_floor is posterior_gap_min.sum() / nullif(actual_above_median_covered_min.sum(), 0)
    #" Same, suppressed counts at 10.
    # percent
    real_share_of_gap_at_ceiling is posterior_gap_max.sum() / nullif(actual_above_median_covered_max.sum(), 0)
    #" Penalized hospitals as a group: CMS's estimate of net readmissions above expected, three years.
    group_net_excess is net_excess_readmissions.sum()
    #" Penalized hospitals as a group: net above expected as a share of their expected readmissions (CMS's estimate).
    # percent
    group_net_excess_share is net_excess_readmissions.sum() / nullif(expected_readmissions.sum(), 0)
    #" Penalized hospitals above expected overall on CMS's estimate.
    penalized_above_expected is count() { where: net_excess_readmissions > 0 }

  #" Penalized hospitals by actual readmissions above the peer median, for hospitals with every penalized count published.
  view: by_actual_band is {
    where: penalized_rows_suppressed = 0
    group_by: actual_band is
      pick '1: under 1' when observed_above_median < 1
      pick '2: 1-1.99' when observed_above_median < 2
      pick '3: 2-4.99' when observed_above_median < 5
      pick '4: 5-19.99' when observed_above_median < 20
      else '5: 20+'
    aggregate: penalized_hospitals, avg_payment_reduction_pct
    order_by: actual_band
  }

  #" Penalized hospitals with every penalized count published, by binomial chance band, with their average cut.
  view: by_chance_band_binomial is {
    where: penalized_rows_suppressed = 0
    group_by: chance_band is
      pick '1: within 1 SD' when observed_above_median < chance_sd_binomial
      pick '2: 1-2 SD' when observed_above_median < 2 * chance_sd_binomial
      else '3: beyond 2 SD'
    aggregate: penalized_hospitals, avg_payment_reduction_pct
    order_by: chance_band
  }

  #" Penalized hospitals with every penalized count published, by how far their actual gap above the peer-median count sits from chance (Poisson SD), with their average cut.
  view: by_chance_band is {
    where: penalized_rows_suppressed = 0
    group_by: chance_band is
      pick '1: within 1 SD' when observed_above_median < chance_sd
      pick '2: 1-2 SD' when observed_above_median < 2 * chance_sd
      else '3: beyond 2 SD'
    aggregate: penalized_hospitals, avg_payment_reduction_pct
    order_by: chance_band
  }

  #" Penalized hospitals by CMS's estimate of readmissions above the peer median that produced the cut (shrunken scale).
  view: by_basis_band is {
    group_by: basis_band
    aggregate: penalized_hospitals, penalized_below_expected, avg_payment_reduction_pct
    order_by: basis_band
  }

  #" Penalized hospitals by state, with how many had fewer readmissions than expected overall.
  view: by_state is {
    group_by: state
    aggregate: penalized_hospitals, penalized_below_expected, avg_payment_reduction_pct
    order_by: penalized_hospitals desc
  }
}

#" Null simulation per program hospital: how often chance plus selecting above-median measures puts a hospital beyond two chance SDs, and the beyond-two gap that alone produces (200 replicates).
#(agent) Use with `penalty_basis` counts: the observed share of penalized hospitals beyond k binomial SDs (`beyond_one/two/three_sd_binomial_fewest`/`_most`) compares with `null_share_beyond_one/two/three` (chance plus selection alone), not with the textbook normal tail. The beyond-two gap totals are threshold statistics that move with the cut-off; they are not an estimate of real gaps and carry no dollar value (the null total sums over about 2,479 simulated-penalized hospitals, against 2,302 observed). Selection is simulated on the count (proxy for CMS's rule on the shrunken ratio). Means of 200 replicates differ by about 2% between implementations.
source: null_selection is motherduck.table('hospital_readmissions.null_selection') extend {
  primary_key: facility_id
  measure:
    #" Share of hospitals with any simulated penalized measure that land beyond one binomial SD under the null.
    # percent
    null_share_beyond_one is null_prob_beyond_one.sum() / nullif(null_prob_selected.sum(), 0)
    #" Share beyond three binomial SDs under the null.
    # percent
    null_share_beyond_three is null_prob_beyond_three.sum() / nullif(null_prob_selected.sum(), 0)
    #" Share of hospitals with any simulated penalized measure that land beyond two binomial SDs under the null.
    # percent
    null_share_beyond_two is null_prob_beyond_two.sum() / nullif(null_prob_selected.sum(), 0)
    #" Beyond-two gap produced by chance and selection alone, summed over program hospitals, three years (threshold statistic; not for valuation).
    null_beyond_two_part_total is null_beyond_two_part.sum()
    #" Hospitals simulated.
    hospitals_simulated is count()
}
