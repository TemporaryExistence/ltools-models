import "../tokens.malloy"

// Drawn by token_savers.jsx. Every version on one scale: estimated cost per chat at API prices.

#" Which Malloyyo changes save tokens in a dashboard chat, on one scale: cost per chat, today = 100.
# artifact { title="Token savers: Malloyyo dashboard chats" } dashboard { columns=6 }
query: token_savers_page is trial_chats -> {
  group_by: version
  aggregate: chats, write_cost_per_chat, reread_cost_per_chat, cost_per_chat, cost_min, cost_max, list_size, displayed
}
