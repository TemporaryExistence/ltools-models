##! experimental { givens }

// A transit board's budget question: the budget is fixed and probably shrinking. Where do the service hours go, what
// gets cut, while losing the fewest riders and keeping the people who depend on the service? Public data only:
//   budget_agency            one row per agency (2024): operating money by source (FTA TS1.2 2015-2024 via the Wayback
//                            Machine, and the 2022-24 NTD funding tables qpjk-b3zw / 8tvb-ywj3 / dd43-h6wv / 4tmr-gwuu),
//                            the federal money above the agency's own 2017-19 federal share (relief running out), and the
//                            cut menu: riders lost a year per $1M of bus or rail service cut (NTD Time Series 2.1, 2024).
//   service_change_*         matched event study of sharp service cuts and additions, NTD monthly 2002 - Aug 2026.
//   service_elasticity_panel agency-level 12-month changes, riders vs service hours, demeaned by year x size band.
//   gtfs_frequency           weekday bus hours on frequent (<=15 min midday) vs coverage routes, public GTFS feeds.
// Built by units/ltools/public-data/transit/analysis/budget/*.sql (DuckDB), loaded to MotherDuck ltools.transit.*
// (Parquet copies in public-data/transit/budget/).

given:
  # label="Your agency" suggest { source=budget_agency dimension=agency_name }
  BUDGET_AGENCY :: filter<string> is f'City of Raleigh'

#" One row per transit agency, 2024: operating money by source, federal relief still in its budget, and riders lost a year per $1M of service cut.
#(agent) relief_gap = 2024 federal operating money above the agency's own 2017-19 federal share of its operating budget,
#(agent) never below zero (no 2017-19 money: the median baseline of its size class and urbanized-area band,
#(agent) baseline_from_peers). Relief (CARES, CRRSAA, ARP) is no NTD column, so this is the stand-in; relief_gap_2019base
#(agent) is the same on a 2019-only share. flagged = relief_share 10%+; relief_robustness gives the 2018 false-flag rate.
#(agent) The flag finds agencies still running on relief in 2024 and misses those that spent it in 2021-23
#(agent) (spent_relief_early; view relief_spent_early). NTD funding data ends in 2024.
#(agent) Cut menu: riders lost per $1M = elasticity x riders per revenue hour x $1M / hours-driven cost per revenue hour
#(agent) (operating cost minus general administration, which is treated as fixed). Bus uses the event study's year-2
#(agent) elasticity (service_change_summary.headline). Rail uses the agency panel's year-1 rail-cut figure
#(agent) (service_elasticity_panel), because only 13 sharp rail cuts exist; it is a different basis from bus.
#(agent) ada_opex_est = demand-response cost x the ADA share of its trips; paratransit must cover the area and hours the
#(agent) fixed routes serve, so it can't be cut on its own. cut_needed / riders_lost_if_cut = service cut needed to close
#(agent) the 2024 gap with cuts alone (bus and rail in proportion to cost, lost fares made up by cutting more), at
#(agent) constant elasticity. One agency's figures: view agency_cut_menu.
source: budget_agency is motherduck.table('transit.budget_agency') extend {
  dimension:
    #" Agency name with its state.
    agency_label is concat(agency_name, ' (', state, ')')
    #" Short name used on the page: the news name if the system is in the validation list, else the agency label.
    short_label is coalesce(news_name, concat(agency_name, ' (', state, ')'))
    #" In 2024-26 budget-crisis news (a validation list written before the ranking, not used to build the measure).
    in_the_news is news_name is not null
    #" Share of bus hours removed by a cut that saves 10% of the bus budget at hours-driven cost.
    h10 is 0.1 * bus_opex / nullif(bus_avoidable_cost_per_hour, 0) / nullif(bus_trips_2024 / nullif(bus_riders_per_hour, 0), 0)
    #" The bus elasticity behind bus_riders_lost_per_1m, recovered from that column.
    bus_elasticity_used is bus_riders_lost_per_1m * bus_avoidable_cost_per_hour / 1000000 / nullif(bus_riders_per_hour, 0)
    #" The relief gap against a 2019-only federal share (2017-19 when there was no 2019 money), never below zero.
    # currency
    relief_gap_2019base is
      pick fed_2024 - coalesce(fed_share_2019, fed_share_base) * ops_2024
        when fed_2024 - coalesce(fed_share_2019, fed_share_base) * ops_2024 > 0
      else 0
    #" Ran 10+ points above its usual federal share in 2022 or 2023 but is not flagged in 2024: spent its relief early.
    spent_relief_early is not flagged and (fed_share_2022 - fed_share_base >= 0.10 or fed_share_2023 - fed_share_base >= 0.10)

  measure:
    agencies is count(ntd_id)
    agencies_flagged is count() { where: flagged }
    # currency
    operating_budget is ops_2024.sum()
    # currency
    relief_gap_total is relief_gap.sum()
    # percent
    relief_share_pooled is relief_gap.sum() / nullif(ops_2024.sum(), 0)
    # percent
    federal_share_pooled is fed_2024.sum() / nullif(ops_2024.sum(), 0)
    # percent
    fare_share_pooled is fares_2024.sum() / nullif(ops_2024.sum(), 0)
    # currency
    ada_paratransit_cost is ada_opex_est.sum()
    # percent
    ada_share_pooled is ada_opex_est.sum() / nullif(opex_all.sum(), 0)
    # currency
    cut_needed_total is cut_needed.sum()
    riders_lost_total is riders_lost_if_cut.sum()
    trips_total is trips_all.sum()
    # percent
    riders_lost_share is riders_lost_if_cut.sum() / nullif(trips_all.sum(), 0)
    #" Riders lost a year per $1M of local-bus service cut, pooled over agencies weighted by bus cost (one response assumed).
    #(agent) The largest agencies dominate; cut_menu_typical gives the median agency.
    bus_riders_lost_per_1m_pooled is sum(bus_riders_lost_per_1m * bus_opex) / nullif(bus_opex.sum() { where: bus_riders_lost_per_1m > 0 }, 0)
    #" Fares those riders paid, per $1M of local-bus service cut (pooled).
    # currency
    bus_fares_lost_per_1m_pooled is sum(bus_fares_lost_per_1m * bus_opex) / nullif(bus_opex.sum() { where: bus_riders_lost_per_1m > 0 }, 0)
    #" Riders lost a year per $1M of rail service cut, pooled (weighted by rail cost).
    rail_riders_lost_per_1m_pooled is sum(rail_riders_lost_per_1m * rail_opex) / nullif(rail_opex.sum() { where: rail_riders_lost_per_1m > 0 }, 0)
    bus_riders_per_hour_pooled is bus_trips_2024.sum() / nullif(bus_vrh_2024.sum(), 0)
    # currency
    bus_cost_per_hour_pooled is sum(bus_avoidable_cost_per_hour * bus_vrh_2024) / nullif(bus_vrh_2024.sum() { where: bus_avoidable_cost_per_hour > 0 }, 0)

  #" Systems in 2024-26 budget-crisis news, with their national rank on the relief gap: does the flag catch them?
  #(agent) For anyone deciding whether to trust the ranking (bond analysts, state budget offices). Also in 2024-26 budget news but not flagged (they spent relief by 2023, or the cause is local): MBTA (Boston),
  #(agent) TriMet (Portland), Denver RTD, DART (Dallas, a sales-tax dispute). Metrolink (Los Angeles) is flagged and has
  #(agent) cut service but is not on this list. Checked against news reports 2026-10-20.
  view: in_the_news_check is {
    where: in_the_news
    select: news_name, news, agency_label, ops_2024, fed_share_base, fed_share_2022, fed_share_2023, fed_share_2024,
      relief_share, relief_gap, rank_gap_all, flagged, fare_share_2019, fare_share_2024
    order_by: rank_gap_all
  }

  #" The biggest 2024 relief gaps among big multimodal systems, in dollars.
  view: biggest_gaps_big_systems is {
    where: size_class = 'Big multimodal (rail or $500M+)' and relief_gap > 0
    select: short_label, in_the_news, ops_2024, fed_share_base, fed_share_2024, relief_share, relief_gap, fare_share_2024,
      cut_needed, riders_lost_if_cut, rank_gap_all
    order_by: relief_gap desc
    limit: 25
  }

  #" Bus agencies ($10M+, 0.5M+ bus trips) with a 2024 relief gap of $3M+, by share of budget.
  #(agent) For municipal bond analysts and rating agencies, state DOTs and the agencies' own boards.
  view: exposed_bus_agencies is {
    where: size_class = 'Bus agency ($10M+, 0.5M+ bus trips)' and relief_gap >= 3000000
    select: agency_label, ops_2024, fed_share_base, fed_share_2022, fed_share_2023, fed_share_2024, relief_share, relief_gap,
      fare_share_2024, local_general_fund_share, ada_share_opex, cut_needed, riders_lost_if_cut, baseline_from_peers
    order_by: relief_share desc
    limit: 30
  }

  #" Bus agencies and big systems that spent their relief early (10+ points over their usual federal share in 2022 or 2023, not flagged in 2024).
  #(agent) What the 2024 flag misses: these agencies may already face deficits the 2024 data can't show.
  view: relief_spent_early is {
    where: size_class != 'Small / rural / specialty'
    aggregate: agencies, agencies_flagged, agencies_spent_early is count() { where: spent_relief_early }
    nest: largest is {
      where: spent_relief_early
      select: agency_label, ops_2024, fed_share_base, fed_share_2022, fed_share_2023, fed_share_2024
      order_by: ops_2024 desc
      limit: 15
    }
  }

  #" Bus agencies and big systems with $10M+ budgets, ranked by 2024 relief gap as a share of budget.
  #(agent) The $10M floor keeps small agencies, whose share swings on a few hundred thousand dollars, off the top.
  view: relief_share_ranking is {
    where: size_class != 'Small / rural / specialty' and ops_2024 >= 10000000
    select: agency_label, size_class, ops_2024, relief_share, relief_gap, flagged, in_the_news
    order_by: relief_share desc
  }

  #" By size class: 2024 relief gap, agencies flagged, and the riders lost if the flagged ones cut service to close it.
  view: gap_by_class is {
    group_by: size_class
    aggregate: agencies, agencies_flagged, operating_budget, relief_gap_total, relief_share_pooled, federal_share_pooled,
      fare_share_pooled
    nest: if_flagged_cut_service is {
      where: flagged
      aggregate: agencies, relief_gap_total, cut_needed_total, riders_lost_total, trips_total, riders_lost_share
    }
    order_by: relief_gap_total desc
  }

  #" Riders lost per $1M of bus cuts by kind of bus system, weighted by spending, if riders respond alike (unsettled).
  #(agent) Every agency with 0.5M+ bus trips, including small, rural and specialty systems (campus and resort
  #(agent) shuttles), which cut_menu_typical leaves out. Compares kinds of agency, not routes inside one agency. Assumes one response
  #(agent) to cuts at every kind of agency (the event study's year-2 bus elasticity, service_change_summary.headline).
  #(agent) The two methods disagree on that assumption: the agency panel by type (service_elasticity_panel.by_group,
  #(agent) breakdown bus_type) finds about the same first-year response everywhere (its year 2 widens the gap); the
  #(agent) event study by type
  #(agent) (service_change_events.by_bus_type) finds smaller responses at busier agencies, which would erase most of
  #(agent) the gap or reverse it by year 2. Quote the gap as conditional on which holds. The panel's year-2 cut
  #(agent) response is lower than the event study's, which would lower every figure. Quote cut_menu_typical for a
  #(agent) typical agency. Which hours inside one agency carry the fewest riders needs its passenger counts.
  #(agent) For transit boards sizing a cut.
  view: cut_menu_by_type is {
    where: bus_trips_2024 >= 500000 and bus_riders_lost_per_1m > 0
    group_by: bus_type
    aggregate: agencies, bus_riders_per_hour_pooled, bus_cost_per_hour_pooled, bus_riders_lost_per_1m_pooled,
      bus_fares_lost_per_1m_pooled, ada_share_pooled
    order_by: bus_type
  }

  #" By size class: where 2024 operating money comes from (fares, agency taxes, local and state general fund vs other, federal).
  #(agent) The general-fund splits apply each detail table's operating-plus-capital mix to operating money (estimated).
  view: funding_mix_by_class is {
    group_by: size_class
    aggregate:
      operating_budget
      fare_share_pooled
      # percent
      agency_taxes is sum(agency_tax_share * ops_2024) / nullif(ops_2024.sum(), 0)
      # percent
      local_general_fund is sum(local_general_fund_share * ops_2024) / nullif(ops_2024.sum(), 0)
      # percent
      local_other is sum(local_other_share * ops_2024) / nullif(ops_2024.sum(), 0)
      # percent
      state_general_fund is sum(state_general_fund_share * ops_2024) / nullif(ops_2024.sum(), 0)
      # percent
      state_other is sum(state_other_share * ops_2024) / nullif(ops_2024.sum(), 0)
      federal_share_pooled
    order_by: operating_budget desc
  }

  #" One agency (the agency control; default GoRaleigh): relief exposure, where its money comes from, what a bus cut costs it.
  #(agent) riders_lost_10pct_bus: a cut that saves 10% of the bus budget at hours-driven cost (overhead treated as fixed),
  #(agent) so it removes more than 10% of bus hours (hours_share_cut_10pct_budget); share lost = 1 - (1 - hours share)^e, with e
  #(agent) the elasticity behind bus_riders_lost_per_1m (bus_elasticity_used), held constant in logs. These are central
  #(agent) figures: scale by the year-2 cut responses in service_elasticity_panel (low) and estimate_checks (high) for the
  #(agent) study's range. Figures use the 2024 report year; for GoRaleigh, counted boardings more than doubled in July
  #(agent) 2024 (likely a counting change; see the transit source), and its service has grown since. fare_share_2024 is fares and other directly generated revenue.
  view: agency_cut_menu is {
    where: agency_name ~ $BUDGET_AGENCY
    select: agency_label, ops_2024, relief_gap, relief_share, flagged, fed_share_base, fed_share_2024,
      # percent
      relief_share_2019base is relief_gap_2019base / nullif(ops_2024, 0),
      local_general_fund_share, local_other_share, agency_tax_share, fare_share_2024, ada_share_opex,
      bus_opex, bus_trips_2024, bus_riders_per_hour, bus_avoidable_cost_per_hour, bus_riders_lost_per_1m,
      bus_riders_lost_per_1m_y1
      # percent
      hours_share_cut_10pct_budget is h10
      # percent
      share_of_bus_riders_lost_10pct is 1 - pow(1 - h10, bus_elasticity_used)
      riders_lost_10pct_bus is bus_trips_2024 * (1 - pow(1 - h10, bus_elasticity_used))
  }

  #" North Carolina agencies with $5M+ operating budgets: exposure, funding mix and cut menu.
  view: nc_agencies is {
    where: state = 'NC' and ops_2024 >= 5000000
    select: agency_label, ops_2024, fed_share_base, fed_share_2024, relief_share, relief_gap, fare_share_2024,
      local_general_fund_share, local_other_share, ada_share_opex, bus_type, bus_riders_per_hour, bus_riders_lost_per_1m,
      bus_fares_lost_per_1m
    order_by: ops_2024 desc
  }
}

#" Riders lost per $1M of bus cuts at the typical agency of each kind, if riders respond alike everywhere (unsettled).
#(agent) The gap between kinds is NOT a finding about where to cut: it assumes the same response to a cut at every
#(agent) kind of agency, and the study's two methods disagree (service_elasticity_panel.by_group finds about the same
#(agent) first-year response; service_change_events.by_bus_type finds smaller responses at busier agencies, which would
#(agent) erase most of the gap). Say so whenever you quote these figures.
#(agent) Unweighted over bus agencies and big systems (not small, rural or specialty systems, whose campus and resort
#(agent) shuttles would make the busy group look busier) with 0.5M+ bus trips, 2024; year-2 elasticity (_y1 at year 1). Use this, not cut_menu_by_type's cost-weighted pooled figure, for "a typical agency like mine". In the busiest group
#(agent) the typical cost per hour (cost_per_hour_median) is far below the pooled one, which the largest systems drive.
source: cut_menu_typical is motherduck.table('transit.cut_menu_typical') extend {
  #" What $1M of bus cuts costs at the typical agency of each kind, if riders respond alike (median and quartiles).
  view: typical is {
    select: bus_type, agencies, riders_lost_per_1m_median, riders_lost_per_1m_p25, riders_lost_per_1m_p75,
      riders_lost_per_1m_y1_median, riders_per_hour_median, cost_per_hour_median
    order_by: bus_type
  }
}

#" National operating money by year and size class, 2015-2024, with federal money above each agency's 2017-19 share.
#(agent) relief_gap: 2015-18 values are the normal-year noise floor. Agencies with no 2017-19 money count a zero baseline
#(agent) here, but the size-class median in budget_agency, so the 2024 totals differ slightly ($7.29B vs $7.22B).
source: relief_by_year is motherduck.table('transit.relief_by_year') extend {
  rename: relief_gap is excess_fed
  measure:
    # currency
    operating_money is ops.sum()
    # currency
    federal_money is fed.sum()
    # currency
    relief_gap_total is relief_gap.sum()
    # percent
    federal_share is fed.sum() / nullif(ops.sum(), 0)
    # percent
    fare_share_pooled is sum(fare_share * ops) / nullif(ops.sum(), 0)

  #" National operating money, federal money and federal money above each agency's 2017-19 share, by year.
  view: national_cliff is {
    group_by: report_year
    aggregate: operating_money, federal_money, relief_gap_total, federal_share, fare_share_pooled
    order_by: report_year
  }
}

#" How often the relief flag fires: in 2018 (no relief existed; against 2015-17) vs 2024, by size class, plus a 2019-only
#" baseline and 2023.
source: relief_robustness is motherduck.table('transit.relief_robustness') extend {
  #" How often the flag fires in 2018 (no relief) vs 2024, by size class, and on a 2019-only baseline.
  view: by_check is { select: check_name, size_class, agencies, flag_rate, excess order_by: check_name, size_class }
}

#" One row per sharp service cut or addition (bus and rail, 2004-2025), measured against matched peers.
#(agent) Sharp = hours 15%+ below / above the same month a year earlier for 3 months running. Peers = the 10 best-matched
#(agent) same-size agencies whose hours held steady. *_vs_peers = change in mean log riders / hours over the year after
#(agent) (y1: months 0-11, y2: months 12-23) vs the year before, minus the peers'. dropped = counting break (riders moved
#(agent) 0.5+ log away from hours), poor pre-match (pre_gap beyond 0.15), or a GoRaleigh (40007) event whose after-window
#(agent) spans its July 2024 boardings jump. The pooled results are in service_change_summary.headline.
source: service_change_events is motherduck.table('transit.service_change_events') extend {
  dimension:
    agency_label is concat(agency_name, ' (', state, ')')
  measure:
    events is count()
    #" Riders lost (or gained) per 1% of service hours, pooled: sum of rider gaps / sum of hour gaps.
    elasticity_pooled_y1 is riders_vs_peers_y1.sum() / nullif(hours_vs_peers_y1.sum(), 0)
    elasticity_pooled_y2 is riders_vs_peers_y2.sum() / nullif(hours_vs_peers_y2.sum() { where: riders_vs_peers_y2 is not null }, 0)

  #" Response by kind of bus system (2019 riders per hour band), sharp bus changes outside COVID; small cells, noisy.
  view: by_bus_type is {
    where: not dropped and mode_family = 'bus' and period != '2 COVID (Mar 2020-Jun 2021)'
    group_by: direction, bus_type
    aggregate: events, elasticity_pooled_y1, elasticity_pooled_y2
    order_by: direction, bus_type
  }

  #" Every sharp cut since July 2021, newest first.
  view: recent_cuts is {
    where: direction = 'cut' and period = '3 After COVID (Jul 2021-2026)'
    select: agency_label, mode_family, event_month, hours_vs_peers_y1, riders_vs_peers_y1, elasticity_y1, dropped
    order_by: event_month desc
  }
}

#" Pooled event-study results: riders lost or gained per 1% of service hours cut or added, by period, with bands.
#(agent) Bands (95%, 500 bootstrap draws over events) are on the all-periods-except-COVID rows. Every check on the bus-cut
#(agent) estimate (cut size, peers, period, fake dates, fake agencies, an earlier starting point, the pre-cut drift) is in
#(agent) estimate_checks.all_checks. Additions respond less than cuts in year 1; by year 2 the gap narrows, and published
#(agent) research does not settle which way it runs (one study of 99 Canadian agencies finds the reverse).
source: service_change_summary is motherduck.table('transit.service_change_summary') extend {
  #" The study's headline: bus and rail cuts and additions outside COVID, year 1 and year 2, with bands.
  view: headline is {
    where: period = 'All periods except COVID'
    select: mode_family, direction, events, elasticity_y1, e_y1_lo, e_y1_hi, elasticity_y2, e_y2_lo, e_y2_hi, pre_gap
    order_by: mode_family, direction
  }
}

#" Month-by-month riders and hours against matched peers around sharp local-bus cuts and additions (outside COVID).
#(agent) Log riders and log hours vs peers, each indexed to its own 12 months before; t = months from the change.
source: service_change_path is motherduck.table('transit.service_change_path') extend {
  measure:
    # percent
    riders_change is avg(exp(riders_vs_peers) - 1)
    # percent
    hours_change is avg(exp(hours_vs_peers) - 1)
  #" Riders and hours against peers, month by month from 12 months before a sharp change to 23 after.
  view: path is {
    group_by: dir, t
    aggregate: riders_change, hours_change, events is events.max()
    order_by: dir, t
  }
}

#" Agency-level 12-month changes (windows ending in August, 2003-2026): elasticity of riders to service hours by mode
#" family x period, bus type, size band, and cuts vs adds, with 95% agency-cluster bootstrap bands.
source: service_elasticity_panel is motherduck.table('transit.service_elasticity_panel') extend {
  #" Panel elasticities by mode and period, kind of bus system, size band, and cuts vs additions.
  view: by_group is {
    select: breakdown, mode_family, group_name, obs, agencies, elasticity_1yr, e1_lo, e1_hi, elasticity_2yr, e2_lo, e2_hi
    order_by: breakdown, mode_family, group_name
  }
}

#" Weekday bus hours by how often each route runs at midday, from public schedules, for 43 agencies (7 in North Carolina).
#(agent) GTFS via the Mobility Database catalog (schedules mostly Oct 2026, some 2025); midday = 10:00-15:00, busier
#(agent) direction. share_freq15 = share of weekday bus hours on routes every 15 minutes or better. hours_check_flag =
#(agent) scheduled hours far from NTD's 2024 report-year hours (partial feed or mismatched reporting: TARC, GoTriangle);
#(agent) for agencies whose service grew after 2024 it compares different years. Schedules show where the
#(agent) hours are, not where the riders are: route-level ridership is not public.
source: gtfs_frequency is motherduck.table('transit.gtfs_frequency') extend {
  join_one: budget_agency on ntd_id = budget_agency.ntd_id
  measure:
    agencies is count()
    # percent
    frequent_share_pooled is sum(share_freq15 * weekday_bus_hours) / nullif(weekday_bus_hours.sum(), 0)
    riders_per_hour_pooled is trips_2024.sum() / nullif(vrh_2024.sum(), 0)
  dimension:
    frequent_band is pick '3 40%+ frequent' when share_freq15 >= 0.4 pick '2 20-40%' when share_freq15 >= 0.2 else '1 Under 20%'

  #" Agencies grouped by how much of their bus service is frequent, with riders per hour (2024).
  view: riders_by_frequent_band is {
    where: not hours_check_flag
    group_by: frequent_band
    aggregate: agencies, frequent_share_pooled, riders_per_hour_pooled
    order_by: frequent_band
  }

  #" One agency (the agency control; default GoRaleigh): its weekday bus hours by midday frequency and what the infrequent hours cost.
  #(agent) infrequent_hours_cost = share of hours on routes every 31+ minutes (current schedule) x 2024 report-year bus
  #(agent) revenue hours (an agency whose service has grown since, such as GoRaleigh, runs more) x hours-driven
  #(agent) cost per hour. It sizes those hours in dollars; it does not say they carry the fewest riders (no route ridership).
  view: agency_hours_by_frequency is {
    where: budget_agency.agency_name ~ $BUDGET_AGENCY
    select: agency_label, service_date, share_freq15, share_16_to_30, share_31_to_60, share_over60_or_peak_only, hours_check_flag
      # currency
      infrequent_hours_cost is (share_31_to_60 + share_over60_or_peak_only) * budget_agency.bus_vrh_2024 * budget_agency.bus_avoidable_cost_per_hour
  }
}

#" One row per bus route in the GTFS sample: midday headway (minutes), weekday scheduled hours and trips, class.
source: gtfs_routes is motherduck.table('transit.gtfs_routes') extend {
  measure:
    routes is count()
    weekday_hours_total is weekday_hours.sum()
}

#" Every check on the bus-cut estimate: cut-size rule, peers, period, fake dates, fake agencies, earlier base, pre-cut drift.
#(agent) Built by analysis/budget/validation/09_checks_table.sql. elasticity_y1 rows: the estimate under that check.
#(agent) riders_gap_y1 rows (fake dates, fake agencies): the year-1 log riders gap where no cut happened; near zero
#(agent) passes, against the real cuts' gap (the "real events (reference)" row). Bands differ by kind: fake dates give a
#(agent) band for the mean; the two single-unit fake-agency rows give the spread of single units, and the "sets of 126"
#(agent) row the band for a set the size of the real one. Bands come from their own bootstrap, so their ends differ from
#(agent) service_change_summary's by about 0.01; service_change_summary is the reference.
source: estimate_checks is motherduck.table('transit.estimate_checks') extend {
  #" All checks with their estimate or riders gap and 95% bands.
  view: all_checks is {
    select: check_kind, check_name, events, elasticity_y1, e1_lo, e1_hi, elasticity_y2, events_y2, riders_gap_y1, rg_lo, rg_hi
    order_by: check_kind, check_name
  }
}
