##! experimental.givens
import "../transit.malloy"

// Drawn by triangle.jsx. Every query below is presentation only: the model's own measures and views, filtered.

#" How the Triangle (Raleigh and Durham urbanized areas) uses public transit against Sun Belt metros of similar size
#" and the rest of North Carolina: recovery since 2019, service restored, trips per resident. GoRaleigh's counts step
#" up in July 2024 with little change in service, so the Triangle's honest recovery leaves GoRaleigh out (86%, not
#" 98%). Latest 12 months = September 2025 to August 2026.
# artifact { title="Triangle vs peer metros: transit recovery" } dashboard { columns=6 }
query: triangle is transit -> triangle_vs_peer_metros

#" Chart: monthly trips for each Triangle agency since January 2018.
query: triangle_monthly is transit -> {
  where: peer_metro = 'Triangle (Raleigh + Durham)' and report_month >= @2018-01-01
  group_by: agency_name, report_month
  aggregate: trips_total
  having: trips_total > 0
  order_by: report_month
}

#" Chart: North Carolina agencies still below 2019 (100,000+ trips in 2019), largest number of lost trips first.
query: triangle_nc_below is transit -> nc_agencies_below_2019

#" Table: every Triangle agency, then and now.
query: triangle_agencies_table is transit -> triangle_agencies

#" Contrast: North Carolina as the Triangle, Charlotte and the rest.
query: triangle_nc_regions is transit -> nc_regions

// ---- "About this data" panel (added 2026-10-07): rows and months in the table the dashboard reads, filters ignored. ----

#" About this data: rows and months in the table the dashboard reads (whole table, filters ignored).
query: triangle_about is transit -> {
  aggregate:
    table_rows is count()
    first_month is report_month.min()
    last_month is report_month.max()
    agency_ids is count(ntd_id)
}
