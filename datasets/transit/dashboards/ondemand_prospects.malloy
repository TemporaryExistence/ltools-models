##! experimental.givens
import "../transit.malloy"
import "../ondemand.malloy"

#" Microtransit prospects for on-demand transit vendors (software, turnkey operators): urban agencies ranked by the
#" NEW general-public on-demand service they added from 2022 to 2024, with ADA paratransit and sponsored trips taken out
#" and each agency's general-public growth capped at its total on-demand growth, so trips re-flagged from ADA to
#" general public do not count as growth (FTA National Transit Database annual data). Hours and spend for general-public service are estimates (each
#" row's hours and operating expense split by its share of trips that are neither ADA nor sponsored). Spend is agency
#" operating expense, not software revenue. "All on-demand hours since 2024 (incl. paratransit)" compares the latest
#" 12 monthly reports (September 2025 to August 2026) with calendar 2024; the monthly file does not split out ADA.
# artifact { title="Agencies spend an estimated $950M a year on general-public on-demand transit, up $246M of new service in two years" givens { STATE="" } } dashboard { columns=6 }
query: ondemand_prospects is ondemand_annual -> {
  where:
    is_urban and reports_ada_trips,
    state ~ $STATE
  # colspan=6
  nest:
    # label="Agencies ranked by new general-public on-demand hours added, 2022 to 2024"
    ranked is {
      group_by:
        # label="Agency"
        agency is agency_label
      aggregate:
        # label="General-public hours, 2022" number="0.0a"
        hours_2022 is general_public_hours_2022
        # label="General-public hours, 2024" number="0.0a"
        hours_2024 is general_public_hours_2024
        # label="New hours added (capped at all on-demand hours added)" number="0.0a"
        hours_added is new_service_hours_added
        # label="All on-demand hours added" number="0.0a"
        total_added is ondemand_hours_added
        # label="Re-flagged from ADA, not new" number="0.0a"
        reflagged is reflagged_hours
        # label="Spend added a year (new service)" currency
        spend_added is new_service_spend_added
        # label="Spend, 2024" currency
        spend_2024 is general_public_spend_2024
        # label="ADA share of on-demand trips" percent
        ada_share is ada_trip_share_2024
        # label="All on-demand hours since 2024 (incl. paratransit)" percent
        momentum is momentum_since_2024
        both_years is reported_both_years
      having: reported_both_years
      order_by: hours_added desc
      limit: 20
    }
}

#" The money: same agencies in 2022 and 2024 (reported on-demand trips with an ADA breakdown both years). Growth is
#" new service only (new_service_hours_added; the re-flagged excess counts as already running in 2022), matching the
#" microtransit_market_size view.
query: ondemand_money is ondemand_annual -> {
  where:
    is_urban and reports_ada_trips,
    state ~ $STATE
  group_by: ntd_id
  aggregate:
    reported_both_years
    general_public_hours_2024, new_service_hours_added, reflagged_hours
    general_public_spend_2024, new_service_spend_added
  having: reported_both_years
  calculate: added_rank is row_number() { order_by: new_service_hours_added desc }
} -> {
  aggregate:
    agencies is count()
    agencies_growing is count() { where: new_service_hours_added > 0 }
    agencies_cutting is count() { where: new_service_hours_added < 0 }
    agencies_reflagged is count() { where: reflagged_hours > 0 }
    hours_2022 is sum(general_public_hours_2024 - new_service_hours_added)
    hours_2024 is general_public_hours_2024.sum()
    hours_added is new_service_hours_added.sum()
    hours_reflagged is reflagged_hours.sum()
    spend_2022 is sum(general_public_spend_2024 - new_service_spend_added)
    spend_2024 is general_public_spend_2024.sum()
    spend_added is new_service_spend_added.sum()
    top15_spend_added is new_service_spend_added.sum() { where: added_rank <= 15 }
}

#" Chart: on-demand hours by year at urban agencies, ADA paratransit and sponsored vs general public (estimated).
query: ondemand_mix_by_year is ondemand_annual -> {
  where:
    is_urban and reports_ada_trips,
    state ~ $STATE
  group_by: report_year
  aggregate:
    general_public is general_public_hours
    paratransit_and_sponsored is ondemand_hours - general_public_hours
  order_by: report_year
}

#" Chart: one point per urban agency with 20,000+ on-demand hours in 2024: its ADA share of on-demand trips against
#" the NEW general-public hours it added since 2022 (capped at its total on-demand growth). Microtransit buyers sit at the top left; paratransit agencies at the
#" right edge.
query: ondemand_agency_points is ondemand_annual -> {
  where:
    is_urban and reports_ada_trips,
    state ~ $STATE
  // Grouped by agency name, not NTD ID: one agency can file under two IDs (Pace: paratransit and dial-a-ride).
  group_by: agency is agency_label
  aggregate:
    ondemand_hours_2024
    ada_share is ada_trip_share_2024
    hours_added is new_service_hours_added
    reported_both_years
  having: reported_both_years and ondemand_hours_2024 >= 20000
  calculate: added_rank is row_number() { order_by: new_service_hours_added desc }
}

#" The largest on-demand operators of 2024 and their ADA share: the agencies a naive "on-demand growth" list puts on
#" top, most of which run mandated paratransit.
query: ondemand_largest is ondemand_annual -> {
  where:
    is_urban and reports_ada_trips and report_year = 2024,
    state ~ $STATE
  group_by: agency is agency_label
  aggregate:
    ondemand_hours is ondemand_hours_2024
    ada_share is ada_trip_share_2024
    general_public is general_public_hours_2024
  order_by: ondemand_hours desc
  limit: 10
}
