##! experimental.givens
import "../transit.malloy"

#" How a state's public transit is used and how far it has come back since 2019, by agency, mode and month.
# artifact { title="Transit Ridership by State" } dashboard { columns=6 }
query: ridership is transit -> {
  where:
    state ~ $STATE,
    agency_name ~ $AGENCY,
    mode_group ~ $MODE_GROUP
  # colspan=1
  aggregate: trips_latest_12m, yoy_change, recovery_vs_2019, trips_per_hour_12m, agencies
  # colspan=3
  nest:
    monthly_trips
    top_agencies
    by_mode
    beyond_2019
}
