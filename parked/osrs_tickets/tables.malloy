// Raw tables, one source each. The Parquet files are exported from the SQLspace
// practice database (project-dashboard/pipeline/osrs-sql/build-osrs-db.js).
// FULLY SYNTHETIC: servers S2–S5 only (the real de-identified server S1 was removed 2026-10-06).
// price_usd / cut_usd = gold in millions × $0.765 (Old School Bond: $8.99 retail / ~11.75M GP, 2026-10-06).

source: servers_table   is motherduck.table('osrs.servers')
source: cut_rates_table is motherduck.table('osrs.cut_rates')
source: helpers_table   is motherduck.table('osrs.helpers')
source: clients_table   is motherduck.table('osrs.clients')
source: payments_table  is motherduck.table('osrs.payments')
